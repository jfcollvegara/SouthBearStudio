---
import Base from '../layouts/Base.astro';
import {departments} from '../data/site.js';
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const route=(path)=>root+path+'/';
---
<Base title="Inicio"><section class="container hero"><div class="eyebrow">Estudio creativo · Diseño & tecnología</div><h1>Tu negocio merece <span class="accent">algo diferente.</span></h1><p class="lead">Diseñamos marcas, webs y experiencias digitales que hacen destacar las buenas ideas. Estética cuidada y soluciones pensadas para personas.</p><div class="actions"><a class="button" href={route('/servicios')}>Explorar servicios ↗</a><a class="button secondary" href={route('/contacto')}>Hablemos de tu proyecto</a></div></section><section class="section shade"><div class="container"><div class="section-heading"><div><div class="eyebrow">Lo que hacemos</div><h2>Soluciones que conectan.</h2></div><p>De una identidad visual a una tienda online: construimos lo que tu negocio necesita.</p></div><div class="cards">{departments.map((d,i)=><article class="card"><span class="eyebrow">/ 0{i+1}</span><h3>{d.title}</h3><p>{d.description}</p><a href={route('/servicios')+'#'+d.slug}>Descubrir ↗</a></article>)}</div></div></section><section class="section container"><div class="eyebrow">Cómo trabajamos</div><h2>Ideas claras. Resultados cuidados.</h2><div class="steps"><div><b>01 / Escuchamos</b><h3>Entendemos tu negocio.</h3><p>Conocemos tus objetivos antes de proponerte una solución.</p></div><div><b>02 / Diseñamos</b><h3>Damos forma a la idea.</h3><p>Unimos identidad, claridad y funcionalidad.</p></div><div><b>03 / Lanzamos</b><h3>Lo hacemos realidad.</h3><p>Comprobamos cada detalle y preparamos el proyecto para evolucionar.</p></div></div></section><section class="container section"><div class="cta"><p class="eyebrow">¿Tienes una idea?</p><h2>Vamos a darle forma.</h2><a class="button" href={route('/contacto')}>Empezar un proyecto ↗</a></div></section></Base>