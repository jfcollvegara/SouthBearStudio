---
/* Tipografías libres OFL, incluidas en el proyecto y servidas por Cloudflare. */
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/inter/wght-italic.css';
import '../styles/global.css';
import '../styles/kolibri-shell.css';
import {site} from '../data/site.js';
const {
  title='Estudio creativo',
  description='SOUTHBEAR STUDIO, diseño web, identidad visual y soluciones digitales.',
  landing=false
}=Astro.props;
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const route=(path='/')=>root+(path==='/'?'/':path+'/');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://southbearstudio.com').toString();
const fullTitle = title === site.name ? site.name : title + ' | ' + site.name;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://southbearstudio.com/#organization',
  name: 'SOUTHBEAR STUDIO',
  url: 'https://southbearstudio.com/',
  logo: 'https://southbearstudio.com/southbear-logo.svg',
  description: 'Estudio creativo independiente especializado en diseño web, branding, diseño gráfico y producción audiovisual.',
  areaServed: ['Murcia', 'Alicante', 'Almería'].map(name => ({'@type':'AdministrativeArea', name}))
};
const nav=[
  ['/','Inicio'],
  ['/servicios','Servicios'],
  ['/proyectos','Proyectos'],
  ['/nosotros','Estudio'],
  ['/contacto','Contacto'],
  ['/presupuesto','Presupuesto']
];
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrentCategory = (url) => {
  const destination = route(url).replace(/\/+$/, '') || '/';
  return currentPath === destination || (url === '/servicios' && currentPath.startsWith(destination + '/'));
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#F8F8F5"/>
    <meta name="application-name" content="SouthBear Studio"/>
    <meta name="apple-mobile-web-app-title" content="SouthBear"/>
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    <link rel="icon" href="/favicon.ico?v=4" sizes="any"/>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=4"/>
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=4"/>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v4.png"/>
    <link rel="manifest" href="/manifest.webmanifest?v=4"/>
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl}/>
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml"/>
    <meta property="og:locale" content="es_ES"/>
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content={site.name}/>
    <meta property="og:title" content={fullTitle}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonicalUrl}/>
    <meta name="twitter:card" content="summary"/>
    <meta name="twitter:title" content={fullTitle}/>
    <meta name="twitter:description" content={description}/>
    {landing && <script type="application/ld+json" set:html={JSON.stringify(organization)} />}
  </head>
  <body class:list={[{'landing-page':landing}]}>
    {!landing && (
      <header class="site-header southbear-nav">
        <div class="container nav sb-interior-nav">
          <a class="sb-nav-brand" href={route('/')} aria-label="SOUTHBEAR STUDIO — inicio">
            <img src={root + '/southbear-logo.svg'} alt="SOUTHBEAR STUDIO" width="218" height="40"/>
          </a>
          <nav class="sb-nav-desktop" aria-label="Navegación principal">
            {nav.map(([url,label])=><a href={route(url)} aria-current={isCurrentCategory(url) ? 'page' : undefined}>{label}</a>)}
          </nav>
          <details class="site-menu sb-nav-mobile">
            <summary class="menu-toggle" aria-label="Abrir menú de navegación">
              <span class="menu-toggle-lines" aria-hidden="true"><span></span><span></span></span>
            </summary>
            <nav class="menu-panel" aria-label="Menú de categorías">
              {nav.map(([url,label])=><a href={route(url)} aria-current={isCurrentCategory(url) ? 'page' : undefined}>{label}</a>)}
            </nav>
          </details>
        </div>
      </header>
    )}
    <main><slot/></main>
    <footer class="sb-site-footer" aria-label="Pie de página">
      <div class="container sb-footer-main">
        <div class="sb-footer-brand">
          <a href={route('/')} aria-label="SOUTHBEAR STUDIO — ir al inicio">
            <img src={root + "/southbear-logo.svg"} alt="SOUTHBEAR STUDIO" width="340" height="64" loading="lazy"/>
          </a>
          <p>Diseño web, identidad visual y soluciones digitales.</p>
        </div>
        <nav class="sb-footer-nav" aria-label="Navegación del pie de página">
          <h3>Explora</h3>
          <a href={route('/servicios')}>Servicios</a>
          <a href={route('/proyectos')}>Proyectos</a>
          <a href={route('/nosotros')}>El estudio</a>
          <a href={route('/contacto')}>Contacto</a>
        </nav>
        <div class="sb-footer-location">
          <h3>Estamos cerca</h3>
          <p>Beniel, Murcia.</p>
          <p>Murcia · Alicante · Almería</p>
          <p>Trabajamos online con toda España.</p>
        </div>
      </div>
      <div class="container sb-footer-tools" aria-label="Herramientas con las que trabajamos">
        <span class="sb-footer-tools-label">HERRAMIENTAS CON LAS QUE TRABAJAMOS</span>
        <ul class="sb-footer-tools-list" aria-label="Supabase, Cloudflare, GitHub, DaVinci Resolve, Affinity y Hostalia">
          <li class="sb-footer-tool"><span class="sb-footer-tool-logo sb-footer-tool-logo--supabase" role="img" aria-label="Supabase"></span></li>
          <li class="sb-footer-tool"><span class="sb-footer-tool-logo sb-footer-tool-logo--cloudflare" role="img" aria-label="Cloudflare"></span></li>
          <li class="sb-footer-tool"><span class="sb-footer-tool-logo sb-footer-tool-logo--github" role="img" aria-label="GitHub"></span></li>
          <li class="sb-footer-tool"><span class="sb-footer-tool-logo sb-footer-tool-logo--davinci" role="img" aria-label="DaVinci Resolve"></span></li>
          <li class="sb-footer-tool"><span class="sb-footer-tool-logo sb-footer-tool-logo--affinity" role="img" aria-label="Affinity"></span></li>
          <li class="sb-footer-tool"><span class="sb-footer-tool-logo sb-footer-tool-logo--hostalia" role="img" aria-label="Hostalia"></span></li>
        </ul>
      </div>
      <div class="container sb-footer-bottom">
        <span>© {new Date().getFullYear()} SOUTHBEAR STUDIO. Todos los derechos reservados.</span>
        <a href={route('/')} aria-label="Volver al inicio">Ideas que dejan huella. <span aria-hidden="true">↗</span></a>
      </div>
    </footer>
    {!landing && (
      <script>
        const header = document.querySelector('.site-header.southbear-nav');
        if (header) {
          const bar = header.querySelector('.sb-interior-nav');
          const links = header.querySelector('.sb-nav-desktop');
          const menu = header.querySelector('.sb-nav-mobile');
          const toggle = menu.querySelector('summary');
          const narrow = window.matchMedia('(max-width: 980px)');
          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
          let scheduled = false;

          function updateNav() {
            scheduled = false;
            const compact = narrow.matches;
            const progress = compact ? 1 : (reduced.matches
              ? Number(window.scrollY > 12)
              : Math.min(1, Math.max(0, window.scrollY / 125)));

            // La hilera se desplaza hasta la hamburguesa mientras se comprime.
            // offsetLeft no depende del transform: no acumula errores al desplazarse.
            const from = links.offsetLeft + links.offsetWidth / 2;
            const to = menu.offsetLeft + menu.offsetWidth / 2;
            const travel = Math.max(0, to - from);
            bar.style.setProperty('--sb-nav-offset', Math.round(travel * progress) + 'px');
            bar.style.setProperty('--sb-nav-scale', String(1 - .84 * progress));
            bar.style.setProperty('--sb-nav-label-opacity', String(Math.max(0, 1 - 1.25 * progress)));
            bar.style.setProperty('--sb-nav-blur', (6 * progress).toFixed(2) + 'px');
            bar.style.setProperty('--sb-nav-icon-opacity', String(Math.min(1, Math.max(0, (progress - .48) / .52))));
            bar.style.setProperty('--sb-nav-icon-scale', String(.72 + .28 * progress));

            links.inert = compact || progress >= 0.9;
            menu.inert = !compact && progress < 0.9;
            if (!compact && progress < 0.9 && menu.open) menu.open = false;
          }

          function requestNavUpdate() {
            if (scheduled) return;
            scheduled = true;
            requestAnimationFrame(updateNav);
          }

          window.addEventListener('scroll', requestNavUpdate, {passive: true});
          window.addEventListener('resize', requestNavUpdate, {passive: true});
          narrow.addEventListener('change', requestNavUpdate);
          reduced.addEventListener('change', requestNavUpdate);
          menu.addEventListener('toggle', () => {
            // Se expande la propia barra, nunca se abre una tarjeta flotante.
            bar.classList.toggle('sb-menu-open', menu.open);
            toggle.setAttribute('aria-label',
              menu.open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
          });
          document.addEventListener('click', (event) => {
            if (menu.open && !menu.contains(event.target)) menu.open = false;
          });
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && menu.open) {
              menu.open = false;
              toggle.focus();
            }
          });
          updateNav();
        }
      </script>
    )}
  </body>
</html>