---
import Base from '../../layouts/Base.astro';
import {catalog} from '../../data/catalog.js';
const branding=catalog.find(service=>service.slug==='branding');
---
<Base title="Logotipos e identidad visual" description="Logotipos e identidad visual en SouthBear Studio.">
  <section class="sb-paper-hero" aria-labelledby="sb-paper-title">
    <svg class="sb-paper-hero__grain" aria-hidden="true" focusable="false" preserveAspectRatio="none">
      <filter id="sb-paper-grain-filter" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency=".7" numOctaves="3" seed="7" stitchTiles="stitch"/>
        <feColorMatrix type="saturate" values="0"/>
      </filter>
      <rect width="100%" height="100%" filter="url(#sb-paper-grain-filter)" opacity=".25"/>
    </svg>
    <h1 id="sb-paper-title" class="sb-paper-hero__title">
      <span class="sb-paper-hero__line" data-text="Logotipos">Logotipos</span>
      <span class="sb-paper-hero__line" data-text="e identidad visual">e identidad visual</span>
    </h1>
  </section>
  <section class="sb-paper-packages" aria-label="Paquetes de logotipos e identidad visual">
    <div class="sb-paper-packages__inner">
      <div class="sb-paper-packages__rail" aria-hidden="true"></div>
      <div class="sb-paper-packages__grid">
        {branding.packages.map((pkg,index)=>(
          <article class:list={['sb-paper-package',index%2===0?'sb-paper-package--left':'sb-paper-package--right']} data-paper-reveal>
            <span class="sb-paper-package__ordinal">{String(index+1).padStart(2,'0')}</span>
            <h2>{pkg.name}</h2>
            <p class="sb-paper-package__price">{pkg.price.toLocaleString('es-ES')} €</p>
            <ul>{pkg.features.map(feature=><li>{feature}</li>)}</ul>
            <a href={'/presupuesto/?servicio=branding&paquete='+encodeURIComponent(pkg.name)}>Solicitar presupuesto <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .sb-paper-hero{
    --paper:#f2f0e9;
    position:relative;isolation:isolate;display:flex;align-items:center;justify-content:center;
    min-height:100vh;min-height:100svh;width:100%;overflow:hidden;
    background:radial-gradient(ellipse at 48% 34%,#f8f6f0 0%,var(--paper) 57%,#eeebe3 100%);
    color:#222;
  }
  .sb-paper-hero__grain{
    position:absolute;inset:0;width:100%;height:100%;
    pointer-events:none;mix-blend-mode:multiply;opacity:.095;
  }
  .sb-paper-hero__title{
    position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;
    margin:0;padding:0 20px;text-align:center;
    font-family:'Space Grotesk Variable',Arial,sans-serif;
    font-size:clamp(38px,6.9vw,110px);font-weight:680;line-height:1.04;letter-spacing:-.075em;
  }
  .sb-paper-hero__line{
    display:block;position:relative;white-space:nowrap;color:transparent;
  }
  .sb-paper-hero__line::after{
    content:attr(data-text);position:absolute;inset:0;white-space:nowrap;
    color:#ece8df;opacity:0;filter:blur(8px);
    text-shadow:
      1px 1px 0 rgba(255,255,255,.92),
      2px 2px 3px rgba(255,255,255,.62),
      -1px -1px 0 rgba(163,157,145,.62),
      -2px -2px 3px rgba(145,139,127,.42),
      -4px -4px 8px rgba(120,114,103,.18);
    animation:sb-paper-deboss 2.8s ease-out forwards;
  }
  @keyframes sb-paper-deboss{
    0%{opacity:0;filter:blur(10px);transform:translateY(0)}
    55%{opacity:.55;filter:blur(2px);transform:translateY(.5px)}
    100%{opacity:1;filter:blur(0);transform:translateY(1px)}
  }
  @media(max-width:700px){
    .sb-paper-hero__title{font-size:clamp(28px,7vw,53px);padding-inline:12px;letter-spacing:-.075em}
    .sb-paper-hero__line::after{
      text-shadow:1px 1px 0 rgba(255,255,255,.94),2px 2px 2px rgba(255,255,255,.56),-1px -1px 0 rgba(163,157,145,.62),-2px -2px 2px rgba(145,139,127,.38);
    }
  }
  @media(prefers-reduced-motion:reduce){
    .sb-paper-hero__line{color:transparent}
    .sb-paper-hero__line::after{animation:none;opacity:1;filter:none;transform:translateY(1px)}
  }
  .sb-paper-packages{position:relative;isolation:isolate;background:#f2f0e9;padding:0 24px 150px;overflow:hidden;color:#34322d}
  .sb-paper-packages__inner{position:relative;max-width:1240px;margin:auto;min-height:1150px;padding-top:100px}
  .sb-paper-packages__rail{position:absolute;z-index:0;top:0;bottom:0;left:50%;width:7px;transform:translateX(-50%) scaleY(0);transform-origin:top center;background:#ebe7dd;box-shadow:inset 2px 0 2px rgba(135,127,112,.37),inset -2px 0 2px rgba(255,255,255,.92),-1px 0 2px rgba(161,152,133,.23),1px 0 2px #fff;transition:transform 2.6s cubic-bezier(.22,1,.36,1)}
  .sb-paper-packages.is-visible .sb-paper-packages__rail{transform:translateX(-50%) scaleY(1)}
  .sb-paper-packages__grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:clamp(64px,10vw,150px);row-gap:46px}
  .sb-paper-package{position:relative;min-width:0;padding:34px clamp(20px,3.2vw,44px);background:#f1eee6;border:1px solid rgba(188,180,164,.2);border-radius:0;box-shadow:inset 4px 4px 8px rgba(146,136,119,.22),inset -4px -4px 8px rgba(255,255,255,.98),inset 1px 1px 2px rgba(104,96,80,.22),1px 1px 1px rgba(255,255,255,.55);opacity:0;filter:blur(6px);transform:translateY(30px);transition:opacity 1s ease,filter 1s ease,transform 1s ease}
  .sb-paper-package.is-visible{opacity:1;filter:none;transform:translateY(0)}
  .sb-paper-package--left{grid-column:1}
  .sb-paper-package--right{grid-column:2}
  .sb-paper-package__ordinal{font-size:12px;letter-spacing:.16em;color:#8c877e}
  .sb-paper-package h2{font-family:'Space Grotesk Variable',Arial,sans-serif;font-size:clamp(25px,3vw,36px);line-height:1.12;letter-spacing:-.06em;font-weight:640;margin:16px 0 8px}
  .sb-paper-package__price{font-family:'Space Grotesk Variable',Arial,sans-serif;font-size:28px;font-weight:600;letter-spacing:-.06em;margin:0 0 22px}
  .sb-paper-package ul{list-style:none;margin:0 0 30px;padding:0;display:grid;gap:12px;font-size:13px;line-height:1.55;color:#605d56}
  .sb-paper-package li{padding-left:17px;position:relative}
  .sb-paper-package li::before{content:'—';position:absolute;left:0;color:#898479}
  .sb-paper-package a{font-size:13px;font-weight:650;color:#292722;text-decoration:none;border-bottom:1px solid #777166;padding-bottom:5px}
  .sb-paper-package a:hover{color:#796e58}
  @media(max-width:700px){
    .sb-paper-packages{padding:0 16px 80px}
    .sb-paper-packages__inner{padding-top:65px;min-height:auto}
    .sb-paper-packages__rail{left:8px;width:5px;transform:translateX(0) scaleY(0)}
    .sb-paper-packages.is-visible .sb-paper-packages__rail{transform:translateX(0) scaleY(1)}
    .sb-paper-packages__grid{grid-template-columns:minmax(0,1fr);gap:30px;padding-left:28px}
    .sb-paper-package--left,.sb-paper-package--right{grid-column:1}
    .sb-paper-package{padding:26px 22px}
  }
  @media(prefers-reduced-motion:reduce){.sb-paper-packages__rail,.sb-paper-package{transition:none;opacity:1;filter:none;transform:none}.sb-paper-packages__rail{transform:translateX(-50%) scaleY(1)}}
</style>
<script>
  const section=document.querySelector('.sb-paper-packages');
  if(section){
    const observer=new IntersectionObserver(entries=>{
      for(const entry of entries){
        if(!entry.isIntersecting)continue;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    },{threshold:.12,rootMargin:'0px 0px -35px 0px'});
    observer.observe(section);
    section.querySelectorAll('[data-paper-reveal]').forEach(el=>observer.observe(el));
  }
</script>
