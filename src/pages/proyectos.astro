---
import Base from '../layouts/Base.astro';
import {projects} from '../data/projects.js';
---
<Base title="Proyectos"><section class="container page-head"><div class="eyebrow">Portafolio</div><h1>Proyectos con intención.</h1><p class="lead">Trabajos realizados y demostraciones, siempre identificados claramente.</p></section><section class="container section">{projects.length?<><div class="filter-row"><button class="filter active" data-filter="todos">Todos</button>{[...new Set(projects.map(p=>p.category))].map(c=><button class="filter" data-filter={c}>{c}</button>)}</div><div class="cards portfolio-grid">{projects.map(p=><article class="card project-card" data-category={p.category}>{p.image&&<img src={p.image} alt={p.title} loading="lazy"/>}<span class="eyebrow">{p.category} · {p.type==='demo'?'Concepto de muestra':'Proyecto'}</span><h3>{p.title}</h3><p>{p.description}</p>{p.url&&<a href={p.url} target="_blank" rel="noopener noreferrer">Ver proyecto ↗</a>}</article>)}</div></>:<div class="empty"><div class="eyebrow">Portafolio en preparación</div><h2>Pronto compartiremos proyectos.</h2><p>El sistema de fichas y filtros está preparado. Añadiremos trabajos reales o conceptos de demostración identificados correctamente en cuanto dispongamos de ellos.</p></div>}</section><script>const filters=document.querySelectorAll('[data-filter]');filters.forEach(b=>b.addEventListener('click',()=>{filters.forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelectorAll('[data-category]').forEach(c=>c.hidden=b.dataset.filter!=='todos'&&c.dataset.category!==b.dataset.filter)}));</script></Base>