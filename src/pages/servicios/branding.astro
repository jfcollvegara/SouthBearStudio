---
import Base from '../../layouts/Base.astro';
---
<Base title="Logotipos e identidad visual" description="Logotipos e identidad visual en SouthBear Studio.">
  <section class="sb-branding-intro" aria-labelledby="sb-branding-title">
    <div class="sb-branding-intro__underlay" aria-hidden="true"></div>
    <svg class="sb-branding-intro__cutout" viewBox="0 0 1200 720" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      <defs>
        <mask id="sb-branding-title-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1200" height="720">
          <rect width="1200" height="720" fill="white" />
          <text x="600" y="340" class="sb-branding-intro__svg-text">Logotipos</text>
          <text x="600" y="420" class="sb-branding-intro__svg-text">e identidad visual</text>
        </mask>
      </defs>
      <rect width="1200" height="720" fill="white" mask="url(#sb-branding-title-mask)" />
    </svg>
    <h1 id="sb-branding-title" class="sb-branding-intro__title">
      <span>Logotipos</span>
      <span>e identidad visual</span>
    </h1>
  </section>
</Base>
<style>
  .sb-branding-intro{position:relative;isolation:isolate;min-height:100vh;min-height:100svh;width:100%;overflow:hidden;display:grid;place-items:center;background:#fff}
  .sb-branding-intro__underlay{position:absolute;inset:0;background:radial-gradient(ellipse at 48% 42%,#575757 0%,#252525 44%,#0b0b0b 100%);z-index:0}
  .sb-branding-intro__cutout{position:absolute;inset:0;width:100%;height:100%;z-index:1}
  .sb-branding-intro__svg-text{font-family:'Space Grotesk Variable',Arial,sans-serif;font-size:82px;font-weight:650;letter-spacing:-.07em;text-anchor:middle;fill:#000}
  .sb-branding-intro__title{position:absolute;z-index:2;display:flex;flex-direction:column;align-items:center;gap:0;margin:0;width:100%;padding:0 18px;color:#090909;text-align:center;font-family:'Space Grotesk Variable',Arial,sans-serif;font-size:clamp(36px,6.83vw,82px);font-weight:650;line-height:.98;letter-spacing:-.07em;animation:sb-branding-title-reveal 2.7s both}
  .sb-branding-intro__title span{display:block}
  .sb-branding-intro__cutout{opacity:0;animation:sb-branding-cutout 2.7s ease-in-out forwards}
  @keyframes sb-branding-title-reveal{0%{opacity:0;filter:blur(12px)}28%{opacity:1;filter:blur(0)}60%{opacity:1;filter:blur(0)}100%{opacity:0;filter:blur(0)}}
  @keyframes sb-branding-cutout{0%,55%{opacity:0}100%{opacity:1}}
  @media(max-width:700px){
    .sb-branding-intro__svg-text{font-size:110px}
    .sb-branding-intro__title{font-size:clamp(34px,8.8vw,64px)}
  }
  @media(prefers-reduced-motion:reduce){.sb-branding-intro__title{animation:none;opacity:0}.sb-branding-intro__cutout{animation:none;opacity:1}}
</style>
