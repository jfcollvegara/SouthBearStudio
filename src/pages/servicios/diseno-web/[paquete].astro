---
import Base from '../../../layouts/Base.astro';
import { webPackages, formatWebPackagePrice } from '../../../data/web-packages.js';

export function getStaticPaths(){
  return webPackages.map(pkg=>({
    params:{ paquete:pkg.slug },
    props:{ pkg }
  }));
}
const { pkg }=Astro.props;
const url='/presupuesto/?servicio=diseno-web&paquete='+encodeURIComponent(pkg.name);
---
<Base
  title={pkg.name+' | Diseño web'}
  description={pkg.summary+' SouthBear Studio. Paquete de diseño web desde '+formatWebPackagePrice(pkg)+'.'}
>
  <article class="sb-web-detail">
    <div class="sb-web-detail-inner">
      <a class="sb-web-detail-back" href="/servicios/diseno-web/">← Volver a los paquetes</a>
      <div class="sb-web-detail-grid">
        <div>
          <p class="sb-web-detail-eyebrow">DISEÑO Y DESARROLLO WEB</p>
          <h1>{pkg.name}</h1>
          <p class="sb-web-detail-summary">{pkg.summary}</p>
          <p class="sb-web-detail-price">Desde {formatWebPackagePrice(pkg)}</p>
          <a class="sb-web-detail-action" href={url}>Solicitar presupuesto <span aria-hidden="true">↗</span></a>
        </div>
        <div class="sb-web-detail-features">
          <h2>Qué incluye este paquete</h2>
          <ul>{pkg.features.map(feature=><li>{feature}</li>)}</ul>
          <p>Precio con IVA incluido. Los extras y condiciones adicionales se detallarán en el presupuesto.</p>
        </div>
      </div>
    </div>
  </article>
</Base>
<style>
  .sb-web-detail{
    background:radial-gradient(ellipse at 87% 8%,rgba(221,255,154,.27),transparent 43%),#fff;
    min-height:75svh;padding:clamp(38px,5vw,75px) clamp(20px,6vw,100px) clamp(100px,12vw,170px);
    color:#111;
  }
  .sb-web-detail-inner{max-width:1290px;margin:0 auto}
  .sb-web-detail-back{display:inline-flex;margin-bottom:clamp(65px,9vw,130px);font-size:.86rem;font-weight:750;color:#3d602b}
  .sb-web-detail-back:hover{color:#111}
  .sb-web-detail-grid{display:grid;grid-template-columns:1fr .85fr;gap:clamp(45px,7vw,125px);align-items:start}
  .sb-web-detail-eyebrow{font-size:.7rem;font-weight:750;letter-spacing:.15em;color:#567438;margin:0 0 18px}
  .sb-web-detail h1{font-size:clamp(3.7rem,7.8vw,8.5rem);line-height:.95;letter-spacing:-.085em;color:#111;margin:0 0 26px}
  .sb-web-detail-summary{font-size:clamp(1.07rem,1.6vw,1.45rem);line-height:1.55;max-width:550px}
  .sb-web-detail-price{
    display:table;margin:42px 0 36px;font-size:clamp(1.7rem,2.6vw,2.6rem);
    font-weight:850;letter-spacing:-.045em;color:#487525;
    background:linear-gradient(105deg,#46731e,#7aa839 46%,#416b1e);
    background-clip:text;-webkit-background-clip:text;-webkit-text-fill-color:transparent;
  }
  .sb-web-detail-action{
    display:inline-flex;align-items:center;justify-content:space-between;gap:45px;
    padding:18px 25px;background:#111;color:#fff!important;border-radius:999px;font-weight:750;
    transition:transform .2s ease;
  }
  .sb-web-detail-action:hover{transform:translateY(-3px)}
  .sb-web-detail-features{
    padding:clamp(28px,4vw,52px);border:1px solid #fff;border-radius:28px;
    background:rgba(255,255,255,.62);backdrop-filter:blur(20px);
    box-shadow:0 18px 60px rgba(25,47,23,.08),inset 0 2px 0 #fff;
  }
  .sb-web-detail-features h2{margin:0 0 30px;font-size:clamp(1.4rem,2.2vw,2.2rem);letter-spacing:-.055em}
  .sb-web-detail-features ul{list-style:none;padding:0;margin:0;display:grid;gap:18px}
  .sb-web-detail-features li{position:relative;padding-left:26px;line-height:1.55;color:#242b24}
  .sb-web-detail-features li::before{content:'✓';position:absolute;left:0;color:#588a31;font-weight:800}
  .sb-web-detail-features>p{margin:40px 0 0;font-size:.84rem;line-height:1.55;color:#4e574d}
  @media(max-width:850px){.sb-web-detail-grid{grid-template-columns:1fr}.sb-web-detail-back{margin-bottom:75px}}
  @media(prefers-reduced-motion:reduce){.sb-web-detail-action{transition:none}}
</style>
