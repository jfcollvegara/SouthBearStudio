---
import Base from '../../layouts/Base.astro';
import { catalog } from '../../data/catalog.js';

// Los cuatro paquetes, sus extras y condiciones siguen en src/data/catalog.js.
const headline = 'PRODUCCIÓN AUDIOVISUAL';

// Las condiciones, nombres, precios y características provienen del catálogo original.
const audiovisual = catalog.find(service => service.slug === 'audiovisual');
const packageDescriptions = {
  'Reel Profesional': 'Piezas breves y dinámicas para comunicar con fuerza en redes sociales y captar todas las miradas.',
  'Vídeo Promocional': 'Muestra lo mejor de tu producto o servicio con una historia que conecta con tu público.',
  'Vídeo Corporativo': 'Presenta tu marca, sus valores y su esencia a través de una producción cuidada al detalle.',
  'Vídeo Personalizado': 'Una producción singular, concebida desde cero para dar forma a aquello que tienes en mente.'
};
const audiovisualPackages = audiovisual.packages.map(pkg => ({
  ...pkg,
  summary: packageDescriptions[pkg.name] || pkg.features[0]
}));
const formatPackagePrice = pkg => pkg.price == null
  ? 'Bajo presupuesto'
  : 'Desde ' + new Intl.NumberFormat('es-ES', {maximumFractionDigits:2}).format(pkg.price) + ' €';

// Iconos vectoriales lineales para los 17 complementos. El orden sigue
// las secciones de extras conservadas en el catálogo comercial.
const extraIconShapes = [
  "M12 3l8 8-9 9-6 1 1-6 9-9 M13 6l5 5 M5 19l3-3",
  "M3 5h18v14H3z M7 5l4 5 M15 5l4 5 M3 10h18 M9 14h6 M12 12v5",
  "M5 3h14v18H5z M8 7h8 M8 11h8 M8 15h5 M8 19h3 M17 17l4-4",
  "M4 9a8 8 0 1 1 1 7 M4 4v5h5",
  "M12 3v3 M12 18v3 M4.2 7.5l2.6 2 M17.2 14.5l2.6 2 M3 12h5 M16 12h5 M7 17l4-4 3 3 4-6",
  "M4 5h16v14H4z M8 9h8 M8 13h6 M8 17h4 M16 17l2-2 M16 15l2 2",
  "M12 21s7-5.8 7-12a7 7 0 0 0-14 0c0 6.2 7 12 7 12z M9 9a3 3 0 1 0 6 0a3 3 0 1 0-6 0",
  "M5 18h14 M5 6h14 M8 6v12 M16 6v12 M5 12h14 M10 9l4 3-4 3",
  "M3 18l4-5 4 3 5-8 5 3 M16 4h5v5",
  "M3 20l6-6 3 2 8-10 M15 6h5v5 M3 4h7",
  "M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M8 10a4 4 0 1 0 0-8a4 4 0 0 0 0 8 M22 20v-2a4 4 0 0 0-3-3.9 M16 2.1a4 4 0 0 1 0 7.8",
  "M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3 M5 11a7 7 0 0 0 14 0 M12 18v3 M8 21h8",
  "M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z M19 3l.7 1.3L21 5l-1.3.7L19 7l-.7-1.3L17 5l1.3-.7z",
  "M7 3h10v3H7z M5 6h14v15H5z M9 10h6 M9 14h6 M9 18h4",
  "M3 10l8-2 8-5-5 8-2 8-2-6-7-3z M11 8l3 3",
  "M3 7h7l2 2h9v11H3z M8 14h8 M12 11v6",
  "M3 6h18v15H3z M7 3v6 M17 3v6 M3 11h18 M7 15h3 M14 15h3"
];
const audiovisualExtraSections = audiovisual.extraSections.map((section,groupIndex)=>{
  const offset = audiovisual.extraSections.slice(0,groupIndex)
    .reduce((sum,previous)=>sum+previous.items.length,0);
  return {
    ...section,
    slug:'av-extra-group-'+groupIndex,
    items:section.items.map((item,index)=>({
      ...item,
      detailId:'av-extra-detail-'+groupIndex+'-'+index,
      iconPath:extraIconShapes[offset+index]
    }))
  };
});
const formatExtraPrice = extra => extra.price == null
  ? 'Bajo presupuesto'
  : new Intl.NumberFormat('es-ES',{maximumFractionDigits:2}).format(extra.price)+' €';
const showcase = [
  { shade:'#313131', grow:0.88 },
  { shade:'#545454', grow:1.08 },
  { shade:'#242424', grow:1.28 },
  { shade:'#414141', grow:1 }
];
---
<Base
  title="Producción audiovisual"
  description="Producción audiovisual a medida en SOUTHBEAR STUDIO. Vídeos, rodajes y edición profesional."
>
  <section class="sb-av-hero" aria-labelledby="sb-av-title">
    <div class="sb-av-hero__inner">
      <h1 class="sb-av-hero__title" id="sb-av-title" aria-label={headline}>
        {Array.from(headline).map(letter=>(
          <span class:list={['sb-av-hero__character', {'sb-av-hero__space':letter===' '}]} aria-hidden="true">{letter===' ' ? '\u00A0' : letter}</span>
        ))}
        <span class="sb-av-hero__rec" aria-hidden="true"></span>
      </h1>
      <p class="sb-av-hero__tagline">La creatividad cobra vida en cada fotograma.</p>
    </div>

    <!-- Cuatro espacios 2,35:1 provisionales para los futuros vídeos.
         En móvil forman una composición editorial, parcialmente recortada. -->
    <div class="sb-av-showcase" aria-hidden="true">
      {showcase.map((frame, index)=>(
        <div
          class="sb-av-showcase__frame"
          style={`--frame-grow:${frame.grow};--frame-index:${index};--frame-color:${frame.shade}`}
        ></div>
      ))}
    </div>
  </section>

  <!-- Paquetes audiovisuales recuperados del catálogo; vídeos pendientes. -->
  <section class="sb-av-packages" aria-labelledby="sb-av-packages-heading">
    <div class="sb-av-packages__inner">
      <header class="sb-av-packages__header">
        <h2 id="sb-av-packages-heading">Nuestros paquetes.</h2>
      </header>
      <div class="sb-av-packages__list">
        {audiovisualPackages.map((pkg,index)=>(
          <article class:list={['sb-av-package', {'sb-av-package--reverse':index % 2 === 1}]}>
            <div class="sb-av-package__copy">
              <h3>{pkg.name}</h3>
              <p>{pkg.summary}</p>
              <strong class="sb-av-package__price">{formatPackagePrice(pkg)}</strong>
            </div>
            <div class="sb-av-package__media" aria-label={'Espacio reservado para el vídeo de '+pkg.name}>
              <div class="sb-av-package__video-slot" aria-hidden="true"></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Extras: iconos tipo app que muestran el detalle y el precio al pulsarlos. -->
  <section class="sb-av-extras" aria-labelledby="sb-av-extras-heading">
    <div class="sb-av-extras__inner">
      <header class="sb-av-extras__heading">
        <h2 id="sb-av-extras-heading">Servicios extra.</h2>
        <p>Personaliza tu producción. Pulsa cualquier icono para ver sus detalles y su precio.</p>
      </header>

      {audiovisualExtraSections.map(group=>(
        <section class="sb-av-extra-group" aria-labelledby={group.slug+'-title'} data-av-extra-group>
          <div class="sb-av-extra-group__heading">
            <h3 id={group.slug+'-title'}>{group.title}</h3>
            {group.intro && <p>{group.intro}</p>}
          </div>
          <div class="sb-av-extra-apps">
            {group.items.map(item=>(
              <button
                class="sb-av-extra-app"
                type="button"
                aria-expanded="false"
                aria-controls={item.detailId}
                data-av-extra-trigger
              >
                <span class="sb-av-extra-app__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={item.iconPath} />
                  </svg>
                </span>
                <span class="sb-av-extra-app__label">{item.name}</span>
              </button>
            ))}
          </div>
          <div class="sb-av-extra-details">
            {group.items.map(item=>(
              <article class="sb-av-extra-detail" id={item.detailId} data-av-extra-panel hidden>
                <div class="sb-av-extra-detail__copy">
                  <span class="sb-av-extra-detail__category">{group.title}</span>
                  <h4>{item.name}</h4>
                  <p>{item.detail}</p>
                </div>
                <div class="sb-av-extra-detail__aside">
                  <strong>{formatExtraPrice(item)}</strong>
                  <button
                    type="button"
                    class="sb-av-extra-detail__close"
                    aria-label={'Cerrar detalles de '+item.name}
                    data-av-extra-close
                  >Cerrar <span aria-hidden="true">×</span></button>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
      <p class="sb-av-extras__tax">Precios con IVA incluido. Los servicios bajo presupuesto se concretan según las necesidades del proyecto.</p>
    </div>
  </section>
</Base>

<script>
  // Una sola ficha visible dentro de cada grupo; interacción accesible
  // por ratón, pantalla táctil y teclado, sin dependencias externas.
  document.querySelectorAll<HTMLElement>('[data-av-extra-group]').forEach(group => {
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-av-extra-trigger]'));
    const panels = Array.from(group.querySelectorAll<HTMLElement>('[data-av-extra-panel]'));
    const closeAll = () => {
      buttons.forEach(button => {
        button.setAttribute('aria-expanded', 'false');
        button.classList.remove('is-active');
      });
      panels.forEach(panel => { panel.hidden = true; });
    };
    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const target = group.querySelector<HTMLElement>('#' + button.getAttribute('aria-controls'));
        if (!target) return;
        const wasOpen = button.getAttribute('aria-expanded') === 'true';
        closeAll();
        if (!wasOpen) {
          button.setAttribute('aria-expanded', 'true');
          button.classList.add('is-active');
          target.hidden = false;
          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          target.scrollIntoView({
            behavior: prefersReducedMotion ? 'auto' : 'smooth',
            block: 'nearest'
          });
        }
      });
    });
    group.querySelectorAll<HTMLButtonElement>('[data-av-extra-close]').forEach(close => {
      close.addEventListener('click', () => {
        const panel = close.closest<HTMLElement>('[data-av-extra-panel]');
        const button = buttons.find(btn => btn.getAttribute('aria-controls') === panel?.id);
        closeAll();
        button?.focus({preventScroll:true});
      });
    });
  });
</script>

<style>
  .sb-av-hero{
    position:relative;
    isolation:isolate;
    width:100%;
    min-height:calc(100svh - 83px);
    overflow:hidden;
    display:flex;
    flex-direction:column;
    padding:0;
    background:#0A0A0A;
    color:#fff;
  }
  .sb-av-hero__inner{
    position:relative;
    width:100%;
    margin-inline:auto;
    padding:clamp(69px,7.7vw,148px) clamp(18px,4vw,92px) 0;
  }
  /* Titular de una sola línea, distribuido entre márgenes de seguridad. */
  .sb-av-hero__title{
    position:relative;
    z-index:1;
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    width:100%;
    max-width:100%;
    margin:0;
    /* El punto REC es un elemento flex más y comparte el espaciado de las letras. */
    overflow:visible;
    padding:0;
    white-space:nowrap;
    color:#FAFAFA;
    font-family:var(--font-heading);
    font-size:clamp(1rem,5vw,7.5rem);
    font-weight:750;
    line-height:1.05;
    letter-spacing:-.045em;
    text-transform:uppercase;
    opacity:0;
    transform:translate3d(0,14px,0) scale(.991);
    filter:blur(7px);
    animation:sb-av-hero-focus 1.4s cubic-bezier(.18,.8,.2,1) .12s both;
  }
  .sb-av-hero__character{
    display:block;
    flex:0 0 auto;
    min-width:0;
    color:inherit;
    -webkit-text-fill-color:currentColor;
  }
  .sb-av-hero__space{
    flex:0 0 clamp(9px,1.55vw,29px);
    width:clamp(9px,1.55vw,29px);
    font-size:0;
  }
  /* Carácter REC independiente: mismo hueco automático que cualquier letra. */
  .sb-av-hero__rec{
    display:block;
    flex:0 0 .23em;
    align-self:flex-end;
    width:.23em;
    height:.23em;
    margin-bottom:.1em;
    border-radius:50%;
    background:#FF3038;
    box-shadow:0 0 .13em rgba(255,48,56,.45);
    pointer-events:none;
    animation:sb-av-rec-blink 1.3s step-end infinite;
  }
  @keyframes sb-av-rec-blink{
    0%,54%{opacity:1}
    55%,100%{opacity:.09}
  }
  /* Luz ambiental discreta que aparece y se asienta, sin barridos. */
  .sb-av-hero__inner::before{
    content:'';
    position:absolute;
    z-index:0;
    inset:-55% 11% -105%;
    pointer-events:none;
    background:radial-gradient(ellipse at 50% 45%,
      rgba(255,255,255,.065) 0%,
      rgba(255,255,255,.018) 38%,
      transparent 75%);
    opacity:0;
    animation:sb-av-ambient-fade 2s ease-out .12s both;
  }
  @keyframes sb-av-hero-focus{
    0%{opacity:0;transform:translate3d(0,14px,0) scale(.991);filter:blur(7px)}
    60%{opacity:1}
    100%{opacity:1;transform:translate3d(0,0,0) scale(1);filter:blur(0)}
  }
  @keyframes sb-av-ambient-fade{
    0%{opacity:0}
    44%{opacity:1}
    100%{opacity:.25}
  }
  /* Frase breve con degradado corporativo y entrada desde abajo. */
  .sb-av-hero__tagline{
    position:relative;
    z-index:1;
    display:table;
    max-width:100%;
    margin:clamp(25px,3.5vw,52px) auto 0;
    text-align:center;
    color:#ddff9a;
    font-family:var(--font-heading);
    font-size:clamp(1rem,2vw,1.8rem);
    font-weight:650;
    line-height:1.3;
    letter-spacing:-.035em;
    background-image:var(--brand-text-gradient,linear-gradient(108deg,#daff9c,#f4f5a4,#ccf294));
    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;
    opacity:0;
    transform:translate3d(0,28px,0);
    animation:sb-av-tagline-rise .9s cubic-bezier(.2,.76,.25,1) .7s both;
  }
  @keyframes sb-av-tagline-rise{
    from{opacity:0;transform:translate3d(0,28px,0)}
    to{opacity:1;transform:translate3d(0,0,0)}
  }

  /* Serie de fotogramas de distinto tamaño pero relación 16:9 real,
     con una línea inferior compartida y entrada escalonada. */
  .sb-av-showcase{
    position:relative;
    z-index:1;
    display:flex;
    align-items:flex-end;
    width:100%;
    gap:0;
    margin-top:auto;
    padding-top:clamp(58px,9vw,155px);
  }
  .sb-av-showcase__frame{
    flex:var(--frame-grow) 1 0%;
    min-width:0;
    aspect-ratio:2.35 / 1;
    background:var(--frame-color);
    border-radius:0;
    overflow:hidden;
    opacity:0;
    transform:translate3d(0,90px,0);
    animation:sb-av-frame-rise .85s cubic-bezier(.19,.83,.23,1) both;
    animation-delay:calc(1.35s + var(--frame-index) * .21s);
  }
  @keyframes sb-av-frame-rise{
    0%{opacity:0;transform:translate3d(0,90px,0)}
    100%{opacity:1;transform:translate3d(0,0,0)}
  }
  @media(min-width:681px) and (max-height:690px){
    .sb-av-hero__inner{padding-top:clamp(34px,5vh,72px)}
    .sb-av-showcase{padding-top:35px}
  }
  @media(max-width:680px){
    .sb-av-hero{min-height:calc(100svh - 72px)}
    .sb-av-hero__inner{padding:clamp(64px,15vw,105px) 15px 0}
    .sb-av-hero__title{
      font-size:4.8vw;
      font-weight:750;
      letter-spacing:-.05em;
    }
    .sb-av-hero__space{flex-basis:9px;width:9px}
    .sb-av-hero__tagline{font-size:clamp(.94rem,3.7vw,1.22rem);margin-top:25px}
    /* Móvil: cuatro fotogramas enormes en dos niveles. Cada uno mide
       un 78% del ancho de pantalla: el conjunto desborda los laterales
       y la segunda fila se desplaza para mostrar una composición distinta.
       No hay desplazamiento horizontal ni espacio vacío bajo el título. */
    .sb-av-hero{min-height:0}
    .sb-av-showcase{
      display:grid;
      grid-template-columns:repeat(2,78vw);
      align-items:end;
      gap:0;
      width:156vw;
      margin:clamp(28px,5vh,48px) 0 0 -9vw;
      padding:0;
      overflow:visible;
    }
    .sb-av-showcase__frame{
      position:relative;
      width:100%;
      min-width:0;
      flex:none;
      aspect-ratio:2.35 / 1;
      border-radius:0;
    }
    .sb-av-showcase__frame:nth-child(n+3){left:-28vw}
  }

  /* Paquetes: cristal blanco traslúcido sobre negro, con reflejos suaves. */
  .sb-av-packages{
    position:relative;
    width:100%;
    padding:clamp(85px,9vw,145px) clamp(18px,4vw,92px) clamp(105px,12vw,180px);
    background:#0A0A0A;
    color:#fff;
  }
  .sb-av-packages__inner{width:100%;max-width:1510px;margin:0 auto}
  .sb-av-packages__header{margin-bottom:clamp(32px,4vw,62px)}
  .sb-av-packages__header h2{
    margin:0;
    color:#fff;
    font-family:var(--font-heading);
    font-size:clamp(2.05rem,4.2vw,4.3rem);
    line-height:1.08;
    font-weight:750;
    letter-spacing:-.065em;
  }
  .sb-av-packages__list{
    display:grid;
    gap:clamp(23px,3vw,48px);
  }
  .sb-av-package{
    position:relative;
    isolation:isolate;
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(0,47%);
    align-items:center;
    gap:clamp(30px,4vw,80px);
    min-width:0;
    min-height:clamp(360px,32vw,480px);
    padding:clamp(22px,3vw,46px);
    overflow:hidden;
    border:1px solid rgba(255,255,255,.25);
    border-radius:clamp(24px,2.7vw,38px);
    background:linear-gradient(135deg,
      rgba(255,255,255,.16) 0%,
      rgba(255,255,255,.085) 30%,
      rgba(255,255,255,.065) 62%,
      rgba(255,255,255,.13) 100%);
    -webkit-backdrop-filter:blur(16px) saturate(140%);
    backdrop-filter:blur(16px) saturate(140%);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.51),
      inset 0 -1px 0 rgba(255,255,255,.1),
      0 22px 65px rgba(0,0,0,.22);
    transition:border-color .32s ease,box-shadow .32s ease,transform .32s ease;
  }
  .sb-av-package::before{
    content:'';
    position:absolute;
    inset:0;
    z-index:0;
    border-radius:inherit;
    pointer-events:none;
    background:
      radial-gradient(ellipse at 8% 0%,rgba(255,255,255,.23),transparent 47%),
      linear-gradient(135deg,rgba(255,255,255,.12),transparent 47%,rgba(255,255,255,.07));
  }
  .sb-av-package:hover{
    transform:translateY(-3px);
    border-color:rgba(255,255,255,.6);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.68),
      0 0 0 1px rgba(255,255,255,.11),
      0 0 27px rgba(255,255,255,.15),
      0 19px 60px rgba(0,0,0,.28);
  }
  .sb-av-package--reverse{
    grid-template-columns:minmax(0,47%) minmax(0,1fr);
  }
  .sb-av-package--reverse .sb-av-package__media{order:-1}
  .sb-av-package__copy{
    position:relative;
    z-index:1;
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    justify-content:center;
    min-width:0;
    padding:clamp(5px,1.5vw,22px);
    text-align:left;
  }
  .sb-av-package h3{
    max-width:660px;
    margin:0;
    color:#fff;
    font-family:var(--font-heading);
    font-weight:750;
    font-size:clamp(2.1rem,3.8vw,4.35rem);
    line-height:1.05;
    letter-spacing:-.065em;
  }
  .sb-av-package__copy p{
    max-width:520px;
    margin:clamp(18px,2.1vw,32px) 0 0;
    font-size:clamp(.98rem,1.25vw,1.16rem);
    line-height:1.68;
    color:rgba(255,255,255,.82);
  }
  .sb-av-package__price{
    display:inline-block;
    margin-top:clamp(30px,3.5vw,52px);
    color:#DDFF9A;
    background-image:var(--brand-text-gradient,linear-gradient(108deg,#daff9c,#f4f5a4,#ccf294));
    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;
    font-size:clamp(1.5rem,2.1vw,2.35rem);
    font-weight:850;
    line-height:1.2;
    letter-spacing:-.045em;
  }
  .sb-av-package__media{position:relative;z-index:1;min-width:0;width:100%}
  .sb-av-package__video-slot{
    width:100%;
    aspect-ratio:16 / 9;
    border-radius:clamp(13px,1.25vw,20px);
    background:#414141;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.18),
      0 14px 38px rgba(0,0,0,.24);
    overflow:hidden;
  }
  @media(max-width:960px){
    .sb-av-package,.sb-av-package--reverse{
      grid-template-columns:1fr;
      min-height:0;
      gap:clamp(24px,3vw,40px);
    }
    .sb-av-package--reverse .sb-av-package__media{order:initial}
    .sb-av-package__copy{padding:8px}
    .sb-av-package__media{width:100%}
  }
  @media(max-width:680px){
    .sb-av-packages{padding:72px 15px 110px}
    .sb-av-packages__header{margin-bottom:30px}
    .sb-av-packages__header h2{font-size:clamp(2.05rem,7.5vw,3rem)}
    .sb-av-packages__list{gap:20px}
    .sb-av-package{
      padding:23px;
      border-radius:25px;
      gap:24px;
