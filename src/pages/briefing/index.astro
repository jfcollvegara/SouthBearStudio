---
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource-variable/inter/wght.css';
---
<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="robots" content="noindex,nofollow,noarchive"/><meta name="referrer" content="strict-origin-when-cross-origin"/>
<link rel="icon" href="/favicon.ico?v=4" sizes="any"/><title>Tu briefing creativo | SOUTHBEAR STUDIO</title>
</head>
<body>
 <div class="sb-bf-layout">
  <header class="sb-bf-header"><a href="/" aria-label="SouthBear Studio, volver a la web"><img src="/southbear-logo.svg" alt="SOUTHBEAR STUDIO" width="184" height="42"/></a><span>CREATIVE BRIEFING / SOUTHBEAR</span></header>
  <main class="sb-bf-main">
   <div class="sb-bf-eyebrow">01 / CONOZCAMOS TU PROYECTO</div>
   <h1>Tu proyecto.<br/><span>Tu estilo.</span></h1>
   <p class="sb-bf-intro">Antes de diseñar queremos entender tu negocio, tus ideas y tus gustos. No necesitas conocimientos de diseño; si alguna pregunta no la tienes clara, puedes dejarla en blanco cuando no sea obligatoria.</p>
   <div id="sb-bf-load" class="sb-bf-state" role="status">Preparando tu formulario…</div>
   <section id="sb-bf-ready" hidden>
    <div class="sb-bf-client"><span>PREPARADO PARA</span><strong id="sb-bf-company"></strong><small id="sb-bf-service"></small></div>
    <div class="sb-bf-progress"><div><span id="sb-bf-progress-label">PASO 1</span><span id="sb-bf-progress-count"></span></div><div class="sb-bf-track"><i id="sb-bf-bar"></i></div></div>
    <form id="sb-bf-form">
     <div class="sb-bf-step-head"><span id="sb-bf-section"></span><h2 id="sb-bf-step-title"></h2></div>
     <div id="sb-bf-questions" class="sb-bf-questions"></div>
     <div id="sb-bf-final" class="sb-bf-final" hidden>
      <h2>Ya casi está.</h2>
      <p>Comprueba tus respuestas si lo necesitas. Al enviar, este enlace quedará cerrado para evitar duplicados.</p>
      <label><input type="checkbox" id="sb-bf-consent"/> <span>Entiendo que SouthBear Studio utilizará mis respuestas para estudiar y preparar el proyecto contratado, y que no debo compartir información especialmente sensible.</span></label>
     </div>
     <p id="sb-bf-error" class="sb-bf-error" role="alert"></p>
     <div class="sb-bf-actions"><button type="button" id="sb-bf-back" class="sb-bf-secondary" hidden>← Anterior</button><button type="button" id="sb-bf-next" class="sb-bf-primary">Continuar →</button><button type="submit" id="sb-bf-send" class="sb-bf-primary" hidden>Enviar briefing →</button></div>
    </form>
   </section>
   <section id="sb-bf-success" class="sb-bf-success" hidden><span>✓</span><h2>¡Gracias por compartir tus ideas!</h2><p>Hemos recibido tu briefing correctamente. SouthBear Studio revisará la información antes de comenzar a trabajar en tu propuesta.</p><a href="/">Volver a SouthBear Studio ↗</a></section>
  </main>
  <footer class="sb-bf-footer">SOUTHBEAR STUDIO / BRIEFING CREATIVO <span>UNA IDEA. MIL POSIBILIDADES.</span></footer>
 </div>
</body>
<style>
:root{font-family:'Inter Variable',system-ui,sans-serif;background:#fbfcf9;color:#161d16}
*{box-sizing:border-box}body{margin:0}button,input,textarea,select{font:inherit}
.sb-bf-layout{min-height:100svh;display:flex;flex-direction:column;overflow-x:hidden}
.sb-bf-header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:22px clamp(22px,5vw,75px);border-bottom:1px solid #dae4d4}
.sb-bf-header img{display:block;max-width:100%;height:auto}.sb-bf-header span{font-size:10px;font-weight:750;letter-spacing:.13em;color:#7a8672}
.sb-bf-main{flex:1;width:min(900px,calc(100% - 38px));margin:65px auto 90px}
.sb-bf-eyebrow,.sb-bf-client>span,.sb-bf-progress>div:first-child,.sb-bf-step-head>span{font-size:11px;font-weight:800;letter-spacing:.15em;color:#6c8160}
.sb-bf-main>h1{font:740 clamp(48px,8vw,96px)/.94 'Space Grotesk Variable',sans-serif;letter-spacing:-.085em;margin:19px 0 26px}.sb-bf-main>h1 span{color:#7b9c65}
.sb-bf-intro{max-width:680px;color:#62715d;font-size:16px;line-height:1.8;margin-bottom:32px}
.sb-bf-state{padding:24px;border:1px solid #d6dfd0;color:#5d6d55;background:white}
.sb-bf-client{display:grid;gap:10px;border:1px solid #e5eedd;padding:22px 24px;background:linear-gradient(120deg,#eff9e3,#fff);border-radius:12px}
.sb-bf-client strong{font:720 clamp(22px,3vw,34px)/1.15 'Space Grotesk Variable',sans-serif;letter-spacing:-.045em}
.sb-bf-client small{font-size:13px;color:#566d4c}
.sb-bf-progress{margin:34px 0}.sb-bf-progress>div:first-child{display:flex;justify-content:space-between;gap:12px;margin-bottom:12px}
.sb-bf-track{height:5px;background:#dfebd5;border-radius:10px;overflow:hidden}.sb-bf-track i{display:block;width:0;height:100%;background:#99bb6d;transition:width .2s}
.sb-bf-step-head{margin:0 0 24px}.sb-bf-step-head h2{font:700 clamp(27px,4vw,42px)/1.13 'Space Grotesk Variable',sans-serif;letter-spacing:-.06em;margin:13px 0}
.sb-bf-questions{display:grid;gap:20px}
.sb-bf-field{display:grid;gap:10px;background:white;border:1px solid #e0e8dc;padding:24px;border-radius:12px;box-shadow:0 12px 35px #1d391309}
.sb-bf-field>label,.sb-bf-field legend{font-size:15px;font-weight:750;line-height:1.4}.sb-bf-field label b{color:#769d4e}
.sb-bf-field small{display:block;color:#7a8774;line-height:1.6}
.sb-bf-field textarea,.sb-bf-field input[type=text]{width:100%;min-height:52px;border:1px solid #bfcdb9;border-radius:6px;padding:14px;font-size:14px;color:#222b20;background:#fcfefb}
.sb-bf-field textarea{min-height:110px;resize:vertical;line-height:1.55}
.sb-bf-field input:focus,.sb-bf-field textarea:focus{outline:2px solid #a0c776}
.sb-bf-choicegrid{display:flex;gap:9px;flex-wrap:wrap}.sb-bf-option{position:relative;display:flex;align-items:center;gap:8px;border:1px solid #cbdac3;border-radius:8px;padding:11px 13px;cursor:pointer;font-size:13px;font-weight:550;background:#f8fbf5}
.sb-bf-option:has(input:checked){background:#ddff9a;border-color:#83a959}.sb-bf-option input{accent-color:#356524}
.sb-bf-final{background:white;padding:26px;border:1px solid #dce6d8;border-radius:10px}
.sb-bf-final h2{font-size:31px;margin:0 0 10px}.sb-bf-final p{color:#586d4f;font-size:13px;line-height:1.7}
.sb-bf-final label{display:flex;align-items:start;gap:12px;color:#263527;font-size:13px;line-height:1.6;margin-top:22px}
.sb-bf-final input{margin:3px 0 0;accent-color:#5f8b3d;flex:none;width:18px;height:18px}
.sb-bf-error{min-height:20px;color:#a62826;font-size:13px;font-weight:650}
.sb-bf-actions{display:flex;justify-content:space-between;gap:10px;margin-top:24px}
.sb-bf-actions button{padding:15px 21px;font-weight:800;font-size:13px;border-radius:6px;cursor:pointer}
.sb-bf-primary{color:#172218;background:#ddff9a;border:1px solid #c2eb76;margin-left:auto}
.sb-bf-secondary{color:#364d30;background:white;border:1px solid #acbe9f}
.sb-bf-actions button:disabled{opacity:.5;cursor:wait}
.sb-bf-success{padding:42px;border:1px solid #c2daa8;background:#f5fbea;border-radius:14px}
.sb-bf-success>span{font-size:40px;color:#568e2a}.sb-bf-success h2{font-size:36px;letter-spacing:-.06em}
.sb-bf-success p{line-height:1.75;color:#4c6840}.sb-bf-success a{color:#285c22;font-weight:800}
.sb-bf-footer{display:flex;gap:15px;justify-content:space-between;padding:25px clamp(22px,5vw,75px);font-size:10px;font-weight:800;letter-spacing:.12em;border-top:1px solid #dae4d4;color:#778875}
@media(max-width:620px){.sb-bf-header{padding:19px}.sb-bf-header img{width:140px}.sb-bf-header span{font-size:8px}.sb-bf-main{margin-top:45px}.sb-bf-field{padding:18px}.sb-bf-footer span{display:none}.sb-bf-choicegrid{display:grid;grid-template-columns:1fr 1fr}.sb-bf-option{font-size:12px}.sb-bf-actions button{padding:14px}}
</style>
<script>
import {BRIEFING_SECTIONS} from '../../data/briefing-questions.js';
const params=new URLSearchParams(location.search),token=params.get('token');
const root=document.querySelector('#sb-bf-questions'),error=document.querySelector('#sb-bf-error'),loading=document.querySelector('#sb-bf-load');
const next=document.querySelector('#sb-bf-next'),back=document.querySelector('#sb-bf-back'),send=document.querySelector('#sb-bf-send'),ready=document.querySelector('#sb-bf-ready');
const el=(tag,klass,text)=>{const n=document.createElement(tag);if(klass)n.className=klass;if(text!=null)n.textContent=text;return n;};
let data=null,steps=[],step=0,answers={};
function saveStep(){
 for(const q of steps[step]||[]){
  if(q.type==='multi')answers[q.id]=[...root.querySelectorAll('input[data-question="'+q.id+'"]:checked')].map(x=>x.value);
  else if(q.type==='single')answers[q.id]=root.querySelector('input[data-question="'+q.id+'"]:checked')?.value||'';
  else answers[q.id]=root.querySelector('[data-question="'+q.id+'"]')?.value||'';
 }
}
function requiredMissing(){
 for(const q of steps[step]||[]){const v=answers[q.id];if(q.required&&(!v||(Array.isArray(v)&&!v.length)))return q.label;}
 return null;
}
function render(){
 const isFinal=step===steps.length;
 document.querySelector('#sb-bf-section').textContent=isFinal?'ÚLTIMO PASO':'PERSONALIZA TU BRIEFING';
 document.querySelector('#sb-bf-step-title').textContent=isFinal?'Revisa y envía tu briefing':steps[step]?.title||'Tu proyecto';
 document.querySelector('#sb-bf-progress-label').textContent='PASO '+(step+1)+' DE '+(steps.length+1);
 document.querySelector('#sb-bf-progress-count').textContent=Math.round((step+1)/(steps.length+1)*100)+'%';
 document.querySelector('#sb-bf-bar').style.width=(step+1)/(steps.length+1)*100+'%';
 root.replaceChildren();root.hidden=isFinal;document.querySelector('#sb-bf-final').hidden=!isFinal;
 back.hidden=step===0;next.hidden=isFinal;send.hidden=!isFinal;error.textContent='';
 if(isFinal)return;
 for(const q of steps[step]){
  const wrap=el('div','sb-bf-field');
  const heading=el('label','',q.label+(q.required?' *':''));wrap.append(heading);
  if(q.hint)wrap.append(el('small','',q.hint));
  if(q.type==='multi'||q.type==='single'){
   const choices=el('div','sb-bf-choicegrid');
   for(const option of q.options){
    const label=el('label','sb-bf-option'),input=document.createElement('input');
    input.type=q.type==='multi'?'checkbox':'radio';input.name=q.id;input.value=option;input.dataset.question=q.id;
    input.checked=q.type==='multi'?(answers[q.id]||[]).includes(option):answers[q.id]===option;
    if(q.type==='multi')input.addEventListener('change',()=>{
     const group=[...choices.querySelectorAll('input:checked')];
     if(q.max&&group.length>q.max){input.checked=false;error.textContent='Selecciona un máximo de '+q.max+' opciones.';}else error.textContent='';
    });
    label.append(input,el('span','',option));choices.append(label);
   }wrap.append(choices);
  }else{
   const input=document.createElement(q.type==='textarea'?'textarea':'input');
   if(q.type!=='textarea')input.type='text';
   input.dataset.question=q.id;input.maxLength=3000;input.value=answers[q.id]||'';
   input.autocomplete='off';input.placeholder='Escribe aquí tu respuesta…';wrap.append(input);
  }
  root.append(wrap);
 }
 window.scrollTo({top:document.querySelector('.sb-bf-progress').getBoundingClientRect().top+window.scrollY-25,behavior:'smooth'});
}
next.addEventListener('click',()=>{saveStep();const missing=requiredMissing();if(missing){error.textContent='Por favor, responde a: '+missing;return;}step++;render();});
back.addEventListener('click',()=>{if(step<steps.length)saveStep();step--;render();});
document.querySelector('#sb-bf-form').addEventListener('submit',async ev=>{
 ev.preventDefault();error.textContent='';
 if(!document.querySelector('#sb-bf-consent').checked){error.textContent='Confirma que has leído la información sobre el uso de tus respuestas.';return;}
 send.disabled=true;send.textContent='Enviando…';
 try{
  const response=await fetch('/api/briefing/'+encodeURIComponent(token),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({answers,accepted:true})});
  const result=await response.json();
  if(!response.ok||!result.ok)throw Error(result.error||'No se ha podido enviar.');
  ready.hidden=true;document.querySelector('#sb-bf-success').hidden=false;window.scrollTo({top:0,behavior:'smooth'});
 }catch(e){error.textContent=e.message;send.disabled=false;send.textContent='Enviar briefing →';}
});
async function start(){
 if(!token||!/^[a-zA-Z0-9_-]{43}$/.test(token)){loading.textContent='Este formulario se abre con el enlace individual facilitado por SouthBear Studio.';return;}
 try{
  const response=await fetch('/api/briefing/'+encodeURIComponent(token),{cache:'no-store'});
  data=await response.json();
  if(!response.ok||!data.ok)throw Error(data.error||'El formulario no está disponible.');
  document.querySelector('#sb-bf-company').textContent=data.company_name;
  document.querySelector('#sb-bf-service').textContent=data.service+' · '+data.title;
  for(const section of BRIEFING_SECTIONS){
   const relevant=data.questions.filter(q=>q.section===section.id);
   for(let i=0;i<relevant.length;i+=4){
    steps.push({title:section.title+(relevant.length>4?' · '+(Math.floor(i/4)+1):''),...{},length:undefined});
    // Keep question arrays with their visual titles.
    const last=steps.pop();const page=relevant.slice(i,i+4);page.title=last.title;steps.push(page);
   }
  }
  if(!steps.length)throw Error('Este formulario no contiene preguntas.');
  loading.hidden=true;ready.hidden=false;render();
 }catch(e){loading.textContent=e.message;}
}
start();
</script>
</html>