---
import Base from '../layouts/Base.astro';
import {projects} from '../data/projects.js';
const placeholders=Array.from({length:12},(_,i)=>{
  const project=projects[i];
  return project
    ? {...project,number:i+1,title:project.cardTitle||project.title}
    : {number:i+1,title:'Proyecto '+(i+1)};
});
---
<Base title="Proyectos" description="Proyectos y trabajos de SouthBear Studio.">
  <main class="sb-portfolio">
    <div class="sb-portfolio__inner">
      <h1>Transformamos ideas<br/>en algo que deja huella.</h1>
      <section class="sb-portfolio__grid" aria-label="Galería de proyectos">
        {placeholders.map(project=>(
          <article class="sb-portfolio__item">
            {project.slug ? (
              <a class="sb-portfolio__link" href={'/proyectos/'+project.slug+'/'} aria-label={'Ver proyecto '+project.title}>
                <div class:list={['sb-portfolio__glass',{'sb-portfolio__glass--art':Boolean(project.cardImage)}]}>
                  {project.cardImage ? (
                    <img class="sb-portfolio__artwork" src={project.cardImage} alt={project.cardImageAlt||project.title} width="2000" height="2000" loading="lazy" decoding="async" />
                  ) : (
                    <div class="sb-portfolio__shine" aria-hidden="true"></div>
                  )}
                </div>
                <h2>{project.title}</h2>
              </a>
            ) : (
              <>
                <div class="sb-portfolio__glass" aria-label={'Espacio reservado para '+project.title}>
                  <div class="sb-portfolio__shine" aria-hidden="true"></div>
                </div>
                <h2>{project.title}</h2>
              </>
            )}
          </article>
        ))}
      </section>
    </div>
  </main>
</Base>
<style>
.sb-portfolio{position:relative;min-height:100vh;background:#ffffff;color:#151b18;overflow:hidden;padding:clamp(75px,8vw,125px) 0 120px;isolation:isolate}
.sb-portfolio:before,.sb-portfolio:after{content:"";position:absolute;z-index:-1;pointer-events:none;border-radius:50%;filter:blur(95px)}
.sb-portfolio:before{width:850px;height:850px;top:8%;right:-350px;background:radial-gradient(circle,rgba(115,159,134,.13),transparent 67%)}
.sb-portfolio:after{width:750px;height:750px;bottom:12%;left:-360px;background:radial-gradient(circle,rgba(152,183,173,.12),transparent 67%)}
.sb-portfolio__inner{width:min(1820px,calc(100% - clamp(20px,3vw,56px)));margin:0 auto}
.sb-portfolio h1{font-family:'Space Grotesk Variable',system-ui,sans-serif;font-size:clamp(42px,6.5vw,96px);font-weight:600;letter-spacing:-.085em;line-height:1;text-align:left;margin:0 0 clamp(34px,4vw,60px)}
.sb-portfolio__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:clamp(12px,1.4vw,24px);row-gap:clamp(28px,3vw,44px);align-items:start}
.sb-portfolio__item{min-width:0;margin:0}
.sb-portfolio__link{display:block;color:inherit;text-decoration:none;outline-offset:5px}
.sb-portfolio__link:hover h2,.sb-portfolio__link:focus-visible h2{color:#384c39}
.sb-portfolio__link:hover .sb-portfolio__glass,.sb-portfolio__link:focus-visible .sb-portfolio__glass{transform:translateY(-4px);border-color:rgba(45,78,61,.50)}
.sb-portfolio__link:focus-visible{outline:2px solid #385f35}
.sb-portfolio__glass{position:relative;width:100%;aspect-ratio:1;overflow:hidden;border:1px solid rgba(45,78,61,.28);border-radius:0;background:linear-gradient(135deg,rgba(255,255,255,.22),rgba(255,255,255,.08) 39%,rgba(255,255,255,.11) 75%,rgba(255,255,255,.19)),radial-gradient(circle at 22% 17%,rgba(181,226,201,.22),transparent 52%),rgba(148,178,160,.24);-webkit-backdrop-filter:blur(30px) saturate(165%);backdrop-filter:blur(30px) saturate(165%);box-shadow:none;transition:border-color .24s,background-color .24s,transform .3s,box-shadow .3s}
.sb-portfolio__glass:hover{transform:translateY(-4px);border-color:rgba(45,78,61,.50);box-shadow:none}
/* Fotografías originales del portfolio: no convertimos, optimizamos ni rasterizamos. */
.sb-portfolio__glass--art{border:0;background:transparent;-webkit-backdrop-filter:none;backdrop-filter:none}
.sb-portfolio__artwork{display:block;width:100%;height:100%;object-fit:cover;object-position:center;image-rendering:auto}

.sb-portfolio__shine{position:absolute;inset:0;pointer-events:none;border-radius:0;background:linear-gradient(145deg,rgba(255,255,255,.17) 0,transparent 29%,transparent 75%,rgba(255,255,255,.055) 100%)}
.sb-portfolio__item h2{font-family:'Space Grotesk Variable',system-ui,sans-serif;font-weight:550;font-size:clamp(17px,1.8vw,27px);letter-spacing:-.045em;line-height:1.35;margin:18px 3px 0;color:#1d2922}
@media(max-width:850px){.sb-portfolio__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:530px){.sb-portfolio{padding:72px 0 75px}.sb-portfolio__inner{width:calc(100% - 20px)}.sb-portfolio h1{font-size:clamp(55px,13vw,80px);margin-bottom:34px}.sb-portfolio__grid{grid-template-columns:1fr;row-gap:28px}.sb-portfolio__item h2{font-size:21px;margin-top:13px}}
@media(prefers-reduced-motion:reduce){.sb-portfolio__glass{transition:none}}
</style>