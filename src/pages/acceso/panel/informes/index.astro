---
import Private from '../../../../layouts/Private.astro';
import '../../../../styles/private-commerce.css';
---
<Private workspace title="Informes y rentabilidad" description="Informes privados de caja registrada, costes y rentabilidad comercial orientativa de SouthBear Studio.">
<section class="sb-ops sb-reports" aria-labelledby="sb-reports-title">
  <div class="sb-ws-topline">
    <span class="sb-ws-breadcrumb"><a href="/acceso/panel/">SOUTHBEAR OS</a> <span>/</span> ESTUDIO <span>/</span> INFORMES</span>
    <span class="sb-ws-topline__session"><i aria-hidden="true"></i> ANÁLISIS PRIVADO</span>
  </div>
  <header class="sb-ops__hero">
    <div>
      <span class="sb-ops__label">SOUTHBEAR / BUSINESS INTELLIGENCE</span>
      <h1 id="sb-reports-title">TUS <em>RESULTADOS.</em></h1>
      <p>Descubre cuánto dinero ha entrado y salido, en qué se invierte y qué trabajos tienen costes asociados. Información actualizada desde los registros de SouthBear OS.</p>
    </div>
    <a class="sb-ops__primary" href="/acceso/panel/proyectos/">Ver proyectos <span aria-hidden="true">↗</span></a>
  </header>

  <div class="sb-ops__info">
    <b aria-hidden="true">✳</b>
    <span><strong>Informe de gestión, no contable ni fiscal.</strong> Los cobros y pagos son apuntes manuales, no movimientos bancarios verificados. La diferencia de proyecto compara importes con IVA incluido, sin repartir costes generales ni considerar impuestos o mano de obra propia.</span>
  </div>

  <form id="sb-reports-period" class="sb-reports__period">
    <div class="sb-reports__period-intro">
      <span>01 / PERIODO DE TESORERÍA</span>
      <strong>Entradas y salidas.</strong>
      <small>Las fechas filtran los movimientos registrados. Los indicadores de proyectos, más abajo, corresponden a toda su vida.</small>
    </div>
    <label>DESDE<input type="date" id="sb-reports-from" required/></label>
    <label>HASTA<input type="date" id="sb-reports-to" required/></label>
    <button type="submit" class="sb-ops__primary" id="sb-reports-apply">Aplicar fechas ↗</button>
    <div class="sb-reports__quick">
      <button type="button" data-range="year">Este año</button>
      <button type="button" data-range="6">Últimos 6 meses</button>
      <button type="button" data-range="12">Últimos 12 meses</button>
    </div>
  </form>

  <div class="sb-reports__kpis" aria-label="Resumen de movimientos anotados">
    <div><span>COBROS ANOTADOS</span><strong id="sb-reports-in">—</strong><small>Ingresos no anulados del periodo</small></div>
    <div><span>GASTOS PAGADOS</span><strong id="sb-reports-out">—</strong><small>Pagos no anulados del periodo</small></div>
    <div><span>SALDO DE CAJA REGISTRADO</span><strong id="sb-reports-balance">—</strong><small>Cobrado menos pagado, no beneficio</small></div>
  </div>

  <div class="sb-reports__analysis">
    <section class="sb-reports__panel" aria-labelledby="sb-reports-evolution">
      <div class="sb-reports__panel-head">
        <div><span>02 / EVOLUCIÓN</span><h2 id="sb-reports-evolution">Flujo mensual.</h2></div>
        <button class="sb-reports__export" id="sb-reports-export-month" type="button" disabled>Exportar CSV ↓</button>
      </div>
      <div class="sb-reports__legend"><span><i class="sb-reports__dot--in"></i> Cobros anotados</span><span><i class="sb-reports__dot--out"></i> Pagos de gastos</span></div>
      <div class="sb-reports__chart" id="sb-reports-timeline" aria-live="polite">
        <p>Consultando movimientos…</p>
      </div>
    </section>
    <section class="sb-reports__panel" aria-labelledby="sb-reports-category-title">
      <div class="sb-reports__panel-head"><div><span>03 / DISTRIBUCIÓN</span><h2 id="sb-reports-category-title">Dónde se paga.</h2></div></div>
      <p class="sb-reports__explain">Distribución de pagos anotados por categoría del gasto original. Los importes no equivalen a IVA deducible.</p>
      <div class="sb-reports__categories" id="sb-reports-categories" aria-live="polite"><p>Consultando categorías…</p></div>
    </section>
  </div>

  <section class="sb-reports__projects" aria-labelledby="sb-reports-project-title">
    <header class="sb-reports__projects-head">
      <div>
        <span>04 / RENTABILIDAD COMERCIAL ORIENTATIVA</span>
        <h2 id="sb-reports-project-title">Cada proyecto, bajo control.</h2>
        <p>Esta sección utiliza todos los registros vinculados a cada proyecto, <strong>independientemente del rango de fechas superior</strong>. Solo hay estimación de margen cuando el proyecto tiene un presupuesto aceptado.</p>
      </div>
      <button class="sb-reports__export" id="sb-reports-export-projects" type="button" disabled>Exportar proyectos CSV ↓</button>
    </header>
    <div class="sb-reports__filters">
      <label>BUSCAR PROYECTO O CLIENTE<input id="sb-reports-search" type="search" maxlength="120" placeholder="Proyecto, cliente o referencia…"/></label>
      <label>ESTADO<select id="sb-reports-project-status">
        <option value="">Todos los estados</option><option value="planificado">Planificado</option>
        <option value="en_curso">En curso</option><option value="en_revision">En revisión</option>
        <option value="entregado">Entregado</option><option value="cancelado">Cancelado</option>
      </select></label>
      <label>REFERENCIA<select id="sb-reports-quote-filter">
        <option value="">Todos los proyectos</option><option value="with">Con presupuesto aceptado</option>
        <option value="without">Sin presupuesto aceptado</option>
      </select></label>
    </div>
    <div class="sb-reports__project-meta"><span id="sb-reports-project-count">PROYECTOS / —</span><span id="sb-reports-loading" aria-live="polite">CARGANDO…</span></div>
    <div id="sb-reports-projects" class="sb-reports__project-list" aria-live="polite"><div class="sb-ops__empty">Consultando resultados de proyectos…</div></div>
    <p id="sb-reports-truncated" class="sb-reports__explain" hidden>Hay más de 500 proyectos. Esta vista solo muestra los 500 registros más recientes; la exportación también se limita a ellos.</p>
  </section>
  <p class="sb-ops__feedback" id="sb-reports-feedback" role="status" aria-live="polite"></p>
  <footer class="sb-ops__footer">SOUTHBEAR OS / INFORMES DE GESTIÓN · SIN CONTABILIZACIÓN FISCAL AUTOMÁTICA</footer>
</section>
<script>
import {requestApi,el,message,formatEuro,todayLocal} from '../../../../scripts/private-commerce.js';
const $=id=>document.getElementById(id);
const names={diseno:'Diseño',web:'Desarrollo web',audiovisual:'Audiovisual',otro:'Otro'};
const statuses={planificado:'Planificado',en_curso:'En curso',en_revision:'En revisión',entregado:'Entregado',cancelado:'Cancelado'};
const categories={software:'Software',materiales:'Materiales',subcontratacion:'Subcontratación',equipo:'Equipamiento',transporte:'Desplazamientos',marketing:'Marketing',alojamiento:'Hosting y dominios',otros:'Otros'};
const monthName=new Intl.DateTimeFormat('es-ES',{month:'short',year:'numeric',timeZone:'UTC'});
let report=null,shownProjects=[],requestCount=0;
const money=n=>formatEuro(Number(n)||0);
const plainMoney=c=>(Number(c||0)/100).toFixed(2);
const numericText=n=>new Intl.NumberFormat('es-ES').format(n);
function monthDisplay(month){return monthName.format(new Date(month+'-01T12:00:00Z'));}
function startingMonth(offset){
  const today=todayLocal(),year=Number(today.slice(0,4)),month=Number(today.slice(5,7));
  const date=new Date(Date.UTC(year,month-1-offset,1));
  return date.toISOString().slice(0,10);
}
function setPreset(which){
  const now=todayLocal();
  $('sb-reports-from').value=which==='year'?now.slice(0,4)+'-01-01':startingMonth(Number(which)-1);
  $('sb-reports-to').value=now;
}
function renderSummary(data){
  for(const [id,key] of [['sb-reports-in','received_cents'],['sb-reports-out','paid_cents'],['sb-reports-balance','balance_cents']]){
    const node=$(id),value=data.summary[key];
    node.textContent=money(value);
    node.classList.toggle('sb-reports__negative',value<0);
  }
}
function renderChart(data){
  const holder=$('sb-reports-timeline');holder.replaceChildren();
  const max=Math.max(1,...data.timeline.flatMap(x=>[x.received_cents,x.paid_cents]));
  for(const month of data.timeline){
    const row=el('div',undefined,'sb-reports__month');
    const title=el('strong',monthDisplay(month.month),'sb-reports__month-name');
    const bars=el('div',undefined,'sb-reports__month-bars');
    for(const [value,key] of [[month.received_cents,'in'],[month.paid_cents,'out']]){
      const outer=el('div',undefined,'sb-reports__bar-track');
      outer.setAttribute('aria-label',(key==='in'?'Cobros: ':'Pagos: ')+money(value));
      const fill=el('div',undefined,'sb-reports__bar sb-reports__bar--'+key);
      fill.style.width=Math.max(0,Math.min(100,value/max*100))+'%';
      outer.append(fill);bars.append(outer);
    }
    const amounts=el('div',undefined,'sb-reports__month-amounts');
    amounts.append(el('span',money(month.received_cents)),el('span',money(month.paid_cents)));
    row.append(title,bars,amounts);holder.append(row);
  }
  if(!data.timeline.length)holder.append(el('p','No hay meses en este periodo.'));
}
function renderCategories(data){
  const holder=$('sb-reports-categories');holder.replaceChildren();
  if(!data.categories.length){holder.append(el('p','No hay pagos de gastos en el periodo seleccionado.','sb-reports__no-data'));return;}
  const max=Math.max(1,...data.categories.map(x=>x.paid_cents));
  for(const entry of data.categories){
    const card=el('div',undefined,'sb-reports__category');
    const top=el('div',undefined,'sb-reports__category-head');
    top.append(el('span',categories[entry.category]||entry.category),el('strong',money(entry.paid_cents)));
    const track=el('div',undefined,'sb-reports__category-track');
    const bar=el('div');bar.style.width=Math.max(0,Math.min(100,entry.paid_cents/max*100))+'%';
    track.append(bar);card.append(top,track);holder.append(card);
  }
}
function projectMetric(name,cents,modifier=''){
  const box=el('div',undefined,'sb-reports__project-metric'+(modifier?' sb-reports__project-metric--'+modifier:''));
  box.append(el('span',name),el('strong',cents===null?'Sin referencia':money(cents)));
  return box;
}
function renderProjects(){
  if(!report)return;
  const query=$('sb-reports-search').value.trim().toLocaleLowerCase('es-ES');
  const status=$('sb-reports-project-status').value,ref=$('sb-reports-quote-filter').value;
  shownProjects=report.projects.filter(p=>{
    if(status&&p.status!==status)return false;
    if(ref==='with'&&p.approved_quote_cents===null)return false;
    if(ref==='without'&&p.approved_quote_cents!==null)return false;
    return !query||[p.title,p.client_name,p.quote_code].some(s=>String(s||'').toLocaleLowerCase('es-ES').includes(query));
  });
  const holder=$('sb-reports-projects');holder.replaceChildren();
  $('sb-reports-project-count').textContent='PROYECTOS / '+numericText(shownProjects.length)+(report.projects_truncated?'+':'');
  if(!shownProjects.length){
    holder.append(el('div','No hay proyectos que coincidan con los filtros.','sb-ops__empty'));return;
  }
  for(const p of shownProjects){
    const card=el('article',undefined,'sb-reports__project');
    const head=el('div',undefined,'sb-reports__project-header');
    const title=el('div',undefined,'sb-reports__project-name');
    title.append(el('span',(names[p.category]||'Otro')+' · '+(statuses[p.status]||p.status)),el('h3',p.title));
    title.append(el('p',p.client_name+(p.quote_code?' · '+p.quote_code:'')));
    head.append(title);
    const link=el('a','Ver proyecto ↗');link.href='/acceso/panel/proyectos/';head.append(link);
    const metrics=el('div',undefined,'sb-reports__project-metrics');
    metrics.append(
      projectMetric('PRESUPUESTO ACEPTADO · CON IVA',p.approved_quote_cents),
      projectMetric('COSTES REGISTRADOS · CON IVA',p.expense_cents),
      projectMetric('DIFERENCIA COMERCIAL ESTIMADA',p.estimated_margin_cents,p.estimated_margin_cents<0?'negative':'accent'),
      projectMetric('COBROS ANOTADOS',p.received_cents),
      projectMetric('PAGOS DE COSTES',p.paid_cost_cents),
      projectMetric('SALDO DE CAJA VINCULADO',p.cash_balance_cents,p.cash_balance_cents<0?'negative':'')
    );
    const foot=el('p',p.approved_quote_cents===null
      ?'Sin presupuesto aceptado vinculado: no calculamos margen para evitar inventar ingresos.'
      :p.expense_count===0?'Aún no hay costes activos vinculados. El margen no contempla mano de obra propia ni costes generales.'
      :'Importes con IVA incluido. El margen no considera costes generales, mano de obra propia ni ajustes fiscales.','sb-reports__project-note');
    card.append(head,metrics,foot);holder.append(card);
  }
}
function csvCell(value){
  if(typeof value==='number'&&Number.isFinite(value))return String(value);
  let s=String(value??'');
  if(/^[=+@\-\t\r]/.test(s))s="'"+s;
  return '"'+s.replace(/"/g,'""')+'"';
}
function exportCSV(filename,cols,rows){
  if(!report)return;
  const raw=[cols,...rows].map(row=>row.map(csvCell).join(';')).join('\r\n');
  const blob=new Blob(['\ufeff',raw],{type:'text/csv;charset=utf-8'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');a.href=url;a.download=filename;a.style.display='none';
  document.body.append(a);a.click();a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),60000);
}
$('sb-reports-export-month').addEventListener('click',()=>{
  if(!report)return;
  exportCSV('southbear-tesoreria-'+report.period.from+'-'+report.period.to+'.csv',
    ['Mes','Cobrado EUR','Pagado EUR','Saldo caja EUR'],
    report.timeline.map(x=>[x.month,plainMoney(x.received_cents),plainMoney(x.paid_cents),plainMoney(x.balance_cents)]));
});
$('sb-reports-export-projects').addEventListener('click',()=>{
  if(!report)return;
  exportCSV('southbear-proyectos-'+todayLocal()+'.csv',
    ['Proyecto','Cliente','Estado','Categoría','Presupuesto','Importe presupuesto EUR','Costes vinculados EUR','Diferencia comercial EUR','Cobros vinculados EUR','Pagos gastos EUR','Saldo de caja EUR'],
    shownProjects.map(x=>[x.title,x.client_name,statuses[x.status]||x.status,names[x.category]||x.category,
      x.quote_code||'',x.approved_quote_cents===null?'':plainMoney(x.approved_quote_cents),plainMoney(x.expense_cents),
      x.estimated_margin_cents===null?'':plainMoney(x.estimated_margin_cents),
      plainMoney(x.received_cents),plainMoney(x.paid_cost_cents),plainMoney(x.cash_balance_cents)]));
});
async function loadReport(){
  const from=$('sb-reports-from').value,to=$('sb-reports-to').value;
  if(!from||!to){message($('sb-reports-feedback'),'Selecciona las dos fechas.',true);return;}
  if(from>to){message($('sb-reports-feedback'),'La fecha inicial debe ser anterior a la final.',true);return;}
  const token=++requestCount;
  $('sb-reports-loading').textContent='CARGANDO…';
  $('sb-reports-apply').disabled=true;
  for(const id of ['sb-reports-export-month','sb-reports-export-projects'])$(id).disabled=true;
  try{
    const params=new URLSearchParams({desde:from,hasta:to});
    const result=await requestApi('/informes?'+params.toString());
    if(token!==requestCount)return;
    report=result;
    renderSummary(result);renderChart(result);renderCategories(result);renderProjects();
    $('sb-reports-truncated').hidden=!result.projects_truncated;
    $('sb-reports-loading').textContent='DATOS ACTUALIZADOS';
    for(const id of ['sb-reports-export-month','sb-reports-export-projects'])$(id).disabled=false;
    message($('sb-reports-feedback'),'Informe actualizado con los registros de la base privada.');
  }catch(error){
    if(token!==requestCount)return;
    $('sb-reports-loading').textContent='ERROR DE CONSULTA';
    message($('sb-reports-feedback'),error.message,true);
  }finally{
    if(token===requestCount)$('sb-reports-apply').disabled=false;
  }
}
$('sb-reports-period').addEventListener('submit',event=>{event.preventDefault();loadReport();});
for(const button of document.querySelectorAll('[data-range]')){
  button.addEventListener('click',()=>{setPreset(button.dataset.range);loadReport();});
}
for(const id of ['sb-reports-search','sb-reports-project-status','sb-reports-quote-filter']){
  $(id).addEventListener(id==='sb-reports-search'?'input':'change',renderProjects);
}
setPreset('year');loadReport();
</script>
</Private>