---
import Base from '../../layouts/Base.astro';
---
<Base title="Logotipos e identidad visual" description="Logotipos e identidad visual en SouthBear Studio.">
  <section class="sb-paper-hero" aria-labelledby="sb-paper-title">
    <svg class="sb-paper-hero__grain" aria-hidden="true" focusable="false" preserveAspectRatio="none">
      <filter id="sb-paper-grain-filter" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency=".7" numOctaves="3" seed="7" stitchTiles="stitch"/>
        <feColorMatrix type="saturate" values="0"/>
      </filter>
      <rect width="100%" height="100%" filter="url(#sb-paper-grain-filter)" opacity=".25"/>
    </svg>
    <h1 id="sb-paper-title" class="sb-paper-hero__title">
      <span class="sb-paper-hero__line" data-text="Logotipos">Logotipos</span>
      <span class="sb-paper-hero__line" data-text="e identidad visual">e identidad visual</span>
    </h1>
  </section>
</Base>
<style>
  .sb-paper-hero{
    --paper:#f2f0e9;
    position:relative;isolation:isolate;display:flex;align-items:center;justify-content:center;
    min-height:100vh;min-height:100svh;width:100%;overflow:hidden;
    background:radial-gradient(ellipse at 48% 34%,#f8f6f0 0%,var(--paper) 57%,#eeebe3 100%);
    color:#222;
  }
  .sb-paper-hero__grain{
    position:absolute;inset:0;width:100%;height:100%;
    pointer-events:none;mix-blend-mode:multiply;opacity:.095;
  }
  .sb-paper-hero__title{
    position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;
    margin:0;padding:0 20px;text-align:center;
    font-family:'Space Grotesk Variable',Arial,sans-serif;
    font-size:clamp(38px,6.9vw,110px);font-weight:680;line-height:1.04;letter-spacing:-.075em;
  }
  .sb-paper-hero__line{
    display:block;position:relative;white-space:nowrap;
    color:#141414;
    animation:sb-ink-fade 3.6s ease-in-out both;
  }
  .sb-paper-hero__line::after{
    content:attr(data-text);position:absolute;inset:0;white-space:nowrap;
    color:#f1efe8;
    text-shadow:
      -1px -1px 1px rgba(255,255,255,.95),
      -2px -2px 3px rgba(255,255,255,.85),
       1px 1px 1px rgba(154,149,138,.65),
       2px 2px 2px rgba(172,166,153,.58),
       4px 4px 6px rgba(184,178,164,.32);
    filter:drop-shadow(-1px -1px 0 rgba(135,128,113,.26));
    opacity:0;animation:sb-paper-imprint 3.6s ease-in-out both;
  }
  @keyframes sb-ink-fade{
    0%{color:transparent;filter:blur(9px)}
    25%{color:#141414;filter:blur(0)}
    48%{color:#141414;filter:blur(0)}
    78%,100%{color:transparent;filter:blur(0)}
  }
  @keyframes sb-paper-imprint{
    0%,47%{opacity:0}
    78%,100%{opacity:1}
  }
  @media(max-width:700px){
    .sb-paper-hero__title{font-size:clamp(28px,7vw,53px);padding-inline:12px;letter-spacing:-.075em}
    .sb-paper-hero__line::after{
      text-shadow:-1px -1px 1px rgba(255,255,255,.98),-2px -2px 2px rgba(255,255,255,.8),1px 1px 1px rgba(154,149,138,.68),2px 2px 3px rgba(172,166,153,.47);
    }
  }
  @media(prefers-reduced-motion:reduce){
    .sb-paper-hero__line{animation:none;color:transparent;filter:none}
    .sb-paper-hero__line::after{animation:none;opacity:1}
  }
</style>
