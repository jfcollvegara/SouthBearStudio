---
import '../styles/global.css';
import '../styles/kolibri-shell.css';
import {site} from '../data/site.js';
const {
  title='Estudio creativo',
  description='SOUTHBEAR STUDIO, diseño web, identidad visual y soluciones digitales.',
  landing=false
}=Astro.props;
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const route=(path='/')=>root+(path==='/'?'/':path+'/');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://southbearstudio.com').toString();
const fullTitle = title === site.name ? site.name : title + ' | ' + site.name;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://southbearstudio.com/#organization',
  name: 'SOUTHBEAR STUDIO',
  url: 'https://southbearstudio.com/',
  logo: 'https://southbearstudio.com/southbear-logo.svg',
  description: 'Estudio creativo independiente especializado en diseño web, branding, diseño gráfico y producción audiovisual.',
  areaServed: ['Murcia', 'Alicante', 'Almería'].map(name => ({'@type':'AdministrativeArea', name}))
};
const nav=[
  ['/','Inicio'],
  ['/servicios','Servicios'],
  ['/proyectos','Proyectos'],
  ['/nosotros','Estudio'],
  ['/contacto','Contacto'],
  ['/presupuesto','Presupuesto']
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#F8F8F5"/>
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl}/>
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml"/>
    <meta property="og:locale" content="es_ES"/>
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content={site.name}/>
    <meta property="og:title" content={fullTitle}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonicalUrl}/>
    <meta name="twitter:card" content="summary"/>
    <meta name="twitter:title" content={fullTitle}/>
    <meta name="twitter:description" content={description}/>
    {landing && <script type="application/ld+json" set:html={JSON.stringify(organization)} />}
  </head>
  <body class:list={[{'landing-page':landing}]}>
    <header class="site-header southbear-nav">
      <div class="container nav">
        <a class="wordmark brand-lockup" aria-label="SOUTHBEAR STUDIO — inicio" href={route()}>
          <span class="brand-logo-frame">
            <img class="brand-logo" src={root + "/southbear-logo.svg"} alt="SOUTHBEAR STUDIO"/>
          </span>
        </a>
        <nav class="sb-nav-desktop" aria-label="Navegación principal">
          {nav.slice(1).map(([url,label])=><a href={route(url)}>{label}</a>)}
        </nav>
        <details class="site-menu sb-nav-mobile">
          <summary class="menu-toggle" aria-label="Abrir menú de navegación">
            <span class="menu-toggle-lines" aria-hidden="true"><span></span><span></span></span>
          </summary>
          <nav class="menu-panel" aria-label="Menú móvil">
            {nav.map(([url,label],i)=><a href={route(url)}><span class="menu-index">0{i+1}</span>{label}<span class="menu-arrow" aria-hidden="true">↗</span></a>)}
          </nav>
        </details>
      </div>
    </header>
    <main><slot/></main>
    <footer class="sb-site-footer" aria-label="Pie de página">
      <div class="container sb-footer-top">
        <div>
          <span class="sb-footer-eyebrow"><span class="sb-footer-dot" aria-hidden="true"></span> ¿TIENES UN PROYECTO EN MENTE?</span>
          <h2>Hagamos algo<br/><span>que deje huella.</span></h2>
        </div>
        <a class="sb-footer-cta" href={route('/presupuesto')}>
          <span>Empezar un proyecto</span>
          <span class="sb-footer-cta-icon" aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="container sb-footer-main">
        <div class="sb-footer-brand">
          <a href={route('/')} aria-label="SOUTHBEAR STUDIO — ir al inicio">
            <img src={root + "/southbear-logo.svg"} alt="SOUTHBEAR STUDIO" width="340" height="64" loading="lazy"/>
          </a>
          <p>Estudio creativo independiente.<br/>Diseño web, identidad visual y soluciones digitales.</p>
        </div>
        <nav class="sb-footer-nav" aria-label="Navegación del pie de página">
          <h3>Explora</h3>
          <a href={route('/servicios')}>Servicios</a>
          <a href={route('/proyectos')}>Proyectos</a>
          <a href={route('/nosotros')}>El estudio</a>
          <a href={route('/contacto')}>Contacto</a>
        </nav>
        <div class="sb-footer-location">
          <h3>Estamos cerca</h3>
          <p>Beniel, Murcia.</p>
          <p>Murcia · Alicante · Almería</p>
          <p>Trabajamos online con toda España.</p>
        </div>
      </div>
      <div class="container sb-footer-bottom">
        <span>© {new Date().getFullYear()} SOUTHBEAR STUDIO. Todos los derechos reservados.</span>
        <a href={route('/')} aria-label="Volver al inicio">Ideas que dejan huella. <span aria-hidden="true">↗</span></a>
      </div>
    </footer>
  </body>
</html>