---
import Base from '../layouts/Base.astro';
import '../styles/home-kolibri.css';
import {catalog} from '../data/catalog.js';
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const link=(path)=>root+path;
const coverVideo=link('/southbear-film-pingpong.mp4');
const serviceLabels={
  'diseno-web':'Diseño y desarrollo web',
  'branding':'Logotipos e identidad visual',
  'diseno-grafico':'Diseño gráfico y publicidad',
  'soluciones-qr':'Cartas digitales y soluciones QR/NFC',
  'audiovisual':'Producción audiovisual'
};
const fromPrice=(service)=>Math.min(...service.packages.filter(p=>p.price!==null).map(p=>p.price));
const eur=new Intl.NumberFormat('es-ES');
---
<Base title="SOUTHBEAR STUDIO" description="SOUTHBEAR STUDIO. Diseño web, branding, diseño gráfico, soluciones QR/NFC y producción audiovisual desde Murcia." landing={true}>
  <section class="kb-wordmark" aria-label="SOUTHBEAR STUDIO">
    <video class="kb-hero-bear-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src={coverVideo} type="video/mp4"/></video>
    <div class="kb-wordmark-container">
      <img src={link('/southbear-logo.svg')} alt="SOUTHBEAR STUDIO"/>
    </div>
  </section>
  <nav class="kb-top-nav" aria-label="Navegación principal">
    <a class="kb-compact-brand" href={link('/')} aria-label="SouthBear Studio — inicio"><img src={link('/southbear-logo.svg')} alt="SouthBear Studio"/></a>
    <button class="kb-menu-toggle" type="button" aria-expanded="false" aria-controls="kb-nav-links" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>
    <div class="kb-nav-links" id="kb-nav-links">
      <a href={link('/servicios/')}>Servicios</a>
      <a href={link('/proyectos/')}>Proyectos</a>
      <a href={link('/nosotros/')}>Estudio</a>
      <a href={link('/contacto/')}>Contacto</a>
      <a href={link('/presupuesto/')}>Presupuesto</a>
    </div>
  </nav>

  <section class="kb-section kb-intro kb-intro-reveal" aria-labelledby="kb-title">
    <div class="kb-intro-layout">
      <div class="kb-intro-copy">
        <span class="kb-intro-eyebrow">ESTUDIO CREATIVO · SOUTHBEAR</span>
        <h1 id="kb-title">Dejamos huella<br/>en tus proyectos.</h1>
        <p>Transformamos tus ideas más locas en realidad. No importa lo que sueñes, no hay límites. Diseño funcional, con personalidad y carácter.</p>
        <a class="kb-intro-button" href={link('/servicios/')}>Descubre <span aria-hidden="true">↗</span></a>
      </div>
      <div class="kb-intro-visual" aria-hidden="true">
        <div class="kb-intro-image-placeholder"></div>
      </div>
    </div>
  </section>

  <section class="kb-section kb-heading" aria-labelledby="kb-work-title">
    <div class="kb-section-kicker">MUESTRAS SELECCIONADAS</div>
    <div class="kb-section-body"><h2 id="kb-work-title">Una mirada a<br/>nuestro universo.</h2></div>
  </section>

  <section class="kb-projects" aria-label="Conceptos y muestras de SOUTHBEAR STUDIO">
    <a class="kb-project kb-project-feature" href={link('/servicios/audiovisual/')}>
      <div class="kb-project-image kb-project-film">
        <video autoplay muted loop playsinline preload="metadata" aria-label="Vídeo de identidad SOUTHBEAR STUDIO">
          <source src={coverVideo} type="video/mp4"/>
        </video>
        <div class="kb-project-film-fallback"><span>SOUTHBEAR</span><small>STUDIO / MOTION</small></div>
        <div class="kb-project-image-meta">SOUTHBEAR STUDIO <span>FILM 001</span></div>
      </div>
      <div class="kb-project-caption"><div><h3>Identidad en movimiento</h3><p>Pieza propia del estudio · Audiovisual</p></div><span aria-hidden="true">↗</span></div>
    </a>
    <a class="kb-project" href={link('/servicios/branding/')}>
      <div class="kb-project-image kb-project-brand">
        <div class="kb-brand-header">EXPLORACIONES DE IDENTIDAD <span>001 / 026</span></div>
        <div class="kb-brand-art">QUE<br/>SE <em>NOTE.</em></div>
        <div class="kb-brand-bottom"><span>VISUAL<br/>IDENTITY</span><span>IDEAS CON PERSONALIDAD ✳</span></div>
      </div>
      <div class="kb-project-caption"><div><h3>Una marca con personalidad</h3><p>Concepto de muestra · Identidad visual</p></div><span aria-hidden="true">↗</span></div>
    </a>
    <a class="kb-project" href={link('/servicios/diseno-web/')}>
      <div class="kb-project-image kb-project-digital">
        <div class="kb-digital-nav"><span>S / B</span><span>WORK &nbsp;&nbsp; STUDIO &nbsp;&nbsp; CONTACT</span></div>
        <div class="kb-digital-content"><small>DESIGN THAT WORKS</small><strong>GOOD<br/>IDEAS<br/><i>LIVE</i> HERE.</strong><span>SEE WHAT'S POSSIBLE&nbsp; ↗</span></div>
      </div>
      <div class="kb-project-caption"><div><h3>Diseño que conecta</h3><p>Concepto de muestra · Diseño web</p></div><span aria-hidden="true">↗</span></div>
    </a>
    <a class="kb-project" href={link('/servicios/soluciones-qr/')}>
      <div class="kb-project-image kb-project-qr">
        <div class="kb-qr-info"><small>DEMO / DIGITAL MENU</small><strong>MENOS<br/>PAPEL.<br/><em>MÁS FÁCIL.</em></strong></div>
        <div class="kb-qr-device"><small>MENÚ DIGITAL</small><strong>La carta,<br/>a un toque.</strong><div>Para desayunar <span>↗</span></div><div>Para compartir <span>↗</span></div><div>Para brindar <span>↗</span></div></div>
      </div>
      <div class="kb-project-caption"><div><h3>Lo digital, más cerca</h3><p>Concepto de muestra · Soluciones QR/NFC</p></div><span aria-hidden="true">↗</span></div>
    </a>
  </section>
  <div class="kb-projects-note">
    <p>Las piezas señaladas como «concepto de muestra» son demostraciones gráficas creadas para ilustrar servicios; no son encargos reales de clientes.</p>
    <a class="kb-text-link" href={link('/proyectos/')}>Ver portfolio <span aria-hidden="true">↗</span></a>
  </div>

  <section class="kb-section kb-services" aria-labelledby="kb-services-title">
    <div class="kb-section-kicker">NUESTROS SERVICIOS</div>
    <div class="kb-section-body">
      <h2 id="kb-services-title">Ideas, diseño<br/>y soluciones.</h2>
      <p>Desde una pieza gráfica hasta una identidad completa. Estos son los servicios que podemos preparar para tu negocio.</p>
      <div class="kb-service-list">
        {catalog.map((service,i)=><a href={link('/servicios/'+service.slug+'/')} class="kb-service">
          <span class="kb-service-number">{String(i+1).padStart(2,'0')}</span>
          <span class="kb-service-name">{serviceLabels[service.slug]||service.title}</span>
          <span class="kb-service-price">Desde {eur.format(fromPrice(service))} €</span>
          <span class="kb-service-arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
      <div class="kb-services-under">
        <small>Todos los precios incluyen IVA.</small>
        <a class="kb-text-link" href={link('/servicios/')}>Ver todos los servicios <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="kb-end-link">
    <div class="kb-section-kicker">¿TIENES UNA IDEA?</div>
    <div class="kb-section-body"><h2>Hablemos de<br/>tu proyecto.</h2><a href={link('/presupuesto/')} class="kb-contact-link">Solicitar presupuesto <span aria-hidden="true">↗</span></a></div>
  </section>
</Base>

<style>
  /* Bloque 02 — presentación de SouthBear.
     Franja negra de menor altura; cuadrado verde sobresaliendo arriba
     y abajo y completamente enrasado con el borde derecho de la pantalla. */
  .kb-section.kb-intro{
    --kb-intro-square-size:clamp(430px,39vw,610px);
    --kb-intro-side-pad:clamp(28px,3.6vw,56px);
    --kb-intro-overlap:clamp(38px,4.5vw,70px);
    display:block;
    box-sizing:border-box;
    width:100%;
    max-width:none;
    min-height:0;
    margin:0;
    padding:var(--kb-intro-side-pad) 0;
    position:relative;
    isolation:isolate;
    overflow:hidden;
    background:transparent;
  }
  .kb-intro::before{
    content:"";
    position:absolute;
    top:calc(var(--kb-intro-side-pad) + var(--kb-intro-overlap));
    bottom:calc(var(--kb-intro-side-pad) + var(--kb-intro-overlap));
    left:0;
    right:0;
    z-index:0;
    background:#0B0B0B;
    clip-path:inset(0 0 0 0);
  }
  .kb-intro-layout{
    position:relative;
    z-index:1;
    box-sizing:border-box;
    width:100%;
    max-width:none;
    min-height:var(--kb-intro-square-size);
    margin:0;
    padding:0 0 0 clamp(20px,2.8vw,50px);
    display:grid;
    grid-template-columns:minmax(0,1fr) var(--kb-intro-square-size);
    align-items:center;
    column-gap:clamp(20px,3.1vw,56px);
  }
  .kb-intro-copy{
    position:relative;
    z-index:2;
    min-width:0;
    max-width:760px;
    margin:0;
    text-align:left;
  }
  .kb-intro-eyebrow{
    display:block;
    margin-bottom:clamp(18px,2.6vw,34px);
    color:#B6C1B3;
    font-family:var(--font-body);
    font-size:clamp(.66rem,.9vw,.78rem);
    font-weight:700;
    letter-spacing:.16em;
  }
  .kb-intro .kb-intro-copy h1{
    max-width:100%;
    margin:0;
    color:#DDFF9A;
    font-family:var(--font-heading);
    font-size:clamp(2.9rem,4.65vw,5.7rem);
    font-weight:700;
    letter-spacing:-.075em;
    line-height:1.06;
  }
  .kb-intro .kb-intro-copy p{
    max-width:600px;
    margin:clamp(20px,2.4vw,35px) 0 0;
    color:#FFFFFF;
    font-family:var(--font-body);
    font-size:clamp(.99rem,1.15vw,1.17rem);
    line-height:1.64;
    font-weight:400;
  }
  .kb-intro-button{
    display:inline-flex;
    align-items:center;
    justify-content:space-between;
    gap:clamp(34px,5vw,72px);
    margin-top:clamp(22px,2.5vw,36px);
    padding:16px 20px 16px 23px;
    background:#DDFF9A;
    color:#101010;
    font-family:var(--font-heading);
    font-size:1rem;
    font-weight:700;
    line-height:1.2;
    border:1px solid #DDFF9A;
    border-radius:0;
    text-decoration:none;
    transition:background .25s ease,color .25s ease,transform .25s ease;
  }
  .kb-intro-button:hover,
  .kb-intro-button:focus-visible{
    background:transparent;
    color:#DDFF9A;
    transform:translateY(-3px);
  }
  .kb-intro-button:focus-visible{
    outline:2px solid #DDFF9A;
    outline-offset:4px;
  }
  .kb-intro-button span{font-size:1.35rem;line-height:.8}
  .kb-intro-visual{
    position:relative;
    z-index:2;
    display:flex;
    width:100%;
    height:100%;
    align-items:center;
    justify-content:flex-end;
    min-width:0;
  }
  .kb-intro-image-placeholder{
    display:block;
    flex:0 0 auto;
    width:var(--kb-intro-square-size);
    height:var(--kb-intro-square-size);
    max-width:none;
    aspect-ratio:1 / 1;
    background:#DDFF9A;
    transform:none;
  }

  /* Se anima el fondo solo con JavaScript activo, evitando contenido
     permanentemente oculto si el navegador bloquea las animaciones. */
  .kb-intro.kb-intro-animate::before{
    clip-path:inset(0 100% 0 0);
    transition:clip-path 1.05s cubic-bezier(.22,1,.36,1);
  }
  .kb-intro.kb-intro-animate.kb-intro-visible::before{
    clip-path:inset(0 0 0 0);
  }
  .kb-intro.kb-intro-animate .kb-intro-copy{
    opacity:0;
    transform:translateY(32px);
    transition:opacity .68s ease .57s,transform .8s cubic-bezier(.22,1,.36,1) .57s;
  }
  .kb-intro.kb-intro-animate.kb-intro-visible .kb-intro-copy{
    opacity:1;
    transform:translateY(0);
  }
  .kb-intro.kb-intro-animate .kb-intro-visual{
    opacity:0;
    transform:translateX(52px);
    transition:opacity .72s ease .7s,transform .85s cubic-bezier(.22,1,.36,1) .7s;
  }
  .kb-intro.kb-intro-animate.kb-intro-visible .kb-intro-visual{
    opacity:1;
    transform:translateX(0);
  }

  @media(max-width:1150px){
    /* Algo menos de solape para dejar altura suficiente al texto. */
    .kb-section.kb-intro{--kb-intro-overlap:22px}
    .kb-intro .kb-intro-copy h1{font-size:clamp(2.55rem,4.45vw,4.45rem)}
    .kb-intro .kb-intro-copy p{font-size:1rem}
  }
  @media(max-width:790px){
    /* En pantallas pequeñas el cuadrado baja debajo del texto,
       pero sigue enrasado al borde derecho. */
    .kb-section.kb-intro{
      --kb-intro-side-pad:0px;
      --kb-intro-square-size:min(74vw,400px);
      min-height:0;
      padding:36px 0 20px;
    }
    .kb-intro::before{
      top:35px;
      bottom:clamp(95px,18vw,140px);
    }
    .kb-intro-layout{
      width:100%;
      min-height:0;
      padding:0;
      grid-template-columns:minmax(0,1fr);
      gap:36px;
    }
    .kb-intro-copy{
      padding:clamp(38px,8vw,80px) 32px 0 clamp(19px,4vw,32px);
      max-width:640px;
    }
    .kb-intro .kb-intro-copy h1{
      font-size:clamp(2.65rem,7.7vw,4.8rem);
      line-height:1.06;
    }
    .kb-intro .kb-intro-copy p{font-size:1rem;line-height:1.68}
    .kb-intro-visual{justify-content:flex-end}
    .kb-intro-image-placeholder{
      width:var(--kb-intro-square-size);
      height:var(--kb-intro-square-size);
    }
  }
  @media(max-width:420px){
    .kb-intro-copy{padding-right:20px}
    .kb-intro .kb-intro-copy h1{font-size:clamp(2.35rem,9.6vw,3rem)}
    .kb-intro-button{margin-top:28px}
  }
  @media(prefers-reduced-motion:reduce){
    .kb-intro.kb-intro-animate::before{
      clip-path:inset(0 0 0 0);
      transition:none;
    }
    .kb-intro.kb-intro-animate .kb-intro-copy,
    .kb-intro.kb-intro-animate .kb-intro-visual{
      opacity:1;
      transform:none;
      transition:none;
    }
  }
</style>

<script>
  // El menú necesita ser hermano de la sección del logo para que
  // position: sticky funcione y se mantenga visible durante el scroll.
  const logo = document.querySelector('.kb-wordmark-container');
  const nav = document.querySelector('.kb-top-nav');
  if (logo && nav) {
    const toggle = nav.querySelector('.kb-menu-toggle');
    const links = nav.querySelector('.kb-nav-links');
    function measureNav() {
      if (!links) return;
      const width = links.scrollWidth + (window.innerWidth <= 390 ? 22 : window.innerWidth <= 730 ? 28 : 50);
      nav.style.setProperty('--kb-nav-expanded-width', Math.ceil(width) + 'px');
    }
    measureNav();
    const setMenu = (open) => {
      nav.classList.toggle('kb-menu-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    };
    toggle?.addEventListener('click', () => setMenu(!nav.classList.contains('kb-menu-open')));
    document.addEventListener('click', (event) => {if (!nav.contains(event.target)) setMenu(false);});
    document.addEventListener('keydown', (event) => {if (event.key === 'Escape') {setMenu(false);toggle?.focus();}});
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let queued = false;

    function renderScroll() {
      queued = false;
      const travel = Math.max(125, logo.offsetHeight * 0.85);
      const progress = reducedMotion.matches
        ? 0
        : Math.max(0, Math.min(1, (window.scrollY - 8) / travel));
      logo.style.setProperty('--kb-logo-fade', progress.toFixed(3));
      logo.style.setProperty('--kb-logo-blur', (progress * 8).toFixed(2) + 'px');
      const compact = window.scrollY > 8;
      nav.classList.toggle('kb-top-nav--stuck', compact);
      if (!compact) setMenu(false);
    }

    function scheduleScroll() {
      if (!queued) {
        queued = true;
        window.requestAnimationFrame(renderScroll);
      }
    }

    window.addEventListener('scroll', scheduleScroll, {passive: true});
    window.addEventListener('resize', () => { measureNav(); scheduleScroll(); }, {passive: true});
    window.addEventListener('pageshow', scheduleScroll);
    reducedMotion.addEventListener('change', scheduleScroll);
    scheduleScroll();
  }

  // Entrada del bloque 02: primero se despliega el negro de izquierda a
  // derecha; después aparecen el texto y la reserva de imagen verde.
  const intro = document.querySelector('.kb-intro-reveal');
  if (intro && 'IntersectionObserver' in window &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    intro.classList.add('kb-intro-animate');
    const introObserver = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        intro.classList.add('kb-intro-visible');
        introObserver.disconnect();
      }
    }, {threshold:0.12,rootMargin:'0px 0px -6% 0px'});
    introObserver.observe(intro);
  }
</script>