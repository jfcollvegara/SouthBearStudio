---
import '../styles/global.css';
import {site} from '../data/site.js';
const {title='Estudio creativo',description='SOUTHBEAR STUDIO, diseño web, identidad visual y soluciones digitales.'}=Astro.props;
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const route=(path='/')=>root+(path==='/'?'/':path+'/');
const nav=[['/','Inicio'],['/servicios','Servicios'],['/proyectos','Proyectos'],['/nosotros','Estudio'],['/contacto','Contacto'],['/presupuesto','Presupuesto ↗']];
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#101411"/><title>{title} | {site.name}</title></head><body><header class="site-header"><div class="container nav"><a class="wordmark brand-lockup" aria-label="SOUTHBEAR STUDIO — inicio" href={route()}><img class="brand-logo" src={root + "/southbear-logo.svg"} alt="SOUTHBEAR STUDIO" width="226" height="42"/></a><nav aria-label="Navegación principal">{nav.map(([url,label])=><a href={route(url)}>{label}</a>)}</nav></div></header><main><slot/></main><footer><div class="container footer-inner"><div><img class="footer-logo" src={root + "/southbear-logo.svg"} alt="SOUTHBEAR STUDIO" width="260" height="48"/><p class="muted">{site.tagline}</p></div><p class="muted">© {new Date().getFullYear()} SOUTHBEAR STUDIO · <a href={route('/contacto')}>Contacto</a></p></div></footer></body></html>