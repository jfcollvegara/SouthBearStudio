---
import Private from '../../../../layouts/Private.astro';
import {BRIEFING_SERVICES,BRIEFING_SECTIONS,BRIEFING_QUESTIONS} from '../../../../data/briefing-questions.js';
---
<Private workspace title="Formularios creativos" description="Crea briefings personalizados para tus clientes.">
<section class="sb-form-builder">
 <div class="sb-ws-topline"><span class="sb-ws-breadcrumb"><a href="/acceso/panel/">SOUTHBEAR OS</a> <span>/</span> FORMULARIOS</span><span class="sb-ws-topline__session"><i aria-hidden="true"></i> ÁREA PROTEGIDA</span></div>
 <header class="sb-fb-heading"><div><p class="sb-fb-kicker">BRIEFINGS / CREACIÓN</p><h1>FORMULARIOS<span>.</span></h1><p>Prepara un cuestionario a medida según el servicio contratado. El cliente recibirá su enlace y no tendrá que volver a indicar el nombre de su negocio.</p></div><a href="/acceso/panel/briefings/">Ver briefings recibidos ↗</a></header>
 <div class="sb-fb-layout">
  <form id="sb-fb-create" class="sb-fb-panel">
   <div class="sb-fb-paneltitle"><span>01 / CONFIGURAR</span><h2>Nuevo formulario</h2></div>
   <label class="sb-fb-field">Empresa o profesional <b>*</b><input name="company_name" required maxlength="160" placeholder="Ej. La Panadería de Ana" autocomplete="organization"/></label>
   <label class="sb-fb-field">Servicio contratado <b>*</b><select name="service_slug" id="sb-fb-service">{BRIEFING_SERVICES.map(s=><option value={s.id}>{s.label}</option>)}</select></label>
   <label class="sb-fb-field">Título del briefing (opcional)<input name="title" maxlength="180" placeholder="Ej. Nueva identidad para La Panadería de Ana"/></label>
   <div class="sb-fb-questions">
    <div class="sb-fb-questions__top"><div><strong>Preguntas que recibirá el cliente</strong><p>Marca o desmarca las que necesites. Las tres preguntas básicas son obligatorias.</p></div><span id="sb-fb-count"></span></div>
    {BRIEFING_SECTIONS.map(section=>(
     <details class="sb-fb-group" open={section.id==='general'}>
      <summary><strong>{section.title}</strong><span>{section.subtitle}</span></summary>
      <div>{BRIEFING_QUESTIONS.filter(q=>q.section===section.id).map(q=>(
       <label class="sb-fb-question"><input type="checkbox" value={q.id} data-section={section.id} data-required={['actividad','objetivo','publico'].includes(q.id)?'1':'0'}/><span>{q.label}</span></label>
      ))}</div>
     </details>
    ))}
   </div>
   <button class="sb-fb-primary" type="submit" id="sb-fb-submit">Generar enlace privado ↗</button>
   <p class="sb-fb-status" id="sb-fb-status" aria-live="polite"></p>
   <div class="sb-fb-result" id="sb-fb-result" hidden><strong>Enlace generado</strong><p>Envíalo por correo o WhatsApp. Solo quien tenga el enlace podrá completar el cuestionario.</p><div class="sb-fb-link"><input id="sb-fb-link" readonly aria-label="Enlace para el cliente"/><button id="sb-fb-copy" type="button">Copiar</button></div></div>
  </form>
  <aside class="sb-fb-aside">
   <div class="sb-fb-aside-head"><span>02 / ENLACES EMITIDOS</span><button type="button" id="sb-fb-refresh" aria-label="Actualizar enlaces">↻ Actualizar</button></div>
   <p>Los cuestionarios pendientes se pueden volver a copiar o revocar. Cuando el cliente lo envíe, lo encontrarás en <a href="/acceso/panel/briefings/">Briefings</a>.</p>
   <div id="sb-fb-issued" class="sb-fb-issued" aria-live="polite">Consultando formularios…</div>
  </aside>
 </div>
</section>
<style>
.sb-form-builder{max-width:1560px;margin:auto;padding:32px clamp(20px,4vw,58px) 100px;color:#f6f8f1}
.sb-fb-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin:35px 0 34px}
.sb-fb-kicker,.sb-fb-paneltitle>span,.sb-fb-aside-head>span{font-size:10px;color:#ddff9a;font-weight:800;letter-spacing:.16em}
.sb-fb-heading h1{font:750 clamp(36px,5vw,72px)/1 'Space Grotesk Variable',sans-serif;letter-spacing:-.075em;margin:12px 0}
.sb-fb-heading h1 span{color:#ddff9a}.sb-fb-heading p{color:#b7c2b3;line-height:1.7;max-width:680px;font-size:14px}
.sb-fb-heading>a{padding:13px 17px;color:#ddff9a;border:1px solid #ddff9a77;text-decoration:none;font-weight:700;font-size:12px;white-space:nowrap}
.sb-fb-layout{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(280px,.7fr);gap:20px;align-items:start}
.sb-fb-panel,.sb-fb-aside{background:linear-gradient(140deg,#202520,#171b17);border:1px solid #ffffff29;box-shadow:0 20px 55px #0003;padding:clamp(20px,2.6vw,36px);border-radius:17px;min-width:0}
.sb-fb-paneltitle{margin-bottom:25px}.sb-fb-paneltitle h2{font-size:30px;letter-spacing:-.05em;margin:10px 0 0}
.sb-fb-field{display:grid;gap:9px;font-size:12px;color:#e5ecdf;font-weight:650;margin:0 0 19px}
.sb-fb-field b{color:#ddff9a}.sb-fb-field input,.sb-fb-field select{width:100%;min-width:0;background:#0d120e;border:1px solid #465344;border-radius:8px;padding:15px;color:white;font:inherit}
.sb-fb-field input:focus,.sb-fb-field select:focus{outline:2px solid #ddff9a}
.sb-fb-questions{border-top:1px solid #ffffff22;margin-top:28px}.sb-fb-questions__top{display:flex;justify-content:space-between;gap:16px;align-items:center;padding:26px 0 14px}
.sb-fb-questions__top strong{font-size:17px}.sb-fb-questions__top p{font-size:12px;color:#a3aea0;line-height:1.6;margin:8px 0 0}
#sb-fb-count{font-weight:800;color:#ddff9a;white-space:nowrap}
.sb-fb-group{border-top:1px solid #ffffff20}.sb-fb-group summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:19px 0}.sb-fb-group summary::-webkit-details-marker{display:none}
.sb-fb-group summary strong{font-size:14px}.sb-fb-group summary span{font-size:11px;color:#91a18f;text-align:right}
.sb-fb-group>div{display:grid;grid-template-columns:1fr 1fr;gap:9px;padding-bottom:20px}
.sb-fb-question{display:flex;align-items:start;gap:9px;font-size:12px;line-height:1.5;cursor:pointer;padding:10px;background:#ffffff09;border-radius:7px}
.sb-fb-question input{accent-color:#ddff9a;flex:none;width:17px;height:17px;margin:0}
.sb-fb-primary{display:block;width:100%;background:#ddff9a;border:0;border-radius:8px;color:#182416;font-weight:850;padding:18px;cursor:pointer;margin-top:24px}
.sb-fb-primary:disabled{opacity:.55;cursor:wait}
.sb-fb-status{font-size:12px;color:#ddff9a;min-height:1.2em}
.sb-fb-result{border:1px solid #ddff9a77;background:#ddff9a10;border-radius:10px;padding:19px;margin-top:15px}.sb-fb-result p{color:#c1d1b7;font-size:12px;line-height:1.55}
.sb-fb-link{display:flex;gap:5px}.sb-fb-link input{min-width:0;flex:1;background:#111a12;border:1px solid #52664b;color:white;padding:12px;font-size:12px}
.sb-fb-link button,.sb-fb-issued button{background:#ddff9a;color:#162016;border:0;border-radius:5px;padding:9px 12px;font-size:11px;font-weight:800;cursor:pointer}
.sb-fb-aside-head{display:flex;justify-content:space-between;align-items:center;gap:10px}.sb-fb-aside-head button{background:none;border:0;color:#ddff9a;cursor:pointer}
.sb-fb-aside>p{font-size:12px;color:#a6b5a0;line-height:1.7}.sb-fb-aside>p a{color:#ddff9a;text-decoration:underline}
.sb-fb-issued{display:grid;gap:10px;margin-top:22px}.sb-fb-issue{padding:17px;background:#ffffff08;border:1px solid #ffffff22;border-radius:9px}
.sb-fb-issue strong{display:block;font-size:14px;line-height:1.35}.sb-fb-issue small{display:block;color:#9baa97;line-height:1.5;margin:7px 0 14px}.sb-fb-issue>div{display:flex;gap:8px;flex-wrap:wrap}
.sb-fb-issue button:last-child{background:#2e332b;color:#fff;border:1px solid #ffffff30}
@media(max-width:950px){.sb-fb-layout{grid-template-columns:1fr}.sb-fb-heading{align-items:start;flex-direction:column}}
@media(max-width:620px){.sb-fb-group>div{grid-template-columns:1fr}.sb-fb-group summary{align-items:start;flex-direction:column;gap:5px}.sb-fb-questions__top{align-items:start;flex-direction:column}}
</style>
<script>
import {BRIEFING_SERVICES,BRIEFING_QUESTIONS,defaultBriefingQuestions} from '../../../../data/briefing-questions.js';
const form=document.querySelector('#sb-fb-create'),status=document.querySelector('#sb-fb-status'),count=document.querySelector('#sb-fb-count');
const service=document.querySelector('#sb-fb-service'),checks=[...document.querySelectorAll('.sb-fb-question input')];
const required=new Set(['actividad','objetivo','publico']),root='https://southbearstudio.com/briefing/?token=';
function selection(){return checks.filter(x=>x.checked).map(x=>x.value);}
function refreshCount(){count.textContent=selection().length+' preguntas elegidas';}
function defaults(){
 const chosen=new Set(defaultBriefingQuestions(service.value));
 checks.forEach(input=>{input.checked=chosen.has(input.value)||required.has(input.value);input.disabled=required.has(input.value);});
 refreshCount();
}
service.addEventListener('change',defaults);checks.forEach(x=>x.addEventListener('change',refreshCount));defaults();
async function api(method,payload){
 const response=await fetch('/api/southbear/briefings/',{method,credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/json','X-SouthBear-Request':'1'},body:payload?JSON.stringify(payload):undefined});
 const result=await response.json().catch(()=>({ok:false,error:'Respuesta no válida del servidor.'}));
 if(!response.ok||!result.ok)throw Error(result.error||'No se pudo conectar.');
 return result;
}
const copy=async text=>{
 try{await navigator.clipboard.writeText(text);status.textContent='Enlace copiado al portapapeles.';}catch{status.textContent='Selecciona el enlace y cópialo manualmente.';}
};
form.addEventListener('submit',async event=>{
 event.preventDefault();status.textContent='Generando enlace…';const button=document.querySelector('#sb-fb-submit');button.disabled=true;
 try{
  const d=new FormData(form);
  const result=await api('POST',{company_name:d.get('company_name'),service_slug:d.get('service_slug'),title:d.get('title'),question_ids:selection()});
  const url=root+encodeURIComponent(result.item.token);
  document.querySelector('#sb-fb-link').value=url;
  document.querySelector('#sb-fb-result').hidden=false;
  status.textContent='Formulario creado y guardado correctamente.';
  await loadIssued();
 }catch(error){status.textContent=error.message;}
 finally{button.disabled=false;}
});
document.querySelector('#sb-fb-copy').addEventListener('click',()=>copy(document.querySelector('#sb-fb-link').value));
async function loadIssued(){
 const target=document.querySelector('#sb-fb-issued');target.textContent='Cargando…';
 try{
  const result=await api('GET');
  const items=result.items.filter(x=>['pendiente','revocado'].includes(x.status)).slice(0,70);
  target.replaceChildren();
  if(!items.length){target.textContent='Todavía no has generado enlaces.';return;}
  for(const item of items){
   const box=document.createElement('article');box.className='sb-fb-issue';
   const title=document.createElement('strong');title.textContent=item.company_name;
   const info=document.createElement('small');info.textContent=item.title+' · '+(item.status==='pendiente'?'Pendiente':'Revocado');
   const buttons=document.createElement('div');
   const copyButton=document.createElement('button');copyButton.type='button';copyButton.textContent='Copiar enlace';copyButton.disabled=item.status!=='pendiente';
   copyButton.addEventListener('click',()=>copy(root+encodeURIComponent(item.token)));
   const revoke=document.createElement('button');revoke.type='button';revoke.textContent=item.status==='pendiente'?'Revocar':'Reactivar';
   revoke.addEventListener('click',async()=>{if(!confirm(item.status==='pendiente'?'¿Revocar este enlace?':'¿Reactivar este enlace?'))return;try{await api('PATCH',{id:item.id,action:item.status==='pendiente'?'revocar':'reactivar'});await loadIssued();}catch(e){status.textContent=e.message;}});
   buttons.append(copyButton,revoke);box.append(title,info,buttons);target.append(box);
  }
 }catch(error){target.textContent=error.message;}
}
document.querySelector('#sb-fb-refresh').addEventListener('click',loadIssued);loadIssued();
</script>
</Private>