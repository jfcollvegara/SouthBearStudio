---
import Base from '../layouts/Base.astro';
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const videoPath=root+'/southbear-film-pingpong.mp4';
---
<Base title="Diseño web, branding y audiovisual en Murcia, Alicante y Almería" landing={true} description="SOUTHBEAR STUDIO es un estudio creativo en Beniel (Murcia). Diseño web, branding, diseño gráfico y producción audiovisual para negocios de Murcia, Alicante y Almería.">
  <h1 class="sr-only">SOUTHBEAR STUDIO: diseño web, branding y producción audiovisual</h1>
  <section class="brand-film" aria-label="Presentación audiovisual de SOUTHBEAR STUDIO">
    <video
      class="brand-film-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-label="Vídeo de presentación de SOUTHBEAR STUDIO"
      oncanplay="this.closest('.brand-film').classList.add('brand-film--playing')"
      onerror="this.closest('.brand-film').classList.remove('brand-film--playing')"
    >
      <source src={videoPath} type="video/mp4"/>
    </video>
    <div class="brand-film-placeholder">
      <div class="brand-film-orbit" aria-hidden="true"></div>
      <div class="brand-film-content">
        <span class="brand-film-overline">SOUTHBEAR STUDIO — BRAND FILM</span>
        <p class="brand-film-headline">Diseñamos<br/><span>lo que viene.</span></p>
        <span class="brand-film-caption">Presentación de marca</span>
      </div>
      <div class="brand-film-edge" aria-hidden="true"><span>CREATIVE STUDIO</span><span>EST. 2026</span></div>
    </div>
  </section>
</Base>