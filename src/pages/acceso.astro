---
import Private from '../layouts/Private.astro';
---
<Private
  title="Acceso al área privada"
  description="Entrada reservada al espacio de gestión interna de SouthBear Studio."
>
  <div class="sb-private-access">
    <section class="sb-private-scene" aria-labelledby="sb-private-scene-title">
      <!-- Vídeo ya utilizado por la sección Producción Audiovisual;
           elemento ambiental, no contiene información funcional. -->
      <video class="sb-private-scene__video" autoplay muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
        <source src="/videos/audiovisual/5.mp4" type="video/mp4"/>
      </video>
      <div class="sb-private-scene__frame" aria-hidden="true"></div>
      <div class="sb-private-scene__top">
        <span class="sb-private-scene__label"><b>●</b> SOUTHBEAR / CREATIVE SYSTEM</span>
        <span>SCENE 01</span>
      </div>
      <div class="sb-private-scene__center">
        <div class="sb-private-scene__eyebrow">TU CENTRO DE OPERACIONES</div>
        <h1 id="sb-private-scene-title">GESTIONA<br/><span>TU ESTUDIO</span><i aria-hidden="true"></i></h1>
        <p class="sb-private-scene__description">
          Ideas, clientes, proyectos y presupuestos. Todo el trabajo de SouthBear Studio, organizado en un solo lugar.
        </p>
      </div>
      <div class="sb-private-scene__bottom" aria-hidden="true">
        <strong>00:00:00:00</strong>
        <span class="sb-private-scene__track"></span>
        <span>WORKSPACE / 001</span>
      </div>
    </section>

    <section class="sb-private-gate" aria-labelledby="sb-private-access-title">
      <div class="sb-private-gate__top">
        <span>01 / IDENTIFICACIÓN</span>
        <span>ACCESO RESERVADO</span>
      </div>
      <div class="sb-private-gate__inner">
        <div class="sb-private-gate__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4.5" y="10" width="15" height="11" rx="2"/>
            <path d="M8 10V7a4 4 0 1 1 8 0v3"/>
            <circle cx="12" cy="15.5" r="1"/>
          </svg>
        </div>
        <p class="sb-private-gate__eyebrow">SOUTHBEAR / PRIVATE</p>
        <h2 id="sb-private-access-title">Acceso<br/>privado<span>.</span></h2>
        <p class="sb-private-gate__lead">
          Este será tu punto de entrada al panel de gestión de SouthBear Studio.
        </p>
        <div class="sb-private-gate__notice" role="status">
          <span class="sb-private-gate__notice-icon" aria-hidden="true">✳</span>
          <div>
            <strong>Configuración de acceso pendiente</strong>
            <p>El panel se habilitará cuando configuremos la autenticación segura.</p>
          </div>
        </div>
        <div class="sb-private-gate__form" role="group" aria-label="Inicio de sesión todavía no disponible">
          <div class="sb-private-gate__field">
            <label for="sb-private-email">CORREO ELECTRÓNICO</label>
            <input type="email" id="sb-private-email" placeholder="Correo de administración" autocomplete="off" disabled aria-describedby="sb-private-pending"/>
          </div>
          <div class="sb-private-gate__field">
            <label for="sb-private-password">CONTRASEÑA</label>
            <input type="password" id="sb-private-password" placeholder="••••••••" autocomplete="off" disabled aria-describedby="sb-private-pending"/>
          </div>
          <button class="sb-private-gate__submit" type="button" disabled aria-describedby="sb-private-pending">
            Entrar al espacio <span aria-hidden="true">↗</span>
          </button>
          <p class="sb-private-gate__note" id="sb-private-pending">
            Por seguridad, este acceso aún no admite credenciales.
          </p>
        </div>
      </div>
      <div class="sb-private-gate__bottom">
        <span class="sb-private-gate__padlock">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
          </svg>
          PRIVATE AREA
        </span>
        <span>BUILD 001</span>
      </div>
    </section>
  </div>
</Private>