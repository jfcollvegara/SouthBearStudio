---
import Base from '../../layouts/Base.astro';
import { webPackages, webExtras, formatWebPackagePrice, formatWebExtraPrice } from '../../data/web-packages.js';
import { catalog } from '../../data/catalog.js';

// Los paquetes y extras siguen intactos en src/data/catalog.js.
// La grabación se reproduce dentro del hueco transparente de la pantalla del portátil.
const titleText = 'DISEÑO Y DESARROLLO WEB';
const letters = [...titleText];
const screenVideoSrc = '/southbear-diseno-web-demo.mp4';

// Los textos comerciales recuperan los originales del catálogo, sin duplicarlos.
const webService = catalog.find(service => service.slug === 'diseno-web');
const conditionTitles = [
  'Diseño adaptable y SEO básico',
  'Textos legales',
  'Alojamiento y dominio',
  'Blog autogestionable',
  'Entrega y garantía'
];
const webConditions = [
  ...webService.common.map((description,index)=>({
    title:conditionTitles[index],
    description
  })),
  {title:'Servicios no incluidos',description:webService.notIncluded},
  {
    title:'Cambios y revisiones',
    description:'Los cambios adicionales requieren presupuesto previo. Las revisiones no incluyen nuevos diseños completos ni trabajos fuera del alcance contratado. Se respetan siempre los derechos legales del cliente.'
  }
];
---

<Base
  title="Diseño y desarrollo web"
  description="Creamos páginas web personalizadas, profesionales y diseñadas para que tu negocio destaque. SOUTHBEAR STUDIO."
>
  <section class="sb-web-hero" aria-labelledby="sb-web-hero-title">
    <header class="sb-web-heading">
      <h1 id="sb-web-hero-title" aria-label="Diseño y desarrollo web">
        {letters.map((letter, index) => (
          <span class="sb-web-letter" aria-hidden="true" data-char={letter === ' ' ? '\u00A0' : letter} style={`--sb-letter-order:${index}`}>{letter === ' ' ? '\u00A0' : letter}</span>
        ))}
      </h1>
      <p class="sb-web-tagline">Tú lo imaginas, nosotros lo creamos.</p>
    </header>

    <div class="sb-web-visual" aria-label="Portátil de presentación de nuestros proyectos web">
      <div class="sb-web-artboard">
        <!-- El vídeo se ve a través del recorte de la pantalla del portátil. -->
        <div class="sb-web-laptop-display" aria-hidden="true">
          {screenVideoSrc && (
            <video
              class="sb-web-screen-video"
              src={screenVideoSrc}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              disablepictureinpicture
            />
          )}
        </div>
        <img
          class="sb-web-laptop-image"
          src="/southbear-diseno-web-portatil.webp"
          width="2048"
          height="1152"
          alt="Portátil sobre fondo blanco y degradado gris, preparado para mostrar nuestros proyectos de diseño web"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Paquetes web: tarjetas verticales de cristal blanco con un espacio
       superior reservado para incorporar imágenes PNG más adelante. -->
  <section class="sb-web-packages" aria-labelledby="sb-web-packages-title">
    <div class="sb-web-packages-inner">
      <header class="sb-web-packages-heading">
        <h2 id="sb-web-packages-title">Nuestros paquetes.</h2>
      </header>

      <div class="sb-web-packages-grid">
        {webPackages.map((pkg)=>(
          <a
            class="sb-web-package"
            href={'/servicios/diseno-web/'+pkg.slug+'/'}
            aria-label={pkg.name+', desde '+formatWebPackagePrice(pkg)+'. Ver el paquete'}
          >
            <div class="sb-web-package-media" aria-hidden="true">
              {pkg.image && (
                <img class="sb-web-package-image" src={pkg.image} alt="" loading="lazy" decoding="async" />
              )}
            </div>
            <div class="sb-web-package-body">
              <h3>{pkg.name}</h3>
              <p>{pkg.summary}</p>
              <span class="sb-web-package-price">Desde {formatWebPackagePrice(pkg)}</span>
            </div>
          </a>
        ))}
      </div>

      <section class="sb-web-extras" aria-labelledby="sb-web-extras-title">
        <h2 id="sb-web-extras-title">Nuestros extras.</h2>
        <div class="sb-web-extras-grid">
          {webExtras.map((extra)=>(
            <article class="sb-web-extra">
              <h3>{extra.name}</h3>
              <p class="sb-web-extra-description">{extra.detail}</p>
              <strong class="sb-web-extra-price">{formatWebExtraPrice(extra)}</strong>
              <details class="sb-web-extra-more">
                <summary>Ver detalles <span aria-hidden="true">+</span></summary>
                <p>{extra.detail}</p>
              </details>
            </article>
          ))}
        </div>
        <p class="sb-web-pricing-note">Todos los precios mostrados incluyen IVA. Los servicios «desde» y «bajo presupuesto» se concretan según el alcance de cada proyecto.</p>
      </section>

      <!-- Información útil original, ahora en desplegables de cristal. -->
      <section class="sb-web-info" aria-labelledby="sb-web-info-title">
        <div class="sb-web-info-heading">
          <h2 id="sb-web-info-title">Todo lo que necesitas saber.</h2>
          <p>Las condiciones claras desde el primer momento.</p>
        </div>
        <div class="sb-web-info-grid">
          {webConditions.map(condition=>(
            <details class="sb-web-info-item">
              <summary>
                <span>{condition.title}</span>
                <span class="sb-web-info-plus" aria-hidden="true"></span>
              </summary>
              <div class="sb-web-info-content">
                <p>{condition.description}</p>
              </div>
            </details>
          ))}
        </div>
      </section>

      <section class="sb-web-closing" aria-labelledby="sb-web-closing-title">
        <div class="sb-web-closing-content">
          <p class="sb-web-closing-kicker">HABLEMOS DE TU PROYECTO</p>
          <h2 id="sb-web-closing-title">Tu próxima gran idea <span>empieza aquí.</span></h2>
          <p>Cuéntanos qué tienes en mente y encontraremos la forma de hacerlo realidad.</p>
        </div>
        <div class="sb-web-closing-actions">
          <a class="sb-web-closing-button" href="/presupuesto/?servicio=diseno-web">Hablemos de tu proyecto <span aria-hidden="true">↗</span></a>
          <a class="sb-web-closing-back" href="/#servicios">← Volver a todos los servicios</a>
        </div>
      </section>
    </div>
  </section>
</Base>

<style>
  .sb-web-hero{
    position:relative;
    isolation:isolate;
    width:100%;
    overflow:hidden;
    background:#fff;
    color:#121712;
  }
  .sb-web-heading{
    position:relative;
    z-index:4; /* El fondo de la imagen nunca puede ocultar el eslogan. */
    padding:clamp(48px,6.5vw,105px) 18px clamp(2px,.8vw,15px);
    text-align:center;
  }
  .sb-web-heading h1{
    display:flex;
    align-items:center;
    justify-content:center;
    width:100%;
    margin:0;
    white-space:nowrap;
    font-family:var(--font-heading);
    font-size:clamp(1.45rem,3.1vw,2.85rem);
    font-weight:750;
    line-height:1.25;
    letter-spacing:-.038em;
  }
  .sb-web-tagline{
    display:table;
    max-width:calc(100% - 12px);
    margin:clamp(10px,1.5vw,18px) auto 0;
    font-family:var(--font-heading);
    font-size:clamp(.98rem,1.8vw,1.42rem);
    line-height:1.3;
    font-weight:750;
    letter-spacing:-.038em;
    color:#477625;
    background-image:linear-gradient(110deg,#386a20 0%,#78ad39 36%,#62992d 64%,#346620 100%);
    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;
    animation:sb-web-tagline-in .5s .75s both;
  }
  @keyframes sb-web-tagline-in{
    from{opacity:0;transform:translateY(9px);filter:blur(3px)}
    to{opacity:1;transform:translateY(0);filter:blur(0)}
  }
  /* Las letras base son negras de principio a fin; el brillo solo se
     dibuja en una capa superpuesta que desaparece al terminar. */
  .sb-web-letter{
    position:relative;
    display:inline-block;
    color:#000;
    -webkit-text-fill-color:#000;
    animation:sb-web-letter-entrance .28s cubic-bezier(.14,.82,.28,1) both;
    animation-delay:calc(.045s + var(--sb-letter-order) * .019s);
  }
  .sb-web-letter::after{
    content:attr(data-char);
    position:absolute;
    inset:0;
    pointer-events:none;
    color:transparent;
    -webkit-text-fill-color:transparent;
    background-image:linear-gradient(112deg,
      transparent 27%,
      rgba(179,238,121,.45) 38%,
      #fff 49%,
      rgba(198,255,142,.82) 58%,
      transparent 72%
    );
    background-size:290% 100%;
    background-position:100% 0;
    -webkit-background-clip:text;
    background-clip:text;
    opacity:0;
    animation:sb-web-letter-gloss .39s ease-out both;
    animation-delay:calc(.12s + var(--sb-letter-order) * .019s);
  }
  @keyframes sb-web-letter-entrance{
    0%{opacity:0;transform:translateY(11px) scale(1.07);filter:blur(3px)}
    65%{opacity:1;filter:drop-shadow(0 0 8px rgba(216,255,153,.7))}
    100%{opacity:1;transform:translateY(0) scale(1);filter:none}
  }
  @keyframes sb-web-letter-gloss{
    0%{opacity:0;background-position:100% 0}
    25%{opacity:1}
    72%{opacity:1}
    100%{opacity:0;background-position:0% 0}
  }

  /* La imagen original tiene transparencia real sobre y dentro del portátil.
     Fondo blanco arriba y el degradado inferior original intacto. */
  .sb-web-visual{
    position:relative;
    z-index:1;
    width:100%;
    overflow:hidden;
    /* El portátil asciende mucho más, pero queda por detrás del título. */
    margin-top:clamp(-132px,-8vw,-70px);
    background:#fff;
    animation:sb-web-visual-rise 1.02s .16s both;
  }
  .sb-web-artboard{
    position:relative;
    left:50%;
    width:max(100%,820px);
    aspect-ratio:2048 / 1152;
    transform:translateX(-50%);
  }
  .sb-web-laptop-image{
    position:relative;
    z-index:2;
    display:block;
    width:100%;
    height:auto;
    pointer-events:none;
  }
  /* Coordenadas exactas de la pantalla transparente en la imagen 2048x1152. */
  .sb-web-laptop-display{
    position:absolute;
    z-index:1;
    left:36.72%;
    top:19.98%;
    width:26.62%;
    height:29.68%;
    overflow:hidden;
    border-radius:2px;
    background:#030303;
  }
  .sb-web-screen-video{
    display:block;
    width:100%;
    height:100%;
    object-fit:contain;
    object-position:center center;
    background:#030303;
  }
  @keyframes sb-web-visual-rise{
    from{opacity:0;transform:translateY(76px);filter:blur(10px)}
    to{opacity:1;transform:translateY(0);filter:blur(0)}
  }
  /* Continuidad con el gris inferior de la imagen: su último píxel
     está en torno a #e9e9e9, por eso la transición entre ambas
     secciones arranca exactamente en ese tono. El verde se reserva
     a los reflejos de cristal de las tarjetas. */
  .sb-web-packages{
    position:relative;
    z-index:3;
    overflow:hidden;
    /* Se monta sobre el gris que queda debajo del portátil. */
    margin-top:clamp(-500px,-26vw,-225px);
    background:linear-gradient(180deg,rgba(233,233,233,0) 0%,#e9e9e9 20%,#e5e5e5 44%,#ededed 78%,#f6f6f6 100%);
    padding:clamp(30px,3vw,48px) clamp(20px,4vw,70px) clamp(95px,10vw,155px);
    color:#111;
  }
  .sb-web-packages-inner{max-width:1530px;margin:0 auto}
  .sb-web-packages-heading{margin-bottom:clamp(28px,3.5vw,47px)}
  .sb-web-packages-heading h2{
    color:#111;margin:0;
    font-family:var(--font-heading);
    font-size:clamp(1.6rem,2.65vw,2.8rem);
    font-weight:750;line-height:1.12;letter-spacing:-.065em;
  }
  .sb-web-packages-grid{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:clamp(12px,1.6vw,24px);
  }
  .sb-web-package{
    position:relative;isolation:isolate;overflow:hidden;
    display:flex;flex-direction:column;justify-content:flex-end;
    min-width:0;min-height:clamp(435px,37vw,535px);
    padding:clamp(20px,2.05vw,32px);
    border:1px solid rgba(255,255,255,.92);
    border-radius:clamp(22px,2.2vw,30px);
    background:rgba(255,255,255,.67);
    -webkit-backdrop-filter:blur(10px) saturate(135%);
    backdrop-filter:blur(10px) saturate(135%);
    box-shadow:
      inset 0 2px 0 rgba(255,255,255,.98),
      inset 0 -1px 0 rgba(255,255,255,.67),
      0 18px 54px rgba(31,37,30,.095),
      0 2px 9px rgba(31,37,30,.045);
    color:#111;text-decoration:none;
    transition:transform .4s cubic-bezier(.2,.85,.28,1),border-color .25s ease;
  }
  /* Reflejo Liquid Glass ligero: degradados suaves sin blur animado ni
     rotación de una superficie gigante, únicamente transform y opacity. */
  .sb-web-package::before{
    content:'';
    position:absolute;z-index:0;pointer-events:none;
    inset:-12%;
    border-radius:inherit;
    background:
      radial-gradient(ellipse at 24% 18%,rgba(205,255,139,.64) 0%,rgba(221,255,154,.20) 33%,transparent 64%),
      radial-gradient(ellipse at 81% 85%,rgba(113,190,50,.29) 0%,transparent 51%);
    opacity:.44;
    transform:translate3d(0,0,0);
    will-change:transform,opacity;
  }
  .sb-web-package::after{
    content:'';position:absolute;inset:1px;z-index:0;pointer-events:none;
    border:1px solid rgba(255,255,255,.69);border-radius:inherit;
    background:
      radial-gradient(ellipse at 8% 4%,rgba(255,255,255,.78),transparent 48%),
      linear-gradient(152deg,rgba(255,255,255,.35),transparent 52%,rgba(255,255,255,.18));
    box-shadow:inset 0 2px 0 rgba(255,255,255,.72);
  }
  .sb-web-package:hover,.sb-web-package:focus-visible{
    transform:translateY(-6px);
    border-color:rgba(202,243,143,.96);
    box-shadow:inset 0 2px 0 #fff,0 25px 58px rgba(33,49,29,.13),0 6px 19px rgba(33,49,29,.06);
  }
  .sb-web-package:hover::before,
  .sb-web-package:focus-visible::before{
    animation:sb-web-glass-flow .9s cubic-bezier(.18,.78,.23,1) 1 both;
  }
  @keyframes sb-web-glass-flow{
    0%{transform:translate3d(-9%,7%,0) scale(.95);opacity:.44}
    48%{transform:translate3d(6%,-4%,0) scale(1.025);opacity:.94}
    78%{transform:translate3d(3%,-2%,0) scale(1.008);opacity:.8}
    100%{transform:translate3d(3%,-2%,0) scale(1);opacity:.77}
  }
  .sb-web-package:focus-visible{outline:3px solid #658c37;outline-offset:4px}
  .sb-web-package-media{
    position:relative;z-index:1;flex:1 1 auto;min-height:180px;
    display:flex;align-items:center;justify-content:center;
    padding:0 0 14px;
  }
  .sb-web-package-image{
    display:block;width:100%;height:100%;max-height:290px;
    object-fit:contain;object-position:center;
    filter:drop-shadow(0 12px 20px rgba(20,38,23,.09));
  }
  .sb-web-package-body{position:relative;z-index:1;margin-top:auto;text-align:left}
  .sb-web-package h3{
    margin:0;color:#090b09;font-family:var(--font-heading);
    font-size:clamp(1.48rem,1.88vw,2.25rem);line-height:1.08;
    letter-spacing:-.063em;font-weight:800;
  }
  .sb-web-package p{
    margin:13px 0 26px;max-width:340px;color:#222921;
    font-size:clamp(.86rem,.95vw,1rem);line-height:1.52;
    font-weight:450;
  }
  .sb-web-package-price{
    display:inline-block;
    font-size:clamp(1.29rem,1.7vw,1.73rem);
    font-weight:850;line-height:1.18;letter-spacing:-.045em;
    color:#497723;
    background:linear-gradient(108deg,#46731e 0%,#77a93c 40%,#426e1c 74%,#669e32 100%);
    -webkit-background-clip:text;background-clip:text;
    -webkit-text-fill-color:transparent;
  }
  /* Extras: fichas horizontales compactas, cuatro columnas de escritorio. */
  .sb-web-extras{
    margin-top:clamp(85px,9vw,135px);
  }
  .sb-web-extras h2{
    margin:0 0 clamp(23px,3vw,38px);
    color:#111;
    font-family:var(--font-heading);
    font-size:clamp(1.6rem,2.65vw,2.8rem);
    font-weight:750;
    line-height:1.12;
    letter-spacing:-.065em;
  }
  .sb-web-extras-grid{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:clamp(12px,1.5vw,21px);
    align-items:stretch;
  }
  /* Liquid Glass blanco tanto en escritorio como en móvil:
     reflejo blanco esmerilado y borde iluminado sobre el fondo gris. */
  .sb-web-extra{
    position:relative;
    isolation:isolate;
    overflow:hidden;
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    min-width:0;
    min-height:164px;
    padding:clamp(19px,1.65vw,26px);
    border:1px solid rgba(255,255,255,.95);
    border-radius:19px;
    background:linear-gradient(146deg,rgba(255,255,255,.94) 0%,rgba(255,255,255,.66) 59%,rgba(255,255,255,.85) 100%);
    -webkit-backdrop-filter:blur(11px) saturate(142%);
    backdrop-filter:blur(11px) saturate(142%);
    box-shadow:
      inset 0 2px 1px rgba(255,255,255,.98),
      inset 0 -1px 0 rgba(255,255,255,.75),
      0 10px 34px rgba(29,37,26,.07);
    transition:border-color .25s ease,box-shadow .25s ease,transform .3s ease;
  }
  .sb-web-extra::before{
    content:'';
    position:absolute;
    inset:0;
    z-index:-1;
    pointer-events:none;
    border-radius:inherit;
    background:
      radial-gradient(ellipse at 6% 0%,rgba(255,255,255,.97),transparent 55%),
      linear-gradient(135deg,rgba(255,255,255,.43),transparent 58%,rgba(255,255,255,.26));
  }
  .sb-web-extra:hover{
    border-color:#fff;
    box-shadow:inset 0 2px 1px #fff,0 13px 36px rgba(29,37,26,.1);
    transform:translateY(-3px);
  }
  .sb-web-extra h3{
    margin:0;
    color:#111;
    font-family:var(--font-heading);
    font-size:clamp(1rem,1.2vw,1.17rem);
    font-weight:800;
    letter-spacing:-.035em;
    line-height:1.24;
  }
  .sb-web-extra p{
    margin:10px 0 19px;
    color:#343a33;
    font-size:.83rem;
    line-height:1.47;
  }
  .sb-web-extra-price{
    display:inline-block;
    margin-top:auto;
    color:#477425;
    font-size:clamp(1.04rem,1.3vw,1.24rem);
    font-weight:850;
    letter-spacing:-.035em;
    background:linear-gradient(108deg,#46731e 0%,#7caf3d 42%,#46731e 100%);
    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;
  }
  /* Los detalles completos se muestran directamente en PC.
     En móvil se consultan con un toque para evitar tarjetas altas. */
  .sb-web-extra-more{display:none}
  .sb-web-extra-more>summary{
    cursor:pointer;
    list-style:none;
    color:#364333;
    font-size:.72rem;
    font-weight:700;
  }
  .sb-web-extra-more>summary::-webkit-details-marker{display:none}
  .sb-web-extra-more>summary::marker{content:''}
  .sb-web-extra-more>summary:focus-visible{outline:2px solid #506f32;outline-offset:3px;border-radius:4px}
  .sb-web-extra-more>summary span{display:inline-block;margin-left:2px}
  .sb-web-extra-more[open]>summary span{transform:rotate(45deg)}
  .sb-web-extra-more p{font-size:.77rem;line-height:1.44;margin:4px 0 0;color:#333c31}

  /* Resumen de precios y alcance, tras los diez complementos. */
  .sb-web-pricing-note{
    margin:26px 0 0;
    max-width:900px;
    font-size:.84rem;
    line-height:1.65;
    color:#454c44;
  }

  /* Preguntas y condiciones recuperadas del catálogo principal. */
  .sb-web-info{margin-top:clamp(86px,10vw,155px)}
  .sb-web-info-heading{
    display:flex;
    align-items:end;
    justify-content:space-between;
    gap:25px;
    margin-bottom:clamp(26px,3vw,43px);
  }
  .sb-web-info-heading h2{
    max-width:750px;
    margin:0;
    color:#111;
    font-family:var(--font-heading);
    font-size:clamp(1.65rem,2.65vw,2.8rem);
    font-weight:750;
    line-height:1.12;
    letter-spacing:-.065em;
  }
  .sb-web-info-heading>p{
    max-width:240px;
    margin:0;
    color:#404840;
    font-size:.9rem;
    line-height:1.6;
  }
  .sb-web-info-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:clamp(11px,1.25vw,19px);
    align-items:start;
  }
  .sb-web-info-item{
    min-width:0;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.85);
    border-radius:clamp(17px,1.7vw,23px);
    background:rgba(255,255,255,.71);
    -webkit-backdrop-filter:blur(9px) saturate(135%);
    backdrop-filter:blur(9px) saturate(135%);
    box-shadow:inset 0 1px 0 #fff,0 9px 27px rgba(32,40,30,.045);
  }
  .sb-web-info-item>summary{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    min-height:83px;
    padding:23px clamp(20px,2.25vw,32px);
    cursor:pointer;
    color:#111;
    font-family:var(--font-heading);
    font-size:clamp(1rem,1.3vw,1.24rem);
    line-height:1.28;
    font-weight:750;
    letter-spacing:-.035em;
    list-style:none;
  }
