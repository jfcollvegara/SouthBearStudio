<script>
  // El menú necesita ser hermano de la sección del logo para que
  // position: sticky funcione y se mantenga visible durante el scroll.
  const logo = document.querySelector('.kb-wordmark-container');
  const nav = document.querySelector('.kb-top-nav');
  if (logo && nav) {
    const toggle = nav.querySelector('.kb-menu-toggle');
    const links = nav.querySelector('.kb-nav-links');
    function measureNav() {
      if (!links) return;
      const width = links.scrollWidth + (window.innerWidth <= 390 ? 22 : window.innerWidth <= 730 ? 28 : 50);
      nav.style.setProperty('--kb-nav-expanded-width', Math.ceil(width) + 'px');
    }
    measureNav();
    const setMenu = (open) => {
      nav.classList.toggle('kb-menu-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    };
    toggle?.addEventListener('click', () => setMenu(!nav.classList.contains('kb-menu-open')));
    document.addEventListener('click', (event) => {if (!nav.contains(event.target)) setMenu(false);});
    document.addEventListener('keydown', (event) => {if (event.key === 'Escape') {setMenu(false);toggle?.focus();}});
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let queued = false;

