---
import Base from '../layouts/Base.astro';
import {departments} from '../data/site.js';
import {projects} from '../data/projects.js';
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const route=(path)=>root+path+'/';
---
<Base title="Inicio" description="SOUTHBEAR STUDIO: estudio creativo de diseño web, identidad visual, diseño gráfico y soluciones digitales.">
<section class="sb-hero"><div class="container sb-hero-grid">
<div class="sb-hero-copy"><span class="sb-kicker"><span class="sb-status-dot"></span> ESTUDIO CREATIVO INDEPENDIENTE</span><h1>Ideas que<br/><em>dejan huella.</em></h1><p>Diseñamos marcas, webs y experiencias digitales con intención. Creatividad y tecnología al servicio de lo que quieres construir.</p><div class="sb-actions"><a class="sb-btn sb-btn-lime" href={route('/servicios')}>Explorar servicios <span aria-hidden="true">↗</span></a><a class="sb-btn sb-btn-outline" href={route('/presupuesto')}>Empezar un proyecto <span aria-hidden="true">↗</span></a></div><div class="sb-hero-foot"><span>DISEÑO WEB</span><span>IDENTIDAD VISUAL</span><span>CREATIVIDAD DIGITAL</span></div></div>
<div class="sb-hero-visual" aria-hidden="true"><div class="sb-orbit sb-orbit-1"></div><div class="sb-orbit sb-orbit-2"></div><div class="sb-visual-panel"><div class="sb-visual-top"><span class="sb-small-square"></span><span>CREATIVE SYSTEMS / 001</span><span>↗</span></div><div class="sb-visual-mark">S<span>B</span></div><div class="sb-visual-lines"><span></span><span></span><span></span></div><div class="sb-visual-caption">CREATE <span>↗</span> DIFFERENT</div></div><div class="sb-float sb-float-one">DESIGN <span>●</span> DIGITAL</div><div class="sb-float sb-float-two">BUILT WITH PURPOSE / 2026</div></div>
</div><div class="sb-hero-bottom"><div class="container"><span>SOUTHBEAR STUDIO — CREATIVE & DIGITAL</span><span>DESPLAZA PARA DESCUBRIR ↓</span></div></div></section>
<section class="sb-services section" id="servicios"><div class="container"><div class="sb-section-head"><div><div class="sb-section-label">01 / QUÉ HACEMOS</div><h2>Todo lo que tu<br/><span>marca necesita.</span></h2></div><p>De la primera idea al último detalle. Servicios creativos y digitales para dar forma a proyectos con personalidad.</p></div><div class="sb-service-grid">{departments.map((d,i)=><a class="sb-service" href={route('/servicios')+'#'+d.slug}><div class="sb-service-meta"><span>0{i+1}</span><span aria-hidden="true">↗</span></div><h3>{d.title}</h3><p>{d.description}</p><span class="sb-service-link">Explorar servicio <span aria-hidden="true">↗</span></span></a>)}</div><div class="sb-inline-link"><a href={route('/servicios')}>Ver todos los servicios y precios ↗</a></div></div></section>
<section class="sb-process section"><div class="container"><div class="sb-section-label">02 / EL PROCESO</div><div class="sb-section-head"><h2>Sin complicaciones.<br/><span>Con intención.</span></h2><p>Nos centramos en entender lo que necesitas y crear una solución sólida, clara y bien diseñada.</p></div><div class="sb-process-grid"><article><span class="sb-process-num">01</span><h3>Descubrimos</h3><p>Escuchamos tu idea y comprendemos tu negocio, tus objetivos y tus prioridades.</p></article><article><span class="sb-process-num">02</span><h3>Creamos</h3><p>Diseñamos una propuesta visual y digital que combina claridad, personalidad y funcionalidad.</p></article><article><span class="sb-process-num">03</span><h3>Lanzamos</h3><p>Revisamos los detalles y dejamos el proyecto preparado para dar el siguiente paso.</p></article></div></div></section>
<section class="sb-manifesto section"><div class="container sb-manifesto-grid"><div><div class="sb-section-label">03 / NUESTRA FILOSOFÍA</div><h2>Menos ruido.<br/><em>Más identidad.</em></h2></div><div><p>En SOUTHBEAR STUDIO creemos en el diseño que tiene algo que decir. Combinamos creatividad, criterio y visión digital para construir marcas y experiencias que se sienten propias.</p><a class="sb-text-link" href={route('/nosotros')}>Conoce el estudio ↗</a></div></div></section>
<section class="sb-projects section"><div class="container"><div class="sb-section-head"><div><div class="sb-section-label">04 / PROYECTOS</div><h2>Trabajo con<br/><span>personalidad.</span></h2></div><p>Cada proyecto es una oportunidad de encontrar la solución que mejor encaja con una marca.</p></div>{projects.length ? <div class="sb-project-grid">{projects.slice(0,3).map(p=><article class="sb-project-item"><div class="sb-project-cover">{p.image ? <img src={p.image} alt={p.title}/> : <span>SB / STUDIO</span>}</div><span class="sb-section-label">{p.type==='demo'?'CONCEPTO DE MUESTRA':'PROYECTO'} · {p.category}</span><h3>{p.title}</h3><p>{p.description}</p></article>)}</div> : <div class="sb-project-empty"><span class="sb-project-emblem" aria-hidden="true">✳</span><div><span class="sb-section-label">PORTAFOLIO EN CONSTRUCCIÓN</span><h3>Lo mejor está por venir.</h3><p>Pronto compartiremos proyectos y conceptos creativos. Mientras tanto, puedes conocer nuestros servicios.</p></div><a href={route('/servicios')} class="sb-btn sb-btn-dark">Ver servicios ↗</a></div>}</div></section>
<section class="sb-final-section"><div class="container"><div class="sb-final"><div class="sb-section-label">05 / HABLEMOS</div><h2>¿Tienes una idea?<br/><em>Hagámosla realidad.</em></h2><p>Una nueva marca, una web, un proyecto que todavía no sabes cómo empezar. Cuéntanoslo.</p><a class="sb-btn sb-btn-lime" href={route('/presupuesto')}>Solicitar presupuesto <span aria-hidden="true">↗</span></a><span class="sb-final-decoration" aria-hidden="true">SOUTHBEAR / STUDIO</span></div></div></section>
</Base>