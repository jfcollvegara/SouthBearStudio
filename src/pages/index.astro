      qrFrameRequested = false;
      const rect = qrTile.getBoundingClientRect();
      const travel = Math.max(300,Math.min(650,window.innerHeight * .78));
      const progress = qrReducedMotion.matches
        ? 1
        : serviceScrollReveal(rect,travel);
      qrCards.forEach(({delay,rise,start,end},index) => {
        const current = qrEase(qrClamp((progress - delay) / (1 - delay)));
        const hidden = 1 - current;
        const n = index + 1;
        qrTile.style.setProperty('--kb-qr-y-' + n,(-hidden * rise).toFixed(1) + 'px');
        qrTile.style.setProperty('--kb-qr-rotation-' + n,(end + (start - end) * hidden).toFixed(2) + 'deg');
        qrTile.style.setProperty('--kb-qr-opacity-' + n,(qrReducedMotion.matches ? 1 : qrClamp(current * 3)).toFixed(3));
      });
    }
    function requestQrShowcase() {
      if(qrFrameRequested)return;
      qrFrameRequested=true;
      requestAnimationFrame(renderQrShowcase);
    }
    window.addEventListener('scroll',requestQrShowcase,{passive:true});
    window.addEventListener('resize',requestQrShowcase,{passive:true});
    window.addEventListener('pageshow',requestQrShowcase);
    qrReducedMotion.addEventListener('change',requestQrShowcase);
    renderQrShowcase();
  }

</script>