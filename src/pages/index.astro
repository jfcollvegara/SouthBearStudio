---
import Base from '../layouts/Base.astro';
import '../styles/home-kolibri.css';
import {catalog} from '../data/catalog.js';
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const link=(path)=>root+path;
const coverVideo=link('/southbear-film-pingpong.mp4');
const serviceLabels={
  'diseno-web':'Diseño y desarrollo web',
  'branding':'Logotipos e identidad visual',
  'diseno-grafico':'Diseño gráfico y publicidad',
  'soluciones-qr':'Cartas digitales y soluciones QR/NFC',
  'audiovisual':'Producción audiovisual'
};
const serviceDescriptions={
  'diseno-web':'Páginas web rápidas, adaptadas a todos los dispositivos y creadas para conectar con tus clientes.',
  'branding':'Logotipos e identidades visuales con personalidad, pensados para que tu marca deje huella.',
  'diseno-grafico':'Cartelería, papelería y piezas publicitarias que comunican tus ideas con fuerza.',
  'soluciones-qr':'Cartas digitales y soluciones QR/NFC para conectar tu negocio con sus clientes.',
  'audiovisual':'Vídeos promocionales, grabación y edición para contar historias que merecen ser vistas.'
};
---
<Base title="SOUTHBEAR STUDIO" description="SOUTHBEAR STUDIO. Diseño web, branding, diseño gráfico, soluciones QR/NFC y producción audiovisual desde Murcia." landing={true}>
  <section class="kb-wordmark" aria-label="SOUTHBEAR STUDIO">
    <video class="kb-hero-bear-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true"><source src={coverVideo} type="video/mp4"/></video>
    <div class="kb-wordmark-container">
      <img src={link('/southbear-logo.svg')} alt="SOUTHBEAR STUDIO"/>
    </div>
  </section>
  <nav class="kb-top-nav" aria-label="Navegación principal">
    <a class="kb-compact-brand" href={link('/')} aria-label="SouthBear Studio — inicio"><img src={link('/southbear-logo.svg')} alt="SouthBear Studio"/></a>
    <button class="kb-menu-toggle" type="button" aria-expanded="false" aria-controls="kb-nav-links" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>
    <div class="kb-nav-links" id="kb-nav-links">
      <a href={link('/servicios/')}>Servicios</a>
      <a href={link('/proyectos/')}>Proyectos</a>
      <a href={link('/nosotros/')}>Estudio</a>
      <a href={link('/contacto/')}>Contacto</a>
      <a href={link('/presupuesto/')}>Presupuesto</a>
    </div>
  </nav>

  <section class="kb-section kb-intro kb-intro-reveal" aria-labelledby="kb-title">
    <div class="kb-intro-layout">
      <div class="kb-intro-copy">
        <h1 id="kb-title">Dejamos huella<br/>en tus proyectos.</h1>
        <p>Transformamos tus ideas más locas en realidad. No importa lo que sueñes, no hay límites. Diseño funcional, con personalidad y carácter.</p>
        <a class="kb-intro-button" href={link('/servicios/')}>Descubre</a>
      </div>
      <div class="kb-intro-visual">
        <img class="kb-intro-image" src={link("/southbear-intro-tabernas.webp")} alt="Paisaje del desierto de Tabernas al atardecer" loading="lazy" decoding="async" width="1200" height="675" />
      </div>
    </div>
  </section>

  <!-- Bloque 03: cinco categorías a sangre, sin separaciones. Animaciones de
       imágenes pendientes hasta recibir el material del estudio. -->
  <section class="kb-services-mosaic" aria-labelledby="kb-services-title">
    <h2 id="kb-services-title" class="kb-services-accessible-title">Nuestros servicios</h2>
    {catalog.map((service,i)=>(
      <a
        href={link('/servicios/'+service.slug+'/')}
        class={'kb-services-tile kb-services-tile--'+service.slug+(i===4?' kb-services-tile--wide':'')}
        aria-label={'Ver '+(serviceLabels[service.slug]||service.title)}
      >
        {service.slug === 'diseno-web' && (
          <div class="kb-web-stage" aria-hidden="true">
            <svg class="kb-web-preview kb-web-preview--pc1" viewBox="0 0 420 236" preserveAspectRatio="xMidYMid meet">
              <image href={link('/southbear-web-mockups.webp')} x="0" y="0" width="420" height="863" />
            </svg>
            <svg class="kb-web-preview kb-web-preview--pc2" viewBox="0 236 420 236" preserveAspectRatio="xMidYMid meet">
              <image href={link('/southbear-web-mockups.webp')} x="0" y="0" width="420" height="863" />
            </svg>
            <svg class="kb-web-preview kb-web-preview--mobile" viewBox="0 472 210 391" preserveAspectRatio="xMidYMid meet">
              <image href={link('/southbear-web-mockups.webp')} x="0" y="0" width="420" height="863" />
            </svg>
          </div>
        )}
        {service.slug === 'branding' && (
          <div class="kb-branding-stage" aria-hidden="true">
            <svg class="kb-branding-card kb-branding-card--1" viewBox="0 0 340 202" preserveAspectRatio="xMidYMid meet">
              <image href={link('/southbear-branding-logos.webp')} x="0" y="0" width="340" height="808" />
            </svg>
            <svg class="kb-branding-card kb-branding-card--2" viewBox="0 202 340 202" preserveAspectRatio="xMidYMid meet">
              <image href={link('/southbear-branding-logos.webp')} x="0" y="0" width="340" height="808" />
            </svg>
            <svg class="kb-branding-card kb-branding-card--3" viewBox="0 404 340 202" preserveAspectRatio="xMidYMid meet">
              <image href={link('/southbear-branding-logos.webp')} x="0" y="0" width="340" height="808" />
            </svg>
            <svg class="kb-branding-card kb-branding-card--4" viewBox="0 606 340 202" preserveAspectRatio="xMidYMid meet">
              <image href={link('/southbear-branding-logos.webp')} x="0" y="0" width="340" height="808" />
            </svg>
          </div>
        )}
        {service.slug === 'soluciones-qr' && (
          <div class="kb-qr-stage" aria-hidden="true">
            <img class="kb-qr-object kb-qr-object--stand" src={link('/southbear-qr-stand.webp')} alt="" width="530" height="697" loading="lazy" decoding="async" />
            <img class="kb-qr-object kb-qr-object--code" src={link('/southbear-qr-code.png')} alt="" width="480" height="480" loading="lazy" decoding="async" />
          </div>
        )}
        {service.slug === 'audiovisual' && (
          <div class="kb-services-audiovisual-frame" aria-hidden="true">
            <video class="kb-services-bear-video" autoplay muted loop playsinline preload="metadata">
              <source src={coverVideo} type="video/mp4" />
            </video>
          </div>
        )}
        <div class="kb-services-tile-content">
          <h3>{serviceLabels[service.slug]||service.title}</h3>
          <p>{serviceDescriptions[service.slug]||service.intro}</p>
        </div>
      </a>
    ))}
  </section>

  <section class="kb-section kb-heading" aria-labelledby="kb-work-title">
    <div class="kb-section-kicker">MUESTRAS SELECCIONADAS</div>
    <div class="kb-section-body"><h2 id="kb-work-title">Una mirada a<br/>nuestro universo.</h2></div>
  </section>

  <section class="kb-projects" aria-label="Conceptos y muestras de SOUTHBEAR STUDIO">
    <a class="kb-project kb-project-feature" href={link('/servicios/audiovisual/')}>
      <div class="kb-project-image kb-project-film">
        <video autoplay muted loop playsinline preload="metadata" aria-label="Vídeo de identidad SOUTHBEAR STUDIO">
          <source src={coverVideo} type="video/mp4"/>
        </video>
        <div class="kb-project-film-fallback"><span>SOUTHBEAR</span><small>STUDIO / MOTION</small></div>
        <div class="kb-project-image-meta">SOUTHBEAR STUDIO <span>FILM 001</span></div>
      </div>
      <div class="kb-project-caption"><div><h3>Identidad en movimiento</h3><p>Pieza propia del estudio · Audiovisual</p></div><span aria-hidden="true">↗</span></div>
    </a>
    <a class="kb-project" href={link('/servicios/branding/')}>
      <div class="kb-project-image kb-project-brand">
        <div class="kb-brand-header">EXPLORACIONES DE IDENTIDAD <span>001 / 026</span></div>
        <div class="kb-brand-art">QUE<br/>SE <em>NOTE.</em></div>
        <div class="kb-brand-bottom"><span>VISUAL<br/>IDENTITY</span><span>IDEAS CON PERSONALIDAD ✳</span></div>
      </div>
      <div class="kb-project-caption"><div><h3>Una marca con personalidad</h3><p>Concepto de muestra · Identidad visual</p></div><span aria-hidden="true">↗</span></div>
    </a>
    <a class="kb-project" href={link('/servicios/diseno-web/')}>
      <div class="kb-project-image kb-project-digital">
        <div class="kb-digital-nav"><span>S / B</span><span>WORK &nbsp;&nbsp; STUDIO &nbsp;&nbsp; CONTACT</span></div>
        <div class="kb-digital-content"><small>DESIGN THAT WORKS</small><strong>GOOD<br/>IDEAS<br/><i>LIVE</i> HERE.</strong><span>SEE WHAT'S POSSIBLE&nbsp; ↗</span></div>
      </div>
      <div class="kb-project-caption"><div><h3>Diseño que conecta</h3><p>Concepto de muestra · Diseño web</p></div><span aria-hidden="true">↗</span></div>
    </a>
    <a class="kb-project" href={link('/servicios/soluciones-qr/')}>
      <div class="kb-project-image kb-project-qr">
        <div class="kb-qr-info"><small>DEMO / DIGITAL MENU</small><strong>MENOS<br/>PAPEL.<br/><em>MÁS FÁCIL.</em></strong></div>
        <div class="kb-qr-device"><small>MENÚ DIGITAL</small><strong>La carta,<br/>a un toque.</strong><div>Para desayunar <span>↗</span></div><div>Para compartir <span>↗</span></div><div>Para brindar <span>↗</span></div></div>
      </div>
      <div class="kb-project-caption"><div><h3>Lo digital, más cerca</h3><p>Concepto de muestra · Soluciones QR/NFC</p></div><span aria-hidden="true">↗</span></div>
    </a>
  </section>
  <div class="kb-projects-note">
    <p>Las piezas señaladas como «concepto de muestra» son demostraciones gráficas creadas para ilustrar servicios; no son encargos reales de clientes.</p>
    <a class="kb-text-link" href={link('/proyectos/')}>Ver portfolio <span aria-hidden="true">↗</span></a>
  </div>

  <section class="kb-end-link">
    <div class="kb-section-kicker">¿TIENES UNA IDEA?</div>
    <div class="kb-section-body"><h2>Hablemos de<br/>tu proyecto.</h2><a href={link('/presupuesto/')} class="kb-contact-link">Solicitar presupuesto <span aria-hidden="true">↗</span></a></div>
  </section>
</Base>

<style>
  /* Bloque 03 — cinco servicios en mosaico 2 + 2 + 1.
     Las superficies van pegadas entre sí y llegan a ambos bordes de pantalla.
     No se añade ninguna animación asociada al desplazamiento por ahora. */
  .kb-services-mosaic{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:0;
    width:100%;
    max-width:none;
    margin:0 0 clamp(95px,11vw,170px);
    padding:0;
    overflow:hidden;
  }
  .kb-services-accessible-title{
    position:absolute;
    width:1px;
    height:1px;
    padding:0;
    margin:-1px;
    overflow:hidden;
    clip:rect(0,0,0,0);
    white-space:nowrap;
    border:0;
  }
  .kb-services-tile{
    --kb-tile-text:#15201A;
    position:relative;
    isolation:isolate;
    display:flex;
    box-sizing:border-box;
    flex-direction:column;
    justify-content:flex-end;
    align-items:flex-start;
    width:100%;
    min-width:0;
    min-height:360px;
    aspect-ratio:1 / 1;
    margin:0;
    padding:clamp(30px,4vw,72px);
    border:0;
    border-radius:0;
    overflow:hidden;
    color:var(--kb-tile-text);
    background-color:#DDFF9A;
    background-image:radial-gradient(circle at 15% 9%,rgba(255,255,255,.34),transparent 49%),radial-gradient(circle at 90% 80%,rgba(24,28,25,.10),transparent 52%);
    text-decoration:none;
    outline-offset:-5px;
    transition:filter .32s ease;
  }
  .kb-services-tile--diseno-web{background-color:#DDFF9A}
  /* Primer servicio: tres capturas reales a distintas profundidades.
     Con el scroll caen desde arriba y quedan antes del título. */
  .kb-services-tile--diseno-web .kb-services-tile-content{
    z-index:3;
  }
  .kb-web-stage{
    position:absolute;
    inset:0;
    z-index:1;
    pointer-events:none;
    perspective:1100px;
  }
  .kb-web-preview{
    position:absolute;
    display:block;
    height:auto;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.75);
    border-radius:clamp(10px,1.65vw,22px);
    background:#111;
    -webkit-backface-visibility:hidden;
    backface-visibility:hidden;
    transform-style:preserve-3d;
    transform-origin:50% 45%;
    box-shadow:0 20px 45px rgba(13,35,28,.24),0 5px 14px rgba(13,35,28,.14),inset 0 1px 0 rgba(255,255,255,.4);
    will-change:transform,opacity;
  }
  .kb-web-preview--pc1{
    width:53%;
    aspect-ratio:420 / 236;
    top:11%;
    left:7%;
    z-index:1;
    opacity:var(--kb-web-opacity-1,1);
    transform:perspective(1100px) translate3d(0,var(--kb-web-y-1,0px),0) rotateX(8deg) rotateY(-12deg) rotateZ(var(--kb-web-rotation-1,-7deg));
  }
  .kb-web-preview--pc2{
    width:47%;
    aspect-ratio:420 / 236;
    top:26%;
    right:7%;
    z-index:2;
    opacity:var(--kb-web-opacity-2,1);
    transform:perspective(1100px) translate3d(0,var(--kb-web-y-2,0px),28px) rotateX(5deg) rotateY(9deg) rotateZ(var(--kb-web-rotation-2,9deg));
  }
  .kb-web-preview--mobile{
    width:19%;
    aspect-ratio:210 / 391;
    top:19%;
    left:43%;
    z-index:3;
    opacity:var(--kb-web-opacity-3,1);
    transform:perspective(1100px) translate3d(0,var(--kb-web-y-3,0px),65px) rotateX(5deg) rotateY(-8deg) rotateZ(var(--kb-web-rotation-3,-5deg));
  }
  @media(max-width:680px){
    .kb-web-preview--pc1{width:44%;top:9%;left:6%}
    .kb-web-preview--pc2{width:42%;top:19%;right:7%}
    .kb-web-preview--mobile{width:17%;top:12%;left:45%}
  }
  @media(prefers-reduced-motion:reduce){
    .kb-web-preview{will-change:auto;opacity:1}
    .kb-web-preview--pc1{transform:rotateZ(-7deg)}
    .kb-web-preview--pc2{transform:rotateZ(9deg)}
    .kb-web-preview--mobile{transform:rotateZ(-5deg)}
  }
  .kb-services-tile--branding{background-color:#C3B4EF}
  /* Logotipos: composición editorial de cuatro ejemplos sobre cristal.
     Un sprite optimizado conserva las cuatro imágenes del cliente. */
  .kb-services-tile--branding .kb-services-tile-content{
    position:relative;
    z-index:3;
  }
  .kb-branding-stage{
    position:absolute;
    inset:0;
    z-index:2;
    pointer-events:none;
    perspective:1100px;
  }
  .kb-branding-card{
    position:absolute;
    display:block;
    height:auto;
    aspect-ratio:340 / 202;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.62);
    border-radius:clamp(12px,1.5vw,21px);
    background:rgba(255,255,255,.43);
    -webkit-backdrop-filter:blur(12px) saturate(145%);
    backdrop-filter:blur(12px) saturate(145%);
    box-shadow:0 13px 29px rgba(35,27,70,.14),inset 0 1px 0 rgba(255,255,255,.55);
    -webkit-backface-visibility:hidden;
    backface-visibility:hidden;
    transform-style:preserve-3d;
    transform-origin:center;
    will-change:transform,opacity;
  }
  .kb-branding-card--1{
    width:37%;top:15%;left:8%;z-index:1;
    opacity:var(--kb-brand-opacity-1,1);
    transform:perspective(1100px) translate3d(0,var(--kb-brand-y-1,0px),0) rotateX(4deg) rotateY(-5deg) rotateZ(var(--kb-brand-rotation-1,-3deg));
  }
  .kb-branding-card--2{
    width:34%;top:20%;right:9%;z-index:2;
    background:rgba(25,23,45,.88);
    border-color:rgba(255,255,255,.32);
    opacity:var(--kb-brand-opacity-2,1);
    transform:perspective(1100px) translate3d(0,var(--kb-brand-y-2,0px),18px) rotateX(4deg) rotateY(5deg) rotateZ(var(--kb-brand-rotation-2,3deg));
  }
  .kb-branding-card--3{
    width:29%;top:37%;left:16%;z-index:3;
    opacity:var(--kb-brand-opacity-3,1);
    transform:perspective(1100px) translate3d(0,var(--kb-brand-y-3,0px),28px) rotateX(3deg) rotateY(-5deg) rotateZ(var(--kb-brand-rotation-3,-2deg));
  }
  .kb-branding-card--4{
    width:28%;top:40%;right:14%;z-index:4;
    opacity:var(--kb-brand-opacity-4,1);
    transform:perspective(1100px) translate3d(0,var(--kb-brand-y-4,0px),39px) rotateX(3deg) rotateY(5deg) rotateZ(var(--kb-brand-rotation-4,2deg));
  }
  @media(max-width:980px){
    .kb-branding-card--1{width:36%;top:11%;left:7%}
    .kb-branding-card--2{width:33%;top:14%;right:7%}
    .kb-branding-card--3{width:27%;top:26%;left:15%}
    .kb-branding-card--4{width:26%;top:28%;right:13%}
  }
  @media(max-width:680px){
    /* Dos filas separadas y más espacio vertical: ninguna tarjeta tapa otra
       ni invade el titular en pantallas pequeñas. El escritorio no cambia. */
    .kb-services-tile.kb-services-tile--branding{
      aspect-ratio:auto;
      min-height:clamp(500px,132vw,580px);
    }
    .kb-branding-card{border-radius:13px}
    .kb-branding-card--1{width:33%;top:8%;left:10%}
    .kb-branding-card--2{width:31%;top:11%;right:10%}
    .kb-branding-card--3{width:27%;top:27%;left:15%}
    .kb-branding-card--4{width:27%;top:30%;right:13%}
  }
  @media(prefers-reduced-motion:reduce){
    .kb-branding-card{will-change:auto;opacity:1}
    .kb-branding-card--1{transform:rotateZ(-3deg)}
    .kb-branding-card--2{transform:rotateZ(3deg)}
    .kb-branding-card--3{transform:rotateZ(-2deg)}
    .kb-branding-card--4{transform:rotateZ(2deg)}
  }
  .kb-services-tile--diseno-grafico{background-color:#EFB3A0}
  .kb-services-tile--soluciones-qr{background-color:#96D4D9}
  /* QR/NFC: expositor real y código QR en dos planos, revelados mediante scroll. */
  .kb-qr-stage{
    position:absolute;
    inset:0;
    z-index:1;
    pointer-events:none;
    perspective:1100px;
  }
  .kb-services-tile--soluciones-qr .kb-services-tile-content{z-index:3}
  .kb-qr-object{
    position:absolute;
    display:block;
    height:auto;
    will-change:transform,opacity;
    backface-visibility:hidden;
    transform-style:preserve-3d;
  }
  .kb-qr-object--stand{
    width:43%;
    top:5%;
    left:11%;
    z-index:1;
    object-fit:contain;
    opacity:var(--kb-qr-opacity-1,1);
    filter:drop-shadow(0 16px 22px rgba(11,49,54,.22));
    transform:perspective(1100px) translate3d(0,var(--kb-qr-y-1,0px),18px) rotateX(6deg) rotateY(-9deg) rotateZ(var(--kb-qr-rotation-1,-5deg));
  }
  .kb-qr-object--code{
    box-sizing:border-box;
    width:28%;
    aspect-ratio:1;
    top:21%;
    right:10%;
    z-index:2;
    padding:clamp(7px,1vw,14px);
    border:1px solid rgba(255,255,255,.78);
    border-radius:clamp(12px,1.5vw,23px);
    background:#fff;
    object-fit:contain;
    box-shadow:0 16px 35px rgba(11,49,54,.18),0 4px 11px rgba(11,49,54,.1);
    opacity:var(--kb-qr-opacity-2,1);
    transform:perspective(1100px) translate3d(0,var(--kb-qr-y-2,0px),55px) rotateX(5deg) rotateY(8deg) rotateZ(var(--kb-qr-rotation-2,6deg));
  }
  @media(max-width:980px){
    .kb-qr-object--stand{width:38%;top:5%;left:11%}
    .kb-qr-object--code{width:26%;top:19%;right:10%}
  }
  @media(max-width:680px){
    .kb-qr-object--stand{width:35%;top:4%;left:12%}
    .kb-qr-object--code{width:27%;top:15%;right:11%;padding:6px;border-radius:12px}
  }
  @media(prefers-reduced-motion:reduce){
    .kb-qr-object{will-change:auto;opacity:1}
    .kb-qr-object--stand{transform:rotateZ(-5deg)}
    .kb-qr-object--code{transform:rotateZ(6deg)}
  }
  /* Audiovisual: el vídeo llena el interior redondeado, con el Liquid Glass
     restringido a un fino anillo perimetral para no desenfocar la imagen. */
  .kb-services-tile--audiovisual{
    --kb-tile-text:#FFFFFF;
    --kb-av-frame-inset:clamp(14px,2vw,30px);
    --kb-av-frame-radius:clamp(20px,2.2vw,36px);
    background-color:#131b19;
  }
  .kb-services-audiovisual-frame{
    position:absolute;
    inset:var(--kb-av-frame-inset);
    z-index:1;
    display:block;
    overflow:hidden;
    border-radius:var(--kb-av-frame-radius);
    background:#111917;
    box-shadow:0 15px 40px rgba(0,0,0,.16);
    pointer-events:none;
  }
  .kb-services-bear-video{
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
  }
  /* La máscara vacía el centro del cristal: brillo y blur solo en el borde. */
  .kb-services-tile.kb-services-tile--audiovisual::before{
    box-sizing:border-box;
    z-index:3;
    inset:var(--kb-av-frame-inset);
    padding:clamp(9px,.95vw,16px);
    border:1px solid rgba(255,255,255,.58);
    border-radius:var(--kb-av-frame-radius);
    background:linear-gradient(142deg,rgba(255,255,255,.42),rgba(255,255,255,.09) 50%,rgba(255,255,255,.28));
    -webkit-backdrop-filter:blur(12px) saturate(155%);
    backdrop-filter:blur(12px) saturate(155%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.62),inset 0 -1px 0 rgba(255,255,255,.16);
    -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
    -webkit-mask-composite:xor;
    mask-composite:exclude;
  }
