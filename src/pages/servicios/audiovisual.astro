---
import Base from '../../layouts/Base.astro';

// Los cuatro paquetes, sus extras y condiciones siguen en src/data/catalog.js.
const headline = 'PRODUCCIÓN AUDIOVISUAL';
const showcase = [
  { shade:'#313131', grow:0.88, mobileWidth:'52vw' },
  { shade:'#545454', grow:1.08, mobileWidth:'63vw' },
  { shade:'#242424', grow:1.28, mobileWidth:'70vw' },
  { shade:'#414141', grow:1, mobileWidth:'57vw' }
];
---
<Base
  title="Producción audiovisual"
  description="Producción audiovisual a medida en SOUTHBEAR STUDIO. Vídeos, rodajes y edición profesional."
>
  <section class="sb-av-hero" aria-labelledby="sb-av-title">
    <div class="sb-av-hero__inner">
      <h1 class="sb-av-hero__title" id="sb-av-title" aria-label={headline}>
        {Array.from(headline).map(letter=>(
          <span class:list={['sb-av-hero__character', {'sb-av-hero__space':letter===' '}]} aria-hidden="true">{letter===' ' ? '\u00A0' : letter}</span>
        ))}
      </h1>
      <p class="sb-av-hero__tagline">La creatividad cobra vida en cada fotograma.</p>
    </div>

    <!-- Cuatro espacios 16:9 provisionales para los futuros vídeos.
         Varía su anchura y, con ella, la altura manteniendo el formato. -->
    <div class="sb-av-showcase" aria-hidden="true">
      {showcase.map((frame, index)=>(
        <div
          class="sb-av-showcase__frame"
          style={`--frame-grow:${frame.grow};--frame-mobile-width:${frame.mobileWidth};--frame-index:${index};--frame-color:${frame.shade}`}
        ></div>
      ))}
    </div>
  </section>
</Base>
<style>
  .sb-av-hero{
    position:relative;
    isolation:isolate;
    width:100%;
    min-height:calc(100svh - 83px);
    overflow:hidden;
    display:flex;
    flex-direction:column;
    padding:clamp(69px,7.7vw,148px) clamp(18px,4vw,92px) clamp(40px,5vw,76px);
    background:#0A0A0A;
    color:#fff;
  }
  .sb-av-hero__inner{
    position:relative;
    width:100%;
    margin-inline:auto;
  }
  /* Titular de una sola línea, distribuido entre márgenes de seguridad. */
  .sb-av-hero__title{
    position:relative;
    z-index:1;
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    width:100%;
    max-width:100%;
    margin:0;
    /* El barrido se recorta exactamente al área del título, sin alcanzar el subtítulo. */
    overflow:hidden;
    /* Reserva sitio para el indicador REC dentro del margen de seguridad. */
    padding:0 clamp(10px,1.65vw,29px) 0 0;
    white-space:nowrap;
    color:#FAFAFA;
    font-family:var(--font-heading);
    font-size:clamp(1rem,5vw,7.5rem);
    font-weight:750;
    line-height:1.05;
    letter-spacing:-.045em;
    text-transform:uppercase;
    opacity:0;
    transform:translate3d(0,14px,0) scale(.991);
    filter:blur(7px);
    animation:sb-av-hero-focus 1.4s cubic-bezier(.18,.8,.2,1) .12s both;
  }
  /* Rectángulo glossy con extremos degradados: cruza el titular,
     y en hover usa modo diferencia para invertir el texto como un negativo. */
  .sb-av-hero__title::before{
    content:'';
    position:absolute;
    z-index:3;
    pointer-events:none;
    top:0;
    bottom:0;
    left:-36%;
    width:33%;
    border-radius:4px;
    background:linear-gradient(90deg,
      transparent 0%,
      rgba(255,255,255,.13) 15%,
      rgba(255,255,255,.93) 43%,
      #fff 50%,
      rgba(255,255,255,.8) 59%,
      rgba(255,255,255,.13) 85%,
      transparent 100%);
    mix-blend-mode:difference;
    opacity:0;
    transform:translate3d(0,0,0);
    animation:sb-av-gloss-intro 1.55s cubic-bezier(.45,0,.55,1) 1.5s 1 both;
  }
  .sb-av-hero__title:hover::before{
    animation:sb-av-gloss-hover 1.55s cubic-bezier(.45,0,.55,1) 0s 1 both;
  }
  @keyframes sb-av-gloss-intro{
    0%{opacity:0;transform:translate3d(0,0,0)}
    12%{opacity:1}
    84%{opacity:1}
    100%{opacity:0;transform:translate3d(430%,0,0)}
  }
  @keyframes sb-av-gloss-hover{
    0%{opacity:0;transform:translate3d(0,0,0)}
    12%{opacity:1}
    84%{opacity:1}
    100%{opacity:0;transform:translate3d(430%,0,0)}
  }
  .sb-av-hero__character{
    display:block;
    flex:0 0 auto;
    min-width:0;
    color:inherit;
    -webkit-text-fill-color:currentColor;
  }
  .sb-av-hero__space{
    flex:0 0 clamp(9px,1.55vw,29px);
    width:clamp(9px,1.55vw,29px);
    font-size:0;
  }
  /* Punto rojo REC unido a la última letra, alineado con la base del texto. */
  .sb-av-hero__character:last-child{position:relative}
  .sb-av-hero__character:last-child::after{
    content:'';
    position:absolute;
    left:calc(100% + .07em);
    bottom:.1em;
    width:.23em;
    height:.23em;
    border-radius:50%;
    background:#FF3038;
    box-shadow:0 0 .13em rgba(255,48,56,.45);
    -webkit-text-fill-color:initial;
    pointer-events:none;
    animation:sb-av-rec-blink 1.3s step-end infinite;
  }
  @keyframes sb-av-rec-blink{
    0%,54%{opacity:1}
    55%,100%{opacity:.09}
  }
  /* Luz ambiental discreta que aparece y se asienta, sin barridos. */
  .sb-av-hero__inner::before{
    content:'';
    position:absolute;
    z-index:0;
    inset:-55% 11% -105%;
    pointer-events:none;
    background:radial-gradient(ellipse at 50% 45%,
      rgba(255,255,255,.065) 0%,
      rgba(255,255,255,.018) 38%,
      transparent 75%);
    opacity:0;
    animation:sb-av-ambient-fade 2s ease-out .12s both;
  }
  @keyframes sb-av-hero-focus{
    0%{opacity:0;transform:translate3d(0,14px,0) scale(.991);filter:blur(7px)}
    60%{opacity:1}
    100%{opacity:1;transform:translate3d(0,0,0) scale(1);filter:blur(0)}
  }
  @keyframes sb-av-ambient-fade{
    0%{opacity:0}
    44%{opacity:1}
    100%{opacity:.25}
  }
  /* Frase breve con degradado corporativo y entrada desde abajo. */
  .sb-av-hero__tagline{
    position:relative;
    z-index:1;
    display:table;
    max-width:100%;
    margin:clamp(25px,3.5vw,52px) 0 0;
    color:#ddff9a;
    font-family:var(--font-heading);
    font-size:clamp(1rem,2vw,1.8rem);
    font-weight:650;
    line-height:1.3;
    letter-spacing:-.035em;
    background-image:var(--brand-text-gradient,linear-gradient(108deg,#daff9c,#f4f5a4,#ccf294));
    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;
    opacity:0;
    transform:translate3d(0,28px,0);
    animation:sb-av-tagline-rise .9s cubic-bezier(.2,.76,.25,1) .7s both;
  }
  @keyframes sb-av-tagline-rise{
    from{opacity:0;transform:translate3d(0,28px,0)}
    to{opacity:1;transform:translate3d(0,0,0)}
  }

  /* Serie de fotogramas de distinto tamaño pero relación 16:9 real,
     con una línea inferior compartida y entrada escalonada. */
  .sb-av-showcase{
    position:relative;
    z-index:1;
    display:flex;
    align-items:flex-end;
    width:100%;
    gap:clamp(10px,1.5vw,23px);
    margin-top:auto;
    padding-top:clamp(58px,9vw,155px);
  }
  .sb-av-showcase__frame{
    flex:var(--frame-grow) 1 0%;
    min-width:0;
    aspect-ratio:16 / 9;
    background:var(--frame-color);
    border-radius:clamp(6px,.85vw,14px);
    overflow:hidden;
    opacity:0;
    transform:translate3d(0,90px,0);
    animation:sb-av-frame-rise .85s cubic-bezier(.19,.83,.23,1) both;
    animation-delay:calc(1.35s + var(--frame-index) * .21s);
  }
  @keyframes sb-av-frame-rise{
    0%{opacity:0;transform:translate3d(0,90px,0)}
    100%{opacity:1;transform:translate3d(0,0,0)}
  }
  @media(min-width:681px) and (max-height:690px){
    .sb-av-hero{padding-top:clamp(34px,5vh,72px);padding-bottom:26px}
    .sb-av-showcase{padding-top:35px}
  }
  @media(max-width:680px){
    .sb-av-hero{
      min-height:calc(100svh - 72px);
      padding:clamp(64px,15vw,105px) 15px 40px;
    }
    .sb-av-hero__title{
      font-size:4.8vw;
      font-weight:750;
      letter-spacing:-.05em;
    }
    .sb-av-hero__space{flex-basis:9px;width:9px}
    .sb-av-hero__tagline{font-size:clamp(.94rem,3.7vw,1.22rem);margin-top:25px}
    .sb-av-showcase{
      gap:11px;
      overflow-x:auto;
      overscroll-behavior-inline:contain;
      scroll-snap-type:x proximity;
      scrollbar-width:none;
      margin-inline:-15px;
      width:calc(100% + 30px);
      padding:60px 15px 5px;
    }
    .sb-av-showcase::-webkit-scrollbar{display:none}
    .sb-av-showcase__frame{
      flex:0 0 var(--frame-mobile-width);
      scroll-snap-align:start;
      border-radius:10px;
    }
  }
  @media(prefers-reduced-motion:reduce){
    .sb-av-hero__title{opacity:1;transform:none;filter:none;animation:none}
    .sb-av-hero__inner::before{opacity:.25;animation:none}
    .sb-av-hero__character:last-child::after{opacity:1;animation:none}
    .sb-av-hero__title::before{display:none;animation:none}
    .sb-av-hero__tagline{opacity:1;transform:none;animation:none}
    .sb-av-showcase__frame{opacity:1;transform:none;animation:none}
  }
</style>
