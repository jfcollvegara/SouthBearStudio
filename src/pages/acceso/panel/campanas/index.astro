---
import Private from '../../../../layouts/Private.astro';
---
<Private workspace title="Campañas promocionales" description="Redacta y envía promociones a contactos autorizados.">
<section class="campaign">
<p class="crumb"><a href="/acceso/panel/">SOUTHBEAR OS</a> / CAMPAÑAS PROMOCIONALES</p>
<header><h1>CREAR <span>CAMPAÑA.</span></h1><p>Redacta una promoción y elige a qué contactos autorizados enviarla. Ningún correo se enviará hasta que confirmes.</p></header>
<div class="cols"><form id="compose">
<label>Asunto<input name="subject" required maxlength="180" placeholder="Novedades de SouthBear Studio"/></label>
<label>Título del correo<input name="headline" required maxlength="180" placeholder="Una novedad para ti"/></label>
<label>Mensaje <small>Usa {nombre} para personalizar el saludo.</small><textarea name="body" maxlength="6000" rows="9" required placeholder="Hola, {nombre}:&#10;&#10;Te presentamos…"></textarea></label>
<label>Texto del botón (opcional)<input name="button_label" maxlength="100" placeholder="Visitar SouthBear"/></label>
<label>URL del botón (opcional)<input name="button_url" type="url" maxlength="400" placeholder="https://southbearstudio.com/"/></label>
<div class="preview"><h2>Vista previa</h2><div class="email"><div class="brand"><img src="/southbear-logo.svg" alt="SouthBear Studio"/></div><div class="inner"><h2 id="preview-title"></h2><p id="preview-body"></p><a id="preview-button" href="https://southbearstudio.com/" target="_blank" rel="noopener" hidden></a></div><footer>SouthBear Studio · info@southbearstudio.com<br/>Para darte de baja, escribe a info@southbearstudio.com.</footer></div></div>
<section class="recipients"><div class="recipients-head"><div><h2>Destinatarios</h2><p id="count">Cargando contactos…</p></div><button type="button" id="toggle">Desmarcar todos</button></div><div id="list" class="contacts"></div><p class="hint">Solo se muestran contactos que aceptaron publicidad. En cada envío se vuelven a comprobar las suscripciones. Máximo 20 destinatarios por operación.</p></section>
<div class="actions"><button id="send" type="submit">Enviar campaña a los seleccionados</button><p id="status" role="status" aria-live="polite"></p></div>
</form></div>
</section>
</Private>
<style>
.campaign{max-width:1150px;margin:auto;color:#fff;padding:25px 0 80px}.crumb{font-size:11px;color:#b8c7bd;letter-spacing:.12em}.crumb a{color:inherit}.campaign header{margin:40px 0}.campaign h1{font-size:clamp(38px,5vw,66px);letter-spacing:-.065em}.campaign h1 span{color:#bdcfc2}.campaign header p{color:#c3d0c6}.cols form{display:grid;gap:18px}.cols label{display:grid;gap:9px;font-size:13px}.cols input,.cols textarea{background:#17241d;border:1px solid #4b6655;color:white;padding:14px;border-radius:10px;font:inherit;width:100%}.cols small,.hint{color:#b9c5bc;font-size:12px}.preview{padding:20px;border:1px solid #455c4a;border-radius:16px}.email{background:white;color:#213327;border-radius:12px;overflow:hidden;max-width:620px;margin:auto;font-family:Arial,sans-serif}.brand{background:#101b16;padding:23px;text-align:center}.brand img{width:235px;background:#fff;padding:8px;border-radius:5px;max-width:100%}.inner{padding:34px}.inner h2{font-size:26px}.inner p{white-space:pre-wrap;line-height:1.7}.inner a{background:#233b2d;color:#fff;padding:12px 18px;border-radius:9px;display:inline-block;text-decoration:none}.inner a[hidden]{display:none}footer{background:#e7eee7;padding:24px;text-align:center;font-size:12px;line-height:1.7}.recipients{border:1px solid #43564a;border-radius:15px;padding:20px}.recipients-head{display:flex;justify-content:space-between;gap:15px;align-items:center}.recipients-head h2{margin:0}.recipients-head button{background:transparent;color:white;border:1px solid #66776c;border-radius:9px;padding:12px;cursor:pointer}.contacts{max-height:400px;overflow:auto;display:grid;gap:6px;margin:15px 0}.contacts label{padding:12px;border:1px solid #35483b;border-radius:8px;display:flex;align-items:center;gap:12px}.contacts input{width:18px;height:18px;flex-shrink:0;accent-color:#c6edaa}.contacts span{display:flex;flex-direction:column;overflow-wrap:anywhere}.contacts small{color:#c7d4ca}.actions button{background:#d2f2ba;color:#1c3020;border:0;padding:18px 24px;border-radius:12px;font-weight:700;cursor:pointer}.actions button:disabled{opacity:.5}.actions p{color:#d8e5d9}@media(max-width:600px){.recipients-head{align-items:start;flex-direction:column}.inner{padding:22px}}
</style>
<script>
const form=document.getElementById('compose'),list=document.getElementById('list'),count=document.getElementById('count'),status=document.getElementById('status'),send=document.getElementById('send');
let contacts=[],campaignId=crypto.randomUUID(),busy=false;
const fields=['subject','headline','body','button_label','button_url'];
function chosen(){return [...list.querySelectorAll('input[type=checkbox]:checked')].map(e=>e.value)}
function updateCount(){count.textContent=chosen().length+' seleccionados de '+contacts.length+' contactos';}
function draw(){const f=form.elements;document.getElementById('preview-title').textContent=f.namedItem('headline').value.replaceAll('{nombre}','María');document.getElementById('preview-body').textContent=f.namedItem('body').value.replaceAll('{nombre}','María');const btn=document.getElementById('preview-button');btn.textContent=f.namedItem('button_label').value;btn.hidden=!btn.textContent;btn.href=f.namedItem('button_url').value.startsWith('https://southbearstudio.com/')?f.namedItem('button_url').value:'https://southbearstudio.com/';}
async function load(){try{const r=await fetch('/api/southbear/correos-promociones/?page=1',{credentials:'same-origin',cache:'no-store'});const first=await r.json();if(!r.ok||!first.ok)throw Error(first.error||'No se pudo cargar');contacts=[...first.items];let page=1,more=first.hasMore;while(more&&page<100){page++;const response=await fetch('/api/southbear/correos-promociones/?page='+page,{credentials:'same-origin',cache:'no-store'});const data=await response.json();if(!response.ok||!data.ok)throw Error('No se pudo cargar la lista completa');contacts.push(...data.items);more=data.hasMore;}if(more)throw Error('Demasiados contactos para esta vista');list.replaceChildren();for(const c of contacts){const label=document.createElement('label'),check=document.createElement('input'),span=document.createElement('span'),name=document.createElement('small');check.type='checkbox';check.value=c.email;check.checked=true;span.textContent=c.email;name.textContent=c.name||'';span.append(name);label.append(check,span);list.append(label);check.addEventListener('change',updateCount);}updateCount();}catch(e){status.textContent=e.message;send.disabled=true;}}
document.getElementById('toggle').addEventListener('click',()=>{const all=chosen().length===contacts.length;list.querySelectorAll('input[type=checkbox]').forEach(c=>c.checked=!all);document.getElementById('toggle').textContent=all?'Marcar todos':'Desmarcar todos';updateCount()});
form.addEventListener('input',draw);
form.addEventListener('submit',async e=>{e.preventDefault();if(busy)return;const emails=chosen();if(!emails.length){status.textContent='Selecciona al menos un destinatario.';return;}if(emails.length>20){status.textContent='Selecciona un máximo de 20 destinatarios por envío.';return;}if(!confirm('Vas a enviar esta campaña a '+emails.length+' direcciones. ¿Confirmas el envío real?'))return;busy=true;send.disabled=true;status.textContent='Enviando, no cierres esta pestaña…';try{const data={campaign_id:campaignId,emails,...Object.fromEntries(fields.map(k=>[k,form.elements.namedItem(k).value]))};const res=await fetch('/api/southbear/campanas/',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','X-SouthBear-Request':'1'},body:JSON.stringify(data)});const result=await res.json();if(!res.ok||!result.ok)throw Error(result.error||'No se pudo enviar');status.textContent='Aceptados por Hostalia: '+result.sent+'. Fallidos: '+result.failed+'. Omitidos: '+result.skipped+'.';if(result.sent+result.failed+result.skipped===emails.length){campaignId=crypto.randomUUID();}}catch(err){status.textContent=err.message||'Error en el envío';}finally{busy=false;send.disabled=false;}});
draw();load();
</script>