---
import Private from '../../../layouts/Private.astro';
import {privateIcons} from '../../../data/private-modules.js';
const shortcuts=[
  {slug:'clientes',icon:'users',name:'Clientes',subtitle:'Datos de contacto y datos fiscales',number:'01'},
  {slug:'correos-promociones',icon:'file-text',name:'Correos promociones',subtitle:'Contactos que han aceptado recibir ofertas',number:'04'},
  {slug:'facturas',icon:'receipt',name:'Facturación',subtitle:'Preparación de borradores · emisión fiscal pendiente',number:'02'},
  {slug:'contabilidad',icon:'book-open',name:'Contabilidad',subtitle:'Anotaciones de ingresos, gastos y justificantes',number:'03'}
];
---
<Private workspace title="Gestión de SouthBear Studio" description="Área privada simplificada de clientes, facturación y contabilidad.">
  <div class="sb-ws-dashboard sb-minimal-dashboard">
    <div class="sb-ws-topline">
      <span class="sb-ws-breadcrumb">SOUTHBEAR OS <span>/</span> GESTIÓN</span>
      <span class="sb-ws-topline__session"><i aria-hidden="true"></i> ÁREA PROTEGIDA</span>
    </div>
    <header class="sb-ws-hero">
      <div>
        <div class="sb-ws-hero__label"><span class="sb-ws-mini-rec" aria-hidden="true"></span> GESTIÓN SENCILLA · SOUTHBEAR STUDIO</div>
        <h1>TODO LO <span>NECESARIO.</span></h1>
        <p>Clientes, correos promociones, facturación y contabilidad. Sin módulos de proyectos, oportunidades o calendarios que no necesitas.</p>
      </div>
      <div class="sb-ws-hero__side">
        <span class="sb-ws-hero__caption">ESTADO DEL SISTEMA</span>
        <strong>GESTIÓN <span>01</span></strong>
        <p><span class="sb-ws-hero__safe" aria-hidden="true"></span> Acceso privado protegido</p>
        <span class="sb-ws-hero__date" id="sb-ws-date">—</span>
      </div>
    </header>
    <section class="sb-ws-block" aria-labelledby="sb-minimal-options">
      <div class="sb-ws-section-head">
        <div><span class="sb-ws-section-id">01 / ÁREAS DE TRABAJO</span><h2 id="sb-minimal-options">¿Qué necesitas gestionar?</h2></div>
      </div>
      <div class="sb-minimal-grid">
        {shortcuts.map(item=>(
          <a href={'/acceso/panel/'+item.slug+'/'} class="sb-minimal-card">
            <span class="sb-minimal-card__top"><span>{item.number} / SOUTHBEAR</span><svg width="29" height="29" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{(privateIcons[item.icon]||[]).map(d=><path d={d}/>)}</svg></span>
            <strong>{item.name}</strong>
            <small>{item.subtitle}</small>
            <span class="sb-minimal-card__arrow" aria-hidden="true">Abrir apartado ↗</span>
          </a>
        ))}
      </div>
    </section>
    <section class="sb-ws-block" aria-labelledby="sb-minimal-totals">
      <div class="sb-ws-section-head">
        <div><span class="sb-ws-section-id">02 / RESUMEN DE TUS REGISTROS</span><h2 id="sb-minimal-totals">De un vistazo.</h2></div>
        <span class="sb-ws-section-hint">MOVIMIENTOS MANUALES</span>
      </div>
      <div class="sb-ws-cash sb-minimal-cash">
        <div><span>CLIENTES ACTIVOS</span><strong id="sb-mini-clients">—</strong></div>
        <div><span>COBROS ANOTADOS ESTE MES</span><strong id="sb-mini-in">—</strong></div>
        <div><span>GASTOS PAGADOS ESTE MES</span><strong id="sb-mini-out">—</strong></div>
        <p>Son anotaciones guardadas manualmente, no extractos bancarios ni registros fiscales certificados. Los apartados anteriores quedan ocultos del menú, pero sus datos no se han eliminado.</p>
      </div>
    </section>
    <div class="sb-ws-setup sb-minimal-warning" role="note">
      <div><strong>Facturación fiscal pendiente de habilitar</strong><p>Actualmente puedes preparar y guardar borradores, pero todavía no emitir facturas ordinarias o simplificadas definitivas. Antes deben estar implementadas la numeración, rectificaciones y las garantías exigibles al software de facturación.</p></div>
    </div>
    <div class="sb-ws-endnote"><span>●</span> SOUTHBEAR STUDIO / GESTIÓN ESENCIAL <span>ÁREA PRIVADA</span></div>
  </div>
  <style>
    .sb-minimal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;padding-bottom:24px}
    .sb-minimal-card{position:relative;min-height:248px;padding:26px;border-radius:24px;border:1px solid rgba(255,255,255,.22);background:linear-gradient(134deg,rgba(255,255,255,.15),rgba(255,255,255,.045));color:#fff;text-decoration:none;display:flex;flex-direction:column;gap:14px;box-shadow:inset 0 1px rgba(255,255,255,.2),0 12px 32px rgba(0,0,0,.16);transition:transform .18s,border-color .18s}
    .sb-minimal-card:hover{transform:translateY(-2px);border-color:rgba(255,255,255,.5)}
    .sb-minimal-card__top{display:flex;align-items:center;justify-content:space-between;color:#e2e2e8;font-size:10px;letter-spacing:.15em}
    .sb-minimal-card>strong{font-family:'Space Grotesk Variable',system-ui,sans-serif;font-size:clamp(25px,2.6vw,37px);letter-spacing:-.045em;margin-top:15px}
    .sb-minimal-card>small{color:#c4c4cc;line-height:1.55;font-size:12px}
    .sb-minimal-card__arrow{margin-top:auto;font-size:11px;font-weight:720;color:#fafafa}
    @media(max-width:900px){.sb-minimal-grid{grid-template-columns:1fr}}
    @media(max-width:620px){.sb-minimal-card{min-height:185px;padding:21px}.sb-minimal-card>strong{margin-top:0}}
  </style>
  <script>
    const date=document.getElementById('sb-ws-date');
    if(date)date.textContent=new Intl.DateTimeFormat('es-ES',{day:'numeric',month:'long',year:'numeric'}).format(new Date()).toUpperCase();
    async function loadMinimalSummary(){
      try{
        const res=await fetch('/api/southbear/resumen',{credentials:'same-origin',cache:'no-store',headers:{Accept:'application/json'}});
        if(!res.ok)return;
        const body=await res.json();if(!body.ok)return;
        const money=new Intl.NumberFormat('es-ES',{style:'currency',currency:'EUR'});
        document.getElementById('sb-mini-clients').textContent=new Intl.NumberFormat('es-ES').format(body.metrics.clients||0);
        document.getElementById('sb-mini-in').textContent=money.format((body.metrics.receipts_month_cents||0)/100);
        document.getElementById('sb-mini-out').textContent=money.format((body.metrics.expenses_month_cents||0)/100);
      }catch{}
    }
    loadMinimalSummary();
  </script>
</Private>