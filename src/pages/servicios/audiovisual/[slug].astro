---
import Base from '../../../layouts/Base.astro';
import {
  audiovisualService,
  audiovisualPackages,
  formatAudiovisualPackagePrice,
  formatAudiovisualExtraPrice
} from '../../../data/audiovisual-packages.js';

export function getStaticPaths() {
  return audiovisualPackages.map(pkg => ({
    params: { slug: pkg.slug },
    props: { pkg }
  }));
}

const { pkg } = Astro.props;
const quoteUrl = '/presupuesto/?servicio=audiovisual&paquete=' + encodeURIComponent(pkg.name);
const conditionTitles = [
  'Idea y planificación',
  'Rodaje y localizaciones',
  'Formatos y entregables',
  'Derechos y licencias'
];
const conditions = audiovisualService.common.map((detail,index) => ({
  title: conditionTitles[index],
  detail
}));
const reviewsSection = audiovisualService.extraSections.find(section => section.title === 'Revisiones adicionales');
const reviewExtraName = {
  'Reel Profesional': 'Ronda adicional de Reel',
  'Vídeo Promocional': 'Ronda adicional de Promocional',
  'Vídeo Corporativo': 'Ronda adicional de Corporativo'
};
const reviewExtra = reviewsSection?.items.find(item => item.name === reviewExtraName[pkg.name]);
const includedReview = pkg.features.find(feature => /revisi[oó]n/i.test(feature));
const alternatives = audiovisualPackages.filter(item => item.slug !== pkg.slug);
---
<Base
  title={pkg.name + ' — Producción audiovisual'}
  description={pkg.summary + ' Conoce qué incluye, condiciones y presupuesto del paquete ' + pkg.name + ' en SOUTHBEAR STUDIO.'}
>
  <div class="sb-avd-page">
    <div class="sb-avd-container">
      <a class="sb-avd-back" href="/servicios/audiovisual/">
        <span aria-hidden="true">←</span> Volver a Producción Audiovisual
      </a>

      <section class="sb-avd-intro" aria-labelledby="sb-avd-title">
        <div class="sb-avd-intro__copy">
          <h1 id="sb-avd-title">{pkg.name}</h1>
          <p class="sb-avd-lead">{pkg.summary}</p>
          <div class="sb-avd-pricing">
            <strong class="sb-avd-price">{formatAudiovisualPackagePrice(pkg)}</strong>
            <span class="sb-avd-vat">IVA incluido{pkg.price === null ? ' · Precio a concretar' : ''}</span>
          </div>
          <a class="sb-avd-cta" href={quoteUrl}>Solicitar presupuesto <span aria-hidden="true">↗</span></a>
        </div>
        <div class="sb-avd-intro__visual">
          <div class="sb-avd-video-frame">
            <video class="sb-avd-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
              <source src={pkg.video} type="video/mp4" />
            </video>
          </div>
        </div>
      </section>

      <section class="sb-avd-section" aria-labelledby="sb-avd-includes">
        <div class="sb-avd-section__heading">
          <h2 id="sb-avd-includes">Todo lo que incluye</h2>
          <p>El alcance de este paquete, tal como está definido en nuestro catálogo.</p>
        </div>
        <div class="sb-avd-features">
          {pkg.features.map((feature, index)=>(
            <div class="sb-avd-feature">
              <span class="sb-avd-feature__num">0{index+1}</span>
              <p>{feature}</p>
              <span class="sb-avd-feature__tick" aria-hidden="true">✓</span>
            </div>
          ))}
        </div>
      </section>

      <section class="sb-avd-section" aria-labelledby="sb-avd-conditions">
        <div class="sb-avd-section__heading">
          <h2 id="sb-avd-conditions">Condiciones generales</h2>
          <p>Las condiciones de la producción, explicadas desde el principio.</p>
        </div>
        <div class="sb-avd-conditions">
          {conditions.map((item,index)=>(
            <article class="sb-avd-glass sb-avd-condition">
              <span class="sb-avd-condition__num">0{index+1}</span>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="sb-avd-section" aria-labelledby="sb-avd-details">
        <div class="sb-avd-section__heading">
          <h2 id="sb-avd-details">Todo claro, desde el principio</h2>
        </div>
        <div class="sb-avd-details">
          <article class="sb-avd-glass sb-avd-info">
            <div class="sb-avd-info__symbol" aria-hidden="true">↻</div>
            <div>
              <h3>Revisiones y cambios</h3>
              <p>{includedReview || 'Las revisiones y sus condiciones se definen en el presupuesto de esta producción personalizada.'}</p>
              {reviewExtra
                ? <p>¿Necesitas otra ronda? <strong>{reviewExtra.name}: {formatAudiovisualExtraPrice(reviewExtra)}</strong>. {reviewExtra.detail}</p>
                : <p>Las revisiones adicionales y los cambios de alcance se presupuestan según las necesidades de la producción.</p>
              }
              <p>Los cambios adicionales requieren presupuesto previo; una revisión no incluye un nuevo rodaje ni trabajos fuera del alcance contratado.</p>
            </div>
          </article>
          <article class="sb-avd-glass sb-avd-info">
            <div class="sb-avd-info__symbol" aria-hidden="true">−</div>
            <div>
              <h3>Servicios no incluidos</h3>
              <p>{audiovisualService.notIncluded}</p>
              <a class="sb-avd-textlink" href="/servicios/audiovisual/#sb-av-extras-heading">Consultar servicios extra <span aria-hidden="true">↗</span></a>
            </div>
          </article>
          <article class="sb-avd-glass sb-avd-info">
            <div class="sb-avd-info__symbol" aria-hidden="true">↗</div>
            <div>
              <h3>Presupuesto y contratación</h3>
              <p>La solicitud permite concretar la idea, las necesidades y los extras de tu proyecto. El alcance, las condiciones y el precio definitivo se confirman antes de contratar.</p>
              <p>Los formatos alternativos, las jornadas o localizaciones adicionales y los trabajos fuera de lo incluido se valoran por separado. Se respetan los derechos legales del cliente y las licencias de los materiales utilizados.</p>
            </div>
          </article>
        </div>
      </section>

      <section class="sb-avd-final" aria-labelledby="sb-avd-final-title">
        <div>
          <h2 id="sb-avd-final-title">Tu proyecto empieza aquí</h2>
          <p>Cuéntanos qué tienes en mente y preparamos una propuesta adaptada a {pkg.name === 'Vídeo Personalizado' ? 'tu producción' : 'este paquete'}.</p>
        </div>
        <a class="sb-avd-cta sb-avd-cta--final" href={quoteUrl}>Solicitar presupuesto <span aria-hidden="true">↗</span></a>
      </section>

      <section class="sb-avd-alternatives" aria-labelledby="sb-avd-other-title">
        <h2 id="sb-avd-other-title">Descubre otros paquetes.</h2>
        <div class="sb-avd-alternatives__grid">
          {alternatives.map(item=>(
            <a class="sb-avd-alternative" href={'/servicios/audiovisual/'+item.slug+'/'}>
              <span>{item.name}</span>
              <strong>{formatAudiovisualPackagePrice(item)}</strong>
              <span class="sb-avd-alternative__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</Base>
<script>
  document.querySelectorAll<HTMLVideoElement>('.sb-avd-video').forEach(video=>{
    const reveal = () => video.classList.add('is-ready');
    if(video.readyState >= 2) reveal();
    else video.addEventListener('loadeddata',reveal,{once:true});
  });
</script>
<style>
  .sb-avd-page{
    min-height:100vh;
    padding:clamp(34px,4vw,65px) clamp(18px,4vw,92px) clamp(100px,12vw,165px);
    background:#0A0A0A;
    color:#fff;
    overflow:hidden;
  }
  .sb-avd-container{width:100%;max-width:1510px;margin:0 auto}
  .sb-avd-back{
    display:inline-flex;
    align-items:center;
    gap:13px;
    color:rgba(255,255,255,.67);
    font-size:.91rem;
    font-weight:550;
    text-decoration:none;
    transition:color .25s ease;
  }
  .sb-avd-back:hover{color:#DDFF9A}
  .sb-avd-back:focus-visible,
  .sb-avd-textlink:focus-visible{outline:2px solid #DDFF9A;outline-offset:6px}
  .sb-avd-intro{
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(0,48%);
    align-items:center;
    gap:clamp(32px,5vw,96px);
    min-height:clamp(510px,55vw,750px);
    padding:clamp(64px,7vw,118px) 0 clamp(65px,7vw,110px);
  }
  .sb-avd-intro__copy{min-width:0}
  .sb-avd-intro h1{
    margin:0;
    max-width:780px;
    font-family:var(--font-heading);
    font-size:clamp(2.7rem,5.7vw,6.35rem);
    line-height:1.03;
    font-weight:750;
    letter-spacing:-.07em;
    overflow-wrap:break-word;
    animation:sb-avd-rise .75s cubic-bezier(.2,.75,.2,1) both;
  }
  @keyframes sb-avd-rise{
    from{opacity:0;transform:translate3d(0,18px,0)}
    to{opacity:1;transform:translate3d(0,0,0)}
  }
  .sb-avd-lead{
    margin:clamp(19px,2.8vw,33px) 0 0;
    max-width:600px;
    font-size:clamp(1.07rem,1.4vw,1.32rem);
    line-height:1.65;
    color:rgba(255,255,255,.76);
  }
  .sb-avd-pricing{
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    gap:7px;
    margin:clamp(26px,3vw,42px) 0 clamp(26px,3.5vw,47px);
  }
  .sb-avd-price,.sb-avd-alternative strong{
    color:#DDFF9A;
    background-image:var(--brand-text-gradient,linear-gradient(108deg,#daff9c,#f4f5a4,#ccf294));
    -webkit-background-clip:text;
    background-clip:text;
    -webkit-text-fill-color:transparent;
  }
  .sb-avd-price{
    font-size:clamp(1.7rem,2.7vw,2.75rem);
    font-weight:800;
    line-height:1.14;
    letter-spacing:-.055em;
  }
  .sb-avd-vat{font-size:.85rem;color:rgba(255,255,255,.58)}
  .sb-avd-cta{
    display:inline-flex;
    justify-content:space-between;
    align-items:center;
    gap:32px;
    min-height:57px;
    padding:15px 25px;
    border:1px solid #e0fbaa;
    border-radius:999px;
    color:#151b0c;
    background:linear-gradient(108deg,#dbff9b,#edf9af 57%,#c4f28a);
    font-size:1rem;
    font-weight:800;
    line-height:1.2;
    text-decoration:none;
    box-shadow:0 0 0 rgba(221,255,154,0);
    transition:transform .25s ease,box-shadow .25s ease;
  }
  .sb-avd-cta:hover{
    transform:translateY(-3px);
    box-shadow:0 0 26px rgba(221,255,154,.2);
  }
  .sb-avd-cta:focus-visible{outline:3px solid #fff;outline-offset:4px}
  .sb-avd-intro__visual{min-width:0}
  .sb-avd-video-frame{
    position:relative;
    width:100%;
    aspect-ratio:16 / 9;
    border-radius:clamp(18px,2vw,30px);
    overflow:hidden;
    background:#414141;
    box-shadow:0 18px 62px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.19);
  }
  .sb-avd-video{
    position:absolute;
    inset:0;
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
    opacity:0;
    transition:opacity .5s ease;
  }
  .sb-avd-video.is-ready{opacity:1}
  .sb-avd-section{padding:clamp(55px,6vw,95px) 0}
  .sb-avd-section__heading{max-width:830px;margin-bottom:clamp(29px,4vw,55px)}
  .sb-avd-section__heading h2,.sb-avd-final h2{
    margin:0;
    font-family:var(--font-heading);
    font-weight:750;
    font-size:clamp(2rem,4.3vw,4.6rem);
    line-height:1.06;
    letter-spacing:-.067em;
    text-wrap:balance;
  }
  .sb-avd-section__heading>p{
    max-width:660px;
    margin:17px 0 0;
    color:rgba(255,255,255,.68);
    font-size:1rem;
    line-height:1.7;
  }
  .sb-avd-features{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:clamp(12px,1.8vw,24px);
  }
  .sb-avd-feature,.sb-avd-glass,.sb-avd-alternative,.sb-avd-final{
    position:relative;
    isolation:isolate;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.25);
    border-radius:clamp(20px,2.3vw,32px);
    background:linear-gradient(135deg,
      rgba(255,255,255,.16) 0%,
      rgba(255,255,255,.085) 30%,
      rgba(255,255,255,.065) 62%,
      rgba(255,255,255,.13) 100%);
    -webkit-backdrop-filter:blur(16px) saturate(140%);
    backdrop-filter:blur(16px) saturate(140%);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.51),
      inset 0 -1px 0 rgba(255,255,255,.1),
      0 22px 65px rgba(0,0,0,.22);
  }
  .sb-avd-feature::before,.sb-avd-glass::before,.sb-avd-alternative::before,.sb-avd-final::before{
    content:'';
    position:absolute;
    inset:0;
    z-index:0;
    pointer-events:none;
    background:
      radial-gradient(ellipse at 8% 0%,rgba(255,255,255,.23),transparent 47%),
      linear-gradient(135deg,rgba(255,255,255,.12),transparent 47%,rgba(255,255,255,.07));
  }
  .sb-avd-feature>*,
  .sb-avd-glass>*,
  .sb-avd-alternative>*,
  .sb-avd-final>*{position:relative;z-index:1}
  .sb-avd-feature{
    display:flex;
    align-items:flex-start;
    gap:clamp(16px,2vw,31px);
    padding:clamp(21px,2.5vw,35px);
  }
  .sb-avd-feature__num{
    flex:none;
    font-size:1rem;
    line-height:1.65;
    color:#DDFF9A;
    font-weight:750;
    letter-spacing:-.03em;
  }
  .sb-avd-feature p{
    flex:1;
    margin:0;
    color:rgba(255,255,255,.92);
    font-size:clamp(.94rem,1.12vw,1.1rem);
    line-height:1.62;
  }
  .sb-avd-feature__tick{color:#DDFF9A;font-size:1.15rem;line-height:1.65}
  .sb-avd-conditions{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:clamp(14px,2vw,27px);
  }
  .sb-avd-condition{padding:clamp(26px,3.1vw,47px)}
  .sb-avd-condition__num{
    color:#DDFF9A;
    font-weight:750;
    font-size:.82rem;
    letter-spacing:.1em;
  }
  .sb-avd-condition h3,.sb-avd-info h3{
    margin:clamp(20px,2.5vw,32px) 0 0;
    font-family:var(--font-heading);
    font-size:clamp(1.4rem,2.1vw,2.15rem);
    font-weight:750;
    line-height:1.15;
    letter-spacing:-.05em;
  }
  .sb-avd-condition p,.sb-avd-info p{
    margin:18px 0 0;
    color:rgba(255,255,255,.77);
    font-size:clamp(.94rem,1.05vw,1.05rem);
    line-height:1.72;
  }
  .sb-avd-details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(14px,2vw,27px)}
  .sb-avd-info{
    display:flex;
    flex-direction:column;
    gap:0;
    padding:clamp(26px,3.1vw,47px);
  }
  .sb-avd-info:last-child{grid-column:1/-1}
  .sb-avd-info__symbol{
    display:grid;
    place-items:center;
    width:45px;
    height:45px;
    border:1px solid rgba(255,255,255,.28);
    border-radius:14px;
    color:#DDFF9A;
    background:rgba(255,255,255,.1);
    font-size:1.45rem;
  }
  .sb-avd-info h3{margin-top:23px}
  .sb-avd-info p strong{color:#fff}
  .sb-avd-textlink{
    display:inline-flex;
    gap:12px;
    margin-top:22px;
    color:#DDFF9A;
    font-size:.91rem;
    font-weight:700;
    text-decoration:none;
  }
  .sb-avd-textlink:hover{text-decoration:underline}
  .sb-avd-final{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:35px;
    margin-top:clamp(70px,7vw,115px);
    padding:clamp(28px,4vw,60px);
  }
  .sb-avd-final h2{font-size:clamp(2rem,3.7vw,3.8rem)}
  .sb-avd-final p{
    max-width:750px;
    color:rgba(255,255,255,.75);
    margin:20px 0 0;
    line-height:1.7;
  }
  .sb-avd-cta--final{flex:none}
  .sb-avd-alternatives{margin-top:clamp(85px,9vw,130px)}
  .sb-avd-alternatives h2{
    margin:0 0 28px;
    font-family:var(--font-heading);
    font-size:clamp(1.5rem,2.3vw,2.3rem);
    letter-spacing:-.055em;
    font-weight:750;
  }
  .sb-avd-alternatives__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .sb-avd-alternative{
    display:flex;
    flex-direction:column;
    gap:13px;
    min-width:0;
    min-height:163px;
    padding:27px;
    color:#fff;
    text-decoration:none;
    transition:transform .28s ease,border-color .28s ease,box-shadow .28s ease;
  }
  .sb-avd-alternative>span:first-child{font-weight:750;font-size:1.18rem;line-height:1.3}
  .sb-avd-alternative strong{font-size:1rem}
  .sb-avd-alternative__arrow{position:absolute!important;right:24px;bottom:20px;font-size:1.3rem;color:#DDFF9A}
  .sb-avd-alternative:hover,.sb-avd-alternative:focus-visible{
    transform:translateY(-3px);
    border-color:rgba(255,255,255,.6);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.68),0 0 27px rgba(255,255,255,.15),0 19px 60px rgba(0,0,0,.28);
  }
  .sb-avd-alternative:focus-visible{outline:3px solid #DDFF9A;outline-offset:4px}
  @media(max-width:1000px){
    .sb-avd-intro{grid-template-columns:1fr;gap:44px;min-height:0}
    .sb-avd-intro__visual{max-width:820px}
    .sb-avd-final{flex-direction:column;align-items:flex-start}
  }
  @media(max-width:680px){
    .sb-avd-page{padding:30px 15px 95px}
    .sb-avd-intro{padding:67px 0 59px;gap:35px}
    .sb-avd-intro h1{font-size:clamp(2.65rem,11vw,4.15rem)}
    .sb-avd-lead{font-size:1.07rem}
    .sb-avd-video-frame{border-radius:16px}
    .sb-avd-section{padding:50px 0}
    .sb-avd-section__heading h2{font-size:clamp(2.05rem,8.4vw,3rem)}
    .sb-avd-features,.sb-avd-conditions,.sb-avd-details{grid-template-columns:1fr}
    .sb-avd-feature{padding:24px}
    .sb-avd-condition,.sb-avd-info{padding:26px}
    .sb-avd-info:last-child{grid-column:auto}
    .sb-avd-final{padding:29px;gap:28px}
    .sb-avd-cta--final{width:100%}
    .sb-avd-alternatives__grid{grid-template-columns:1fr}
    .sb-avd-alternative{min-height:134px}
  }
  @media(prefers-reduced-motion:reduce){
    .sb-avd-intro h1{animation:none}
    .sb-avd-cta,.sb-avd-alternative,.sb-avd-video{transition:none}
    .sb-avd-cta:hover,.sb-avd-alternative:hover{transform:none}
  }
</style>
