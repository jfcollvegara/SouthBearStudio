---
import Base from '../layouts/Base.astro';
import {projects} from '../data/projects.js';
const categories=['Todos','Diseño web','Branding','Diseño gráfico','Audiovisual'];
const available=[...new Set(projects.map(p=>p.category))];
const filters=categories.filter(c=>c==='Todos'||available.includes(c));
const aspirational=[
  {number:'01',title:'Diseño web',tag:'DIGITAL / EXPERIENCIAS',symbol:'WEB',tone:'sage'},
  {number:'02',title:'Branding',tag:'IDENTIDAD / MARCA',symbol:'ID',tone:'silver'},
  {number:'03',title:'Diseño gráfico',tag:'DISEÑO / COMUNICACIÓN',symbol:'GR',tone:'olive'},
  {number:'04',title:'Audiovisual',tag:'IMAGEN / MOVIMIENTO',symbol:'AV',tone:'slate'}
];
---
<Base title="Proyectos" description="Explora los proyectos y trabajos de SOUTHBEAR STUDIO: identidad, diseño web, diseño gráfico y producción audiovisual.">
<main class="sb-work">
  <div class="sb-work__ambient sb-work__ambient--a" aria-hidden="true"></div>
  <div class="sb-work__ambient sb-work__ambient--b" aria-hidden="true"></div>
  <div class="sb-work__wrap">
    <section class="sb-work__hero" aria-labelledby="work-heading">
      <div class="sb-work__topline"><span><i></i> SOUTHBEAR STUDIO / PORTFOLIO</span><span>CREATIVIDAD EN TODAS SUS FORMAS · 2026</span></div>
      <p class="sb-work__eyebrow">NUESTRO TRABAJO <span class="sb-work__slash">/</span> SELECTED WORK</p>
      <h1 id="work-heading">Proyectos que<br/><em>dejan huella.</em></h1>
      <div class="sb-work__hero-bottom"><p>Cada idea tiene algo que contar. Le damos forma con diseño, intención y una mirada propia.</p><span class="sb-work__scroll" aria-hidden="true">EXPLORA <span>↓</span></span></div>
    </section>

    <section class="sb-work__gallery" aria-labelledby="gallery-heading">
      <div class="sb-work__gallery-heading"><div><span class="sb-work__mini">01 / PROYECTOS</span><h2 id="gallery-heading">Lo que hacemos<span class="sb-work__period">.</span></h2></div><span class="sb-work__gallery-counter">{String(projects.length).padStart(2,'0')} TRABAJOS PUBLICADOS</span></div>
      {projects.length>0 ? (
        <>
          <div class="sb-work__filters" role="group" aria-label="Filtrar trabajos">
            {filters.map((filter,i)=><button class:list={['sb-work__filter',{'is-active':i===0}]} type="button" data-work-filter={filter==='Todos'?'all':filter} aria-pressed={i===0}>{filter}</button>)}
          </div>
          <div class="sb-work__grid">
            {projects.map((p,i)=><article class="sb-work__project" data-work-category={p.category}>
              <a href={p.url||'/contacto/'} class="sb-work__project-link" target={p.url?'_blank':undefined} rel={p.url?'noopener noreferrer':undefined} aria-label={'Ver '+p.title}>
                <div class="sb-work__art">
                  {p.image?<img src={p.image} alt={p.title} loading="lazy" decoding="async"/>:<div class="sb-work__art-fallback" aria-hidden="true"><span>SOUTHBEAR</span></div>}
                  <span class="sb-work__glass-arrow" aria-hidden="true">↗</span>
                  {p.type==='demo'&&<span class="sb-work__demo-badge">CONCEPTO</span>}
                </div>
                <div class="sb-work__project-details"><div><span>{p.category} <span class="sb-work__dot">·</span> {String(i+1).padStart(2,'0')}</span><h3>{p.title}</h3><p>{p.description}</p></div><span class="sb-work__project-arrow" aria-hidden="true">↗</span></div>
              </a>
            </article>)}
          </div>
        </>
      ):(
        <>
          <div class="sb-work__empty-lead"><span class="sb-work__live-dot"></span> Estamos preparando nuestra selección de trabajos. Mientras tanto, descubre las disciplinas que dan forma a cada proyecto.</div>
          <div class="sb-work__grid sb-work__grid--preview">
            {aspirational.map((item,i)=><article class={'sb-work__preview sb-work__preview--'+item.tone}>
              <div class="sb-work__preview-art">
                <div class="sb-work__preview-orbit" aria-hidden="true"></div>
                <span class="sb-work__preview-symbol" aria-hidden="true">{item.symbol}</span>
                <div class="sb-work__preview-glass"><span>SOUTHBEAR STUDIO</span><span>{item.number} / 04</span></div>
              </div>
              <div class="sb-work__preview-meta"><span>{item.tag}</span><span>PRÓXIMAMENTE</span></div>
              <h3>{item.title}<span aria-hidden="true"> ↗</span></h3>
            </article>)}
          </div>
          <p class="sb-work__note">Esta es una vista de presentación de nuestras especialidades, no una colección de trabajos atribuidos a clientes. Los proyectos reales aparecerán aquí cuando se publiquen.</p>
        </>
      )}
    </section>

    <section class="sb-work__cta" aria-labelledby="work-cta-title">
      <div class="sb-work__cta-orb" aria-hidden="true"></div>
      <div class="sb-work__cta-content"><span class="sb-work__mini">02 / TU PRÓXIMO PROYECTO</span><h2 id="work-cta-title">Lo siguiente<br/>puede ser <em>lo tuyo.</em></h2><p>Las grandes ideas empiezan con una conversación. Cuéntanos qué tienes en mente y creamos algo juntos.</p><a href="/contacto/" class="sb-work__cta-button">Hablemos de tu proyecto <span aria-hidden="true">↗</span></a></div>
      <div class="sb-work__cta-label" aria-hidden="true">SOUTHBEAR / CREATE SOMETHING</div>
    </section>
  </div>
</main>
<script>
const buttons=[...document.querySelectorAll('[data-work-filter]')];
buttons.forEach(button=>button.addEventListener('click',()=>{
  buttons.forEach(other=>{const selected=other===button;other.classList.toggle('is-active',selected);other.setAttribute('aria-pressed',String(selected));});
  document.querySelectorAll('[data-work-category]').forEach(card=>{card.hidden=button.dataset.workFilter!=='all'&&card.dataset.workCategory!==button.dataset.workFilter;});
}));
const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
if(!reduceMotion&&'IntersectionObserver' in window){
 const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target);}})},{threshold:.12});
 document.querySelectorAll('.sb-work__preview,.sb-work__project,.sb-work__cta').forEach(el=>{el.classList.add('sb-work__reveal');observer.observe(el);});
}
</script>
<style>
.sb-work{position:relative;isolation:isolate;overflow:hidden;background:#080a0a;color:#f8faf8;min-height:100vh;padding:clamp(70px,8vw,130px) 0 110px}
.sb-work__ambient{pointer-events:none;position:absolute;z-index:-1;border-radius:50%;filter:blur(85px);opacity:.6}
.sb-work__ambient--a{width:620px;height:620px;background:radial-gradient(circle,rgba(160,196,173,.22),transparent 70%);right:-240px;top:80px}
.sb-work__ambient--b{width:590px;height:590px;background:radial-gradient(circle,rgba(175,200,195,.12),transparent 70%);left:-230px;top:900px}
.sb-work__wrap{width:min(1500px,calc(100% - clamp(36px,7vw,140px)));margin:auto}
.sb-work__topline{display:flex;justify-content:space-between;gap:20px;color:#98aca3;font-size:10px;letter-spacing:.15em;font-weight:700}
.sb-work__topline i,.sb-work__live-dot{display:inline-block;background:#c8ecaa;width:7px;height:7px;border-radius:50%;box-shadow:0 0 18px #b7e8a6;margin-right:8px}
.sb-work__hero{padding:clamp(65px,9vw,155px) 0 clamp(75px,9vw,145px);border-bottom:1px solid rgba(255,255,255,.15)}
.sb-work__eyebrow,.sb-work__mini{font-size:11px;font-weight:720;letter-spacing:.19em;color:#c8d7cb}.sb-work__slash{margin:0 8px;opacity:.35}
.sb-work h1{font-family:'Space Grotesk Variable',system-ui,sans-serif;font-size:clamp(62px,10.5vw,168px);font-weight:620;line-height:.96;letter-spacing:-.085em;margin:25px 0 50px}
.sb-work h1 em,.sb-work__cta h2 em{font-style:normal;color:#b7c9c0}
.sb-work__hero-bottom{display:flex;justify-content:space-between;align-items:flex-end;gap:30px}.sb-work__hero-bottom p{max-width:590px;font-size:clamp(16px,1.65vw,22px);line-height:1.65;letter-spacing:-.025em;color:#bec7c3;margin:0}.sb-work__scroll{font-size:10px;letter-spacing:.17em;color:#b7c5bb;white-space:nowrap}.sb-work__scroll span{font-size:26px;margin-left:10px}
.sb-work__gallery{padding-top:clamp(70px,9vw,130px)}.sb-work__gallery-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:44px}.sb-work__gallery-heading h2{font-size:clamp(38px,4.7vw,72px);letter-spacing:-.07em;margin:10px 0 0;font-weight:600}.sb-work__period{color:#d2edc2}.sb-work__gallery-counter{font-size:10px;letter-spacing:.17em;color:#adbdb2;white-space:nowrap;padding-bottom:9px}
.sb-work__filters{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:34px}.sb-work__filter{border:1px solid rgba(255,255,255,.28);background:rgba(255,255,255,.06);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-radius:999px;padding:12px 19px;color:#d2dbd5;font-size:12px;cursor:pointer}.sb-work__filter.is-active,.sb-work__filter:hover{background:rgba(221,242,218,.2);border-color:rgba(231,255,235,.6);color:#fff}
.sb-work__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(32px,4.5vw,70px) clamp(16px,2.5vw,40px)}.sb-work__project[hidden]{display:none}
.sb-work__project-link{text-decoration:none;color:inherit;display:block}.sb-work__art{position:relative;overflow:hidden;aspect-ratio:1.18;border-radius:26px;background:#293631}.sb-work__project:nth-child(4n+2) .sb-work__art,.sb-work__project:nth-child(4n+3) .sb-work__art{aspect-ratio:.99}.sb-work__art img{width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.2,.7,.2,1)}.sb-work__project-link:hover img{transform:scale(1.045)}.sb-work__art-fallback{display:grid;place-items:center;width:100%;height:100%;font-size:clamp(30px,5vw,80px);font-weight:800;letter-spacing:-.09em;color:#b9c9bb}
.sb-work__glass-arrow{position:absolute;top:20px;right:20px;display:grid;place-items:center;width:55px;height:55px;background:rgba(250,255,255,.18);border:1px solid rgba(255,255,255,.35);backdrop-filter:blur(18px);border-radius:19px;font-size:26px;transition:transform .25s,background .25s}.sb-work__project-link:hover .sb-work__glass-arrow{transform:rotate(45deg);background:rgba(250,255,255,.28)}.sb-work__demo-badge{position:absolute;left:22px;bottom:20px;background:rgba(4,8,6,.5);padding:10px 13px;border-radius:12px;backdrop-filter:blur(16px);font-size:10px;letter-spacing:.12em}
.sb-work__project-details{display:flex;justify-content:space-between;gap:15px;padding:22px 5px}.sb-work__project-details>div>span,.sb-work__preview-meta{font-size:10px;letter-spacing:.14em;color:#adc2b3;text-transform:uppercase}.sb-work__project-details h3{font-size:clamp(25px,3vw,42px);letter-spacing:-.055em;margin:8px 0}.sb-work__project-details p{color:#b3bdb6;font-size:13px;line-height:1.7;max-width:400px}.sb-work__dot{margin:0 6px}.sb-work__project-arrow{font-size:26px}
.sb-work__empty-lead{display:flex;gap:10px;align-items:baseline;max-width:740px;margin-bottom:40px;font-size:15px;color:#b8c8bd;line-height:1.7}.sb-work__live-dot{flex-shrink:0}.sb-work__preview{min-width:0}.sb-work__preview-art{aspect-ratio:1.18;position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.25);border-radius:30px;background:linear-gradient(130deg,rgba(255,255,255,.21),rgba(255,255,255,.06) 47%,rgba(255,255,255,.1));backdrop-filter:blur(28px) saturate(145%);-webkit-backdrop-filter:blur(28px) saturate(145%);box-shadow:0 23px 60px rgba(0,0,0,.21),inset 0 1px rgba(255,255,255,.21);display:grid;place-items:center}.sb-work__preview--sage .sb-work__preview-art{background-color:#263b32}.sb-work__preview--silver .sb-work__preview-art{background-color:#2c3637}.sb-work__preview--olive .sb-work__preview-art{background-color:#353c30}.sb-work__preview--slate .sb-work__preview-art{background-color:#253339}.sb-work__preview:nth-child(4n+2) .sb-work__preview-art,.sb-work__preview:nth-child(4n+3) .sb-work__preview-art{aspect-ratio:1.0}
.sb-work__preview-art:after{content:'';position:absolute;inset:1px;border-radius:29px;pointer-events:none;background:linear-gradient(130deg,rgba(255,255,255,.17),transparent 38%,transparent 60%,rgba(255,255,255,.06))}.sb-work__preview-orbit{width:60%;aspect-ratio:1;border:1px solid rgba(255,255,255,.23);border-radius:50%;position:absolute;transform:rotate(-22deg) scaleX(1.3);box-shadow:0 0 80px 30px rgba(218,245,217,.08),inset 0 0 65px rgba(228,255,232,.06)}.sb-work__preview-symbol{font-size:clamp(95px,17vw,270px);font-weight:700;letter-spacing:-.16em;opacity:.45;filter:drop-shadow(0 20px 45px rgba(0,0,0,.25));transform:translateX(-.08em);transition:transform .6s,opacity .6s}.sb-work__preview:hover .sb-work__preview-symbol{transform:translateX(-.08em) scale(1.06) rotate(-3deg);opacity:.65}
.sb-work__preview-glass{position:absolute;bottom:22px;left:22px;right:22px;display:flex;justify-content:space-between;gap:15px;padding:18px 22px;border:1px solid rgba(255,255,255,.38);border-radius:17px;background:rgba(230,247,239,.13);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);box-shadow:inset 0 1px rgba(255,255,255,.2);font-size:10px;letter-spacing:.16em;color:#f5fbf8}.sb-work__preview-meta{display:flex;justify-content:space-between;gap:15px;margin:21px 4px 0}.sb-work__preview h3{font-size:clamp(26px,3.3vw,46px);font-weight:620;letter-spacing:-.055em;margin:9px 4px}.sb-work__preview h3 span{font-weight:400;font-size:.65em;opacity:.75}.sb-work__note{font-size:11px;line-height:1.7;color:#899b90;max-width:720px;margin-top:32px}
.sb-work__cta{position:relative;isolation:isolate;overflow:hidden;margin-top:clamp(110px,13vw,210px);padding:clamp(32px,6vw,90px);min-height:540px;border:1px solid rgba(255,255,255,.32);border-radius:35px;background:linear-gradient(140deg,rgba(255,255,255,.20),rgba(255,255,255,.07) 55%,rgba(255,255,255,.14));backdrop-filter:blur(30px) saturate(150%);-webkit-backdrop-filter:blur(30px) saturate(150%);box-shadow:inset 0 1px rgba(255,255,255,.23),0 40px 110px rgba(0,0,0,.23)}.sb-work__cta-orb{position:absolute;z-index:-1;width:600px;height:600px;right:-150px;top:-200px;background:radial-gradient(circle,rgba(176,226,180,.25),transparent 65%);filter:blur(30px)}.sb-work__cta h2{font-size:clamp(49px,7vw,110px);line-height:1;letter-spacing:-.08em;margin:20px 0}.sb-work__cta p{font-size:clamp(14px,1.5vw,19px);color:#c7d2cb;max-width:560px;line-height:1.65}.sb-work__cta-button{display:inline-flex;align-items:center;justify-content:space-between;gap:35px;margin-top:27px;background:#eff7ee;color:#112117;border:1px solid white;text-decoration:none;padding:18px 24px;border-radius:15px;font-weight:750;font-size:13px;transition:transform .2s,background .2s}.sb-work__cta-button:hover{background:#d7efc9;transform:translateY(-3px)}.sb-work__cta-label{position:absolute;right:30px;bottom:25px;color:#a0b4a6;letter-spacing:.2em;font-size:9px}
.sb-work__reveal{opacity:0;transform:translateY(28px);transition:opacity .75s ease,transform .75s ease}.sb-work__reveal.is-visible{opacity:1;transform:none}
@media(max-width:850px){.sb-work__grid{grid-template-columns:1fr}.sb-work__topline>span:last-child{display:none}.sb-work__gallery-heading{align-items:start;flex-direction:column}.sb-work__preview-art,.sb-work__preview:nth-child(4n+2) .sb-work__preview-art,.sb-work__preview:nth-child(4n+3) .sb-work__preview-art{aspect-ratio:1.2}}
@media(max-width:550px){.sb-work{padding:62px 0 70px}.sb-work__wrap{width:calc(100% - 32px)}.sb-work__hero{padding:90px 0 85px}.sb-work h1{font-size:clamp(53px,13vw,80px)}.sb-work__hero-bottom{align-items:start;flex-direction:column}.sb-work__scroll{display:none}.sb-work__gallery-heading h2{font-size:42px}.sb-work__preview-glass{left:13px;right:13px;bottom:13px;padding:13px}.sb-work__preview-meta{font-size:9px}.sb-work__cta{border-radius:24px;min-height:480px;padding:28px}.sb-work__cta h2{font-size:clamp(48px,12vw,68px)}}
@media(prefers-reduced-motion:reduce){.sb-work__reveal{opacity:1;transform:none;transition:none}.sb-work__preview-symbol,.sb-work__art img{transition:none}}
</style>