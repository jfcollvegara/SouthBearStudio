---
import Base from '../layouts/Base.astro';
import { catalog } from '../data/catalog.js';

// Portada de las cinco áreas creativas: los paquetes y precios
// se mantienen en las páginas de cada servicio y en catalog.js.
const serviceIntro = {
  'diseno-web': 'Tu negocio merece una experiencia digital a su altura.',
  'branding': 'Una identidad que se reconoce incluso sin decir su nombre.',
  'diseno-grafico': 'Ideas que pasan del concepto a piezas que dejan huella.',
  'soluciones-qr': 'Conecta cada espacio, soporte y experiencia con lo digital.',
  'audiovisual': 'Contamos historias que cobran vida en cada fotograma.'
};
---
<Base
  title="Servicios creativos"
  description="Descubre las cinco áreas creativas de SOUTHBEAR STUDIO: diseño web, identidad visual, diseño gráfico, soluciones QR/NFC y producción audiovisual."
>
  <div class="sb-services-page">
    <header class="sb-services-hero">
      <div class="sb-services-hero__inner">
        <h1>Lo que imaginas,<span>lo hacemos realidad.</span></h1>
        <div class="sb-services-hero__bottom">
          <p>Diseño, tecnología y creatividad bajo una misma mirada. Explora lo que podemos crear para tu marca.</p>
          <a href="#categorias" class="sb-services-hero__explore">
            Explorar servicios <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
      <div class="sb-services-hero__glow" aria-hidden="true"></div>
    </header>

    <section class="sb-services-categories" id="categorias" aria-labelledby="sb-services-category-title">
      <div class="sb-services-categories__inner">
        <div class="sb-services-categories__heading">
          <h2 id="sb-services-category-title">Cinco formas de crear.</h2>
          <p>Una idea, infinitas posibilidades.</p>
        </div>
        <div class="sb-services-grid">
          {catalog.map((service)=>(
            <a
              class:list={['sb-services-card', 'sb-services-card--'+service.slug]}
              href={'/servicios/'+service.slug+'/'}
              aria-label={'Descubrir '+service.title}
            >
              <div class="sb-services-card__content">
                <h3>{service.title}</h3>
                <p>{serviceIntro[service.slug] || service.intro}</p>
              </div>

              <div class:list={['sb-services-card__art','sb-services-card__art--'+service.slug]} aria-hidden="true">
                {service.slug === 'diseno-web' && (
                  <div class="sb-services-website">
                    <div class="sb-services-website__top"><i></i><i></i><i></i><span></span></div>
                    <div class="sb-services-website__body">
                      <div class="sb-services-website__text"><b></b><b></b><b></b><em></em></div>
                      <div class="sb-services-website__photo"><span></span></div>
                    </div>
                    <div class="sb-services-website__bottom"><i></i><i></i><i></i></div>
                  </div>
                )}
                {service.slug === 'branding' && (
                  <div class="sb-services-brandmark">
                    <div class="sb-services-brandmark__orbit sb-services-brandmark__orbit--outer"></div>
                    <div class="sb-services-brandmark__orbit sb-services-brandmark__orbit--inner"></div>
                    <span>B</span>
                  </div>
                )}
                {service.slug === 'diseno-grafico' && (
                  <div class="sb-services-prints">
                    <div class="sb-services-prints__sheet sb-services-prints__sheet--back"></div>
                    <div class="sb-services-prints__sheet sb-services-prints__sheet--middle"></div>
                    <div class="sb-services-prints__sheet sb-services-prints__sheet--front">
                      <span></span><i></i><b></b>
                    </div>
                  </div>
                )}
                {service.slug === 'soluciones-qr' && (
                  <div class="sb-services-digital">
                    <div class="sb-services-digital__code">
                      <span></span><span></span><span></span>
                      <span></span><span></span><span></span>
                      <span></span><span></span><span></span>
                    </div>
                    <div class="sb-services-digital__wave sb-services-digital__wave--first"></div>
                    <div class="sb-services-digital__wave sb-services-digital__wave--second"></div>
                  </div>
                )}
                {service.slug === 'audiovisual' && (
                  <div class="sb-services-cinema">
                    <div class="sb-services-cinema__frame">
                      <div class="sb-services-cinema__play"></div>
                      <div class="sb-services-cinema__shine"></div>
                    </div>
                    <div class="sb-services-cinema__strip"><span></span><span></span><span></span></div>
                  </div>
                )}
              </div>

              <span class="sb-services-card__bottom">
                <span>Descubrir servicio</span>
                <span class="sb-services-card__arrow" aria-hidden="true">↗</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="sb-services-outro" aria-labelledby="sb-services-outro-title">
      <div class="sb-services-outro__inner">
        <div class="sb-services-outro__copy">
          <h2 id="sb-services-outro-title">¿Tienes una idea en mente?</h2>
          <p>No hace falta tenerlo todo definido. Cuéntanos qué necesitas y encontraremos la forma de hacerlo realidad.</p>
        </div>
        <a class="sb-services-outro__button" href="/presupuesto/">
          Hablemos de tu proyecto <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="sb-services-outro__note">Cada proyecto es diferente. Los paquetes, extras, precios con IVA incluido y condiciones están disponibles dentro de cada servicio.</p>
    </section>
  </div>
</Base>

<style>
  .sb-services-page{
    width:100%;
    overflow:hidden;
    background:#fff;
    color:#111511;
  }
  .sb-services-page *{box-sizing:border-box}
  .sb-services-hero{
    position:relative;
    isolation:isolate;
    min-height:clamp(525px,74vh,820px);
    display:flex;
    align-items:center;
    background:#fff;
    overflow:hidden;
  }
  .sb-services-hero__inner{
    position:relative;
    z-index:1;
    width:min(1540px,calc(100% - clamp(36px,8vw,150px)));
    margin:0 auto;
    padding:clamp(85px,9vw,155px) 0 clamp(90px,9vw,150px);
  }
  .sb-services-hero h1{
    max-width:1280px;
    margin:0;
    font-family:var(--font-heading);
    font-size:clamp(3.7rem,8.45vw,9rem);
    line-height:.99;
    letter-spacing:-.09em;
    font-weight:750;
    text-wrap:balance;
    animation:sb-services-rise 1s cubic-bezier(.19,.75,.23,1) both;
  }
  .sb-services-hero h1 span{
    display:block;
    color:#466927;
  }
  .sb-services-hero__bottom{
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap:38px;
    max-width:1150px;
    margin-top:clamp(45px,6vw,94px);
    animation:sb-services-rise 1s cubic-bezier(.19,.75,.23,1) .13s both;
  }
  .sb-services-hero__bottom p{
    max-width:590px;
    margin:0;
    color:#545e53;
    font-size:clamp(1rem,1.4vw,1.29rem);
    line-height:1.65;
    font-weight:450;
  }
  .sb-services-hero__explore{
    flex:none;
    display:inline-flex;
    align-items:center;
    gap:30px;
    padding:12px 0;
    color:#121a10;
    text-decoration:none;
    font-size:.91rem;
    font-weight:750;
    border-bottom:1px solid #101510;
    transition:gap .25s ease,color .25s ease;
  }
  .sb-services-hero__explore span{font-size:1.25rem}
  .sb-services-hero__explore:hover{gap:38px;color:#456f20}
  .sb-services-hero__glow{
    position:absolute;
    z-index:0;
    right:-13vw;
    top:-20%;
    width:min(88vw,1300px);
    aspect-ratio:1;
    pointer-events:none;
    border-radius:50%;
    background:radial-gradient(circle,rgba(221,255,154,.26) 0%,rgba(221,255,154,.09) 34%,transparent 68%);
    filter:blur(42px);
  }
  @keyframes sb-services-rise{
    from{opacity:0;transform:translate3d(0,30px,0)}
    to{opacity:1;transform:translate3d(0,0,0)}
  }
  .sb-services-categories{
    padding:clamp(92px,10vw,155px) clamp(18px,4vw,92px) clamp(95px,11vw,170px);
    background:#0A0A0A;
    color:#fff;
    scroll-margin-top:75px;
  }
  .sb-services-categories__inner{max-width:1510px;margin:0 auto}
  .sb-services-categories__heading{
    display:flex;
    align-items:end;
    justify-content:space-between;
    gap:35px;
    margin-bottom:clamp(36px,5vw,73px);
  }
  .sb-services-categories__heading h2{
    margin:0;
    font-family:var(--font-heading);
    font-size:clamp(2.4rem,5.2vw,5.4rem);
    font-weight:750;
    line-height:1.06;
    letter-spacing:-.077em;
  }
  .sb-services-categories__heading p{
    max-width:240px;
    margin:0 0 8px;
    color:rgba(255,255,255,.6);
    font-size:.98rem;
    line-height:1.5;
    text-align:right;
  }
  .sb-services-grid{
    display:grid;
    grid-template-columns:repeat(12,minmax(0,1fr));
    gap:clamp(15px,1.8vw,29px);
  }
  .sb-services-card{
    position:relative;
    isolation:isolate;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    min-width:0;
    min-height:clamp(390px,34vw,525px);
    padding:clamp(28px,3.2vw,47px);
    overflow:hidden;
    border:1px solid rgba(255,255,255,.21);
    border-radius:clamp(20px,2.4vw,33px);
    color:#fff;
    text-decoration:none;
    background:
      radial-gradient(circle at 85% 70%,rgba(221,255,154,.105),transparent 43%),
      linear-gradient(135deg,rgba(255,255,255,.11),rgba(255,255,255,.045) 60%,rgba(255,255,255,.085));
    -webkit-backdrop-filter:blur(16px) saturate(140%);
    backdrop-filter:blur(16px) saturate(140%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.27),0 18px 48px rgba(0,0,0,.21);
    transition:border-color .3s ease,box-shadow .3s ease,transform .3s ease;
  }
  .sb-services-card::before{
    content:'';
    position:absolute;
    inset:0;
    z-index:0;
    pointer-events:none;
    border-radius:inherit;
    background:
      radial-gradient(ellipse at 0% 0%,rgba(255,255,255,.18),transparent 46%),
      linear-gradient(145deg,rgba(255,255,255,.095),transparent 65%);
  }
  .sb-services-card:hover,.sb-services-card:focus-visible{
    transform:translateY(-4px);
    border-color:rgba(255,255,255,.55);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.48),0 0 26px rgba(255,255,255,.11),0 24px 65px rgba(0,0,0,.28);
  }
  .sb-services-card:focus-visible{outline:3px solid #DDFF9A;outline-offset:5px}
  .sb-services-card--diseno-web{grid-column:span 7}
  .sb-services-card--branding{grid-column:span 5}
  .sb-services-card--diseno-grafico,
  .sb-services-card--soluciones-qr,
  .sb-services-card--audiovisual{grid-column:span 4;min-height:clamp(370px,30vw,450px)}
  .sb-services-card__content,.sb-services-card__bottom{position:relative;z-index:2}
  .sb-services-card__content{max-width:min(78%,530px)}
  .sb-services-card__content h3{
    margin:0;
    max-width:490px;
    font-family:var(--font-heading);
    font-size:clamp(1.75rem,2.9vw,3.35rem);
    line-height:1.07;
    font-weight:740;
    letter-spacing:-.06em;
    text-wrap:balance;
  }
  .sb-services-card__content p{
    max-width:390px;
    margin:clamp(13px,1.9vw,23px) 0 0;
    color:rgba(255,255,255,.68);
    font-size:clamp(.88rem,1.02vw,1.02rem);
    line-height:1.64;
  }
  .sb-services-card__bottom{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:25px;
    width:100%;
    margin-top:90px;
    font-size:.91rem;
    font-weight:700;
    color:rgba(255,255,255,.8);
  }
  .sb-services-card__arrow{
    flex:none;
    display:grid;
    place-items:center;
    width:52px;
    height:52px;
    border:1px solid rgba(255,255,255,.25);
    border-radius:50%;
    background:rgba(255,255,255,.1);
    color:#DDFF9A;
    font-size:1.5rem;
    transition:transform .3s ease,color .3s ease,background .3s ease;
  }
  .sb-services-card:hover .sb-services-card__arrow,
  .sb-services-card:focus-visible .sb-services-card__arrow{
    transform:translate(2px,-2px);
    background:#DDFF9A;
    color:#0A0A0A;
  }
  .sb-services-card__art{
    position:absolute;
    z-index:1;
    top:0;
    right:0;
    bottom:0;
    width:65%;
    pointer-events:none;
    opacity:.95;
    transition:transform .65s cubic-bezier(.18,.77,.2,1);
  }
  .sb-services-card:hover .sb-services-card__art{transform:scale(1.035)}
  .sb-services-card--branding .sb-services-card__art{width:70%}
  .sb-services-card--diseno-grafico .sb-services-card__art,
  .sb-services-card--soluciones-qr .sb-services-card__art,
  .sb-services-card--audiovisual .sb-services-card__art{width:78%}
  .sb-services-card--diseno-grafico .sb-services-card__content,
  .sb-services-card--soluciones-qr .sb-services-card__content,
  .sb-services-card--audiovisual .sb-services-card__content{max-width:87%}

  /* Diseño web: ventana editorial con bloques de contenido. */
  .sb-services-website{
    position:absolute;
    top:38%;
    left:15%;
    width:90%;
    aspect-ratio:1.48;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.4);
    border-radius:15px;
    background:#eaf0de;
    box-shadow:0 22px 55px #0006;
    transform:rotate(-8deg);
  }
  .sb-services-website__top{height:14%;display:flex;align-items:center;gap:5px;padding:0 5%;background:#eef1e8}
  .sb-services-website__top i{width:5px;height:5px;border-radius:50%;background:#9daa90}
  .sb-services-website__top span{margin-left:auto;width:35%;height:5px;border-radius:5px;background:#d1d8c8}
  .sb-services-website__body{height:72%;display:grid;grid-template-columns:1fr 1fr;gap:8%;padding:9% 8%;background:#c9ec8b}
  .sb-services-website__text{display:flex;flex-direction:column;gap:8%}
  .sb-services-website__text b{height:10%;background:#22301f;border-radius:9px}
  .sb-services-website__text b:nth-child(2){width:80%}
  .sb-services-website__text b:nth-child(3){width:64%;background:#5f8759}
  .sb-services-website__text em{width:53%;height:16%;margin-top:7%;border-radius:6px;background:#20271e}
  .sb-services-website__photo{border-radius:6px;background:linear-gradient(140deg,#415c31,#91b776 60%,#33442c);overflow:hidden}
  .sb-services-website__photo span{display:block;width:84%;height:80%;margin:22% 0 0 39%;border-radius:50%;background:#cfe6a1;opacity:.6}
  .sb-services-website__bottom{height:14%;display:flex;gap:6%;padding:4% 8%;background:#eef1e8}
  .sb-services-website__bottom i{height:5px;width:24%;background:#b3c3ab;border-radius:4px}

  /* Identidad visual: marca tipográfica rodeada de órbitas. */
  .sb-services-brandmark{position:absolute;right:-9%;bottom:9%;width:100%;aspect-ratio:1;display:grid;place-items:center}
  .sb-services-brandmark__orbit{position:absolute;border:1px solid rgba(221,255,154,.33);border-radius:50%}
  .sb-services-brandmark__orbit--outer{width:93%;aspect-ratio:1;transform:rotate(16deg) scaleX(.87)}
  .sb-services-brandmark__orbit--inner{width:70%;aspect-ratio:1;border-color:rgba(255,255,255,.3);transform:rotate(-25deg) scaleX(.8)}
  .sb-services-brandmark>span{
    display:block;
    font-family:var(--font-heading);
    font-weight:750;
    font-size:clamp(14rem,28vw,28rem);
    line-height:1;
    letter-spacing:-.1em;
    color:#DDFF9A;
    text-shadow:0 24px 50px rgba(0,0,0,.2);
    transform:rotate(-12deg);
  }

  /* Diseño gráfico: láminas impresas superpuestas. */
  .sb-services-prints{position:absolute;inset:0}
  .sb-services-prints__sheet{position:absolute;width:57%;aspect-ratio:.78;bottom:12%;right:12%;border-radius:6px;border:1px solid rgba(255,255,255,.45);box-shadow:0 20px 42px #0006}
  .sb-services-prints__sheet--back{transform:rotate(-19deg) translate(-15%,5%);background:#f2f3e9}
  .sb-services-prints__sheet--middle{transform:rotate(13deg) translate(13%,-5%);background:#a9da69}
  .sb-services-prints__sheet--front{background:#262f22;transform:rotate(-5deg);overflow:hidden}
  .sb-services-prints__sheet--front span{position:absolute;inset:12% 12% 36%;background:radial-gradient(circle at 33% 41%,#e8f5b7 0%,#a9d77b 33%,#3f7838 73%);border-radius:100% 15% 45% 45%}
  .sb-services-prints__sheet--front i{position:absolute;left:12%;right:12%;bottom:23%;height:7%;background:#f2f6e8;border-radius:2px}
  .sb-services-prints__sheet--front b{position:absolute;left:12%;width:50%;bottom:14%;height:4%;background:#93bd72;border-radius:2px}

  /* QR/NFC: escultura de código modular y ondas de conexión. */
  .sb-services-digital{position:absolute;inset:0}
  .sb-services-digital__code{
    position:absolute;
    right:16%;
    bottom:21%;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:9%;
    width:55%;
    aspect-ratio:1;
    padding:10%;
    border:1px solid rgba(255,255,255,.4);
    border-radius:20px;
    background:linear-gradient(140deg,#dfffab,#b2e47f);
    box-shadow:0 22px 45px #0005;
    transform:rotate(12deg);
  }
  .sb-services-digital__code span{background:#23321b;border-radius:2px}
  .sb-services-digital__code span:nth-child(2),
  .sb-services-digital__code span:nth-child(4),
  .sb-services-digital__code span:nth-child(8){background:transparent;border:5px solid #23321b}
  .sb-services-digital__code span:nth-child(5){background:#688e4d}
  .sb-services-digital__wave{
    position:absolute;
    right:-10%;
    bottom:10%;
    width:68%;
    aspect-ratio:1;
    border:2px solid rgba(221,255,154,.21);
    border-radius:50%;
  }
  .sb-services-digital__wave--second{right:-21%;bottom:-2%;width:92%;opacity:.6}

  /* Producción audiovisual: pantalla panorámica con símbolo de reproducción. */
  .sb-services-cinema{position:absolute;inset:0}
  .sb-services-cinema__frame{
    position:absolute;
    right:-9%;
    bottom:24%;
    width:93%;
    aspect-ratio:2.35/1;
    display:grid;
    place-items:center;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.36);
    border-radius:12px;
    background:radial-gradient(circle at 52% 48%,#4f634b,#1e291f 50%,#0e150f);
    transform:rotate(-10deg);
    box-shadow:0 20px 55px #0008;
  }
  .sb-services-cinema__play{position:relative;width:70px;height:70px;border-radius:50%;border:1px solid rgba(255,255,255,.55);display:grid;place-items:center;background:rgba(255,255,255,.12)}
  .sb-services-cinema__play::after{content:'';display:block;margin-left:5px;border-left:19px solid #DDFF9A;border-top:12px solid transparent;border-bottom:12px solid transparent}
  .sb-services-cinema__shine{position:absolute;width:72%;height:120%;top:-30%;right:-25%;transform:rotate(28deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.06),transparent)}
  .sb-services-cinema__strip{position:absolute;display:flex;gap:9px;right:3%;bottom:14%;transform:rotate(-10deg)}
  .sb-services-cinema__strip span{width:32px;height:11px;border:1px solid rgba(255,255,255,.33);border-radius:2px}

  .sb-services-outro{padding:clamp(95px,11vw,165px) clamp(18px,4vw,92px) 60px;background:#fff;color:#101510}
  .sb-services-outro__inner{max-width:1510px;margin:auto;display:flex;align-items:end;justify-content:space-between;gap:52px}
  .sb-services-outro__copy h2{
    max-width:930px;
    margin:0;
    font-family:var(--font-heading);
    font-size:clamp(2.55rem,5.3vw,5.8rem);
    line-height:1.04;
    font-weight:750;
    letter-spacing:-.078em;
    text-wrap:balance;
  }
  .sb-services-outro__copy p{max-width:620px;margin:26px 0 0;font-size:clamp(1rem,1.25vw,1.18rem);line-height:1.75;color:#576256}
  .sb-services-outro__button{
    display:inline-flex;
    align-items:center;
    justify-content:space-between;
    gap:42px;
    flex:none;
    padding:20px 26px;
    background:#111811;
    border:1px solid #111811;
    border-radius:999px;
    color:#fff;
    text-decoration:none;
    font-weight:750;
    transition:transform .25s ease,color .25s ease,background .25s ease;
  }
  .sb-services-outro__button span{font-size:1.25rem}
  .sb-services-outro__button:hover{transform:translateY(-3px);background:#DDFF9A;color:#111811}
  .sb-services-outro__button:focus-visible,.sb-services-hero__explore:focus-visible{outline:3px solid #4d711e;outline-offset:5px}
  .sb-services-outro__note{
    max-width:1510px;
    margin:clamp(65px,8vw,115px) auto 0;
    padding-top:21px;
    border-top:1px solid #e2e7dd;
    font-size:.82rem;
    line-height:1.65;
    color:#677267;
  }
  @media(max-width:1180px){
    .sb-services-card--diseno-web,.sb-services-card--branding{grid-column:span 6}
    .sb-services-card--diseno-grafico,.sb-services-card--soluciones-qr{grid-column:span 6}
    .sb-services-card--audiovisual{grid-column:span 12}
    .sb-services-card--audiovisual .sb-services-card__art{width:50%}
    .sb-services-card__content{max-width:80%}
  }
  @media(max-width:760px){
    .sb-services-hero{min-height:0}
    .sb-services-hero__inner{width:calc(100% - 36px);padding:90px 0 100px}
    .sb-services-hero h1{font-size:clamp(3.5rem,11vw,5.7rem)}
    .sb-services-hero__bottom{align-items:flex-start;flex-direction:column;gap:20px;margin-top:35px}
