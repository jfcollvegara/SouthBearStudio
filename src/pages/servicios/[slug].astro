---
import Base from '../../layouts/Base.astro';
import {catalog} from '../../data/catalog.js';
export function getStaticPaths(){
  // Diseño web y Producción audiovisual cuentan con rutas propias de diseño.
  // Todos sus paquetes, extras, precios y condiciones permanecen guardados en src/data/catalog.js.
  return catalog.filter(service=>!['diseno-web','audiovisual','branding','diseno-grafico'].includes(service.slug)).map(service=>({params:{slug:service.slug},props:{service}}));
}
const {service}=Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const euros=new Intl.NumberFormat('es-ES',{minimumFractionDigits:0,maximumFractionDigits:2});
const formatPrice=(item)=>{
  if(item.price===null)return item.priceLabel||'Bajo presupuesto';
  return (item.from?'Desde ':'')+euros.format(item.price)+' €'+(item.unit||'');
};
const formattedExtra=(item,section)=>{
  if(service.slug==='branding' && section?.title==='Aplicaciones de identidad visual'){
    return 'Incluido según paquete';
  }
  return formatPrice(item);
};
const quote=(pkg)=>base+'/presupuesto/?servicio='+encodeURIComponent(service.slug)+'&paquete='+encodeURIComponent(pkg.name);
---
<Base title={service.title} description={service.title+' en SOUTHBEAR STUDIO. Paquetes, extras y precios con IVA incluido. '+service.intro}>
  {service.slug==='soluciones-qr' ? (

  <main class="qr-custom">
    <section class="qr-intro">
      <div class="qr-intro__copy">
        <h1>Tu negocio.<br/><span>En un toque.</span></h1>
        <p>Cartas, catálogos y soluciones QR/NFC para conectar tu negocio con tus clientes. Sencillo, directo y pensado para móviles.</p>
        <a href="#qr-productos">Descubre las soluciones <span aria-hidden="true">↘</span></a>
      </div>
      <div class="qr-intro__stage">
        <span class="qr-intro__ring" aria-hidden="true"></span>
        <figure class="qr-media qr-media--hero">
          <img src="/hero-movil.png" alt="Vista de carta digital en un smartphone" onerror="this.hidden=true"/>
          
        </figure>
        <span class="qr-intro__chip" aria-hidden="true">QR + NFC</span>
      </div>
    </section>
    <section class="qr-experience">
      <div class="qr-experience__text"><h2>Escanea.<br/>Descubre.<br/><span>Conecta.</span></h2><p>Sin instalar aplicaciones. Solo un código QR o un toque NFC para acceder a la información.</p></div>
      <figure class="qr-media qr-media--wide"><img src="/escaneo-qr.jpg" alt="Ejemplo del uso de un código QR" loading="lazy" onerror="this.hidden=true"/><div class="qr-media__placeholder"><span aria-hidden="true">⌗</span></div></figure>
    </section>
    <section class="qr-products" id="qr-productos">
      <div class="qr-heading"><h2>Soluciones<br/>a tu medida<span>.</span></h2><p>Selecciona una opción para conocer sus características y condiciones.</p></div>
      <div class="qr-products__grid">
        {service.packages.map((pkg,i)=><details class:list={['qr-product',i===2?'qr-product--wide':'']}>
          <summary><span class="qr-product__top">{i===0?'Contacto':i===4?'Reseñas':'Catálogos digitales'} <b aria-hidden="true">+</b></span><strong>{pkg.name}</strong><span class="qr-product__bottom">{formatPrice(pkg)} <span>Ver qué incluye</span></span></summary>
          <div class="qr-product__body"><ul>{pkg.features.map(item=><li>{item}</li>)}</ul><a href={quote(pkg)}>Ponte en contacto ↗</a></div>
        </details>)}
      </div>
    </section>
    <section class="qr-showcase">
      <div class="qr-showcase__row"><div><h2>Todo tu catálogo.<br/>Siempre a mano.</h2><p>La información organizada y preparada para consultar desde cualquier móvil.</p></div><figure class="qr-media qr-media--showcase"><img src="/catalogo-movil.png" alt="Ejemplo de catálogo digital" loading="lazy" onerror="this.hidden=true"/><div class="qr-media__placeholder"><span aria-hidden="true">▤</span></div></figure></div>
      <div class="qr-showcase__row qr-showcase__row--reverse"><div><h2>Del soporte físico<br/>al mundo digital.</h2><p>Metacrilato, madera y NFC como punto de encuentro con tu contenido.</p></div><figure class="qr-media qr-media--showcase"><img src="/soportes-nfc.png" alt="Ejemplo de soportes QR y NFC" loading="lazy" onerror="this.hidden=true"/><div class="qr-media__placeholder"><span aria-hidden="true">◇</span></div></figure></div>
    </section>
    <section class="qr-extras"><div class="qr-heading"><h2>Un poco más<span>.</span></h2><p>Extras, soportes y complementos para adaptar cada solución a tu negocio.</p></div>
      {service.extraSections?.map(group=><details class="qr-extras__group"><summary>{group.title}<span aria-hidden="true">+</span></summary><div class="qr-extras__content"><p>{group.intro}</p><div class="qr-extras__grid">{group.items.map(item=><div class="qr-extras__item"><div><strong>{item.name}</strong><b>{formatPrice(item)}</b></div><p>{item.detail}</p></div>)}</div></div></details>)}
    </section>
    <section class="qr-conditions"><div><h2>Todo claro.</h2><p>Sin sorpresas.</p></div><div><ul>{service.common.map(item=><li>{item}</li>)}</ul><p><strong>No incluido:</strong> {service.notIncluded}</p><p>Precios con IVA incluido.</p></div></section>
    <section class="qr-outro"><span aria-hidden="true" class="qr-outro__ring"></span><h2>Una idea.<br/><span>Mil conexiones.</span></h2><a href="/contacto/">Hablemos de tu proyecto ↗</a></section>
  </main>
  ) : (<>
  <section class="container page-head service-head">
    <a class="back-link" href={base+'/#servicios'}>← Todos los servicios</a>
    <div class="eyebrow">SOUTHBEAR STUDIO / SERVICIOS</div>
    <h1>{service.title}</h1>
    <p class="lead">{service.intro}</p>
    <p class="tax-disclaimer">Todos los precios mostrados incluyen IVA.</p>
  </section>
  <section class="container service-section">
    <div class="section-heading-new"><div><span class="eyebrow">01 / PAQUETES Y PRODUCTOS</span><h2>Elige tu punto de partida.</h2></div><p>Consulta qué incluye cada modalidad y solicita un presupuesto con el alcance que necesitas.</p></div>
    <div class="package-grid">
      {service.packages.map((pkg,index)=>
        <article class="package-card">
          <div class="package-index">0{index+1} / {service.packages.length<10?'0':''}{service.packages.length}</div>
          <h3>{pkg.name}</h3>
          <p class="package-price">{formatPrice(pkg)}</p>
          <ul class="package-features">{pkg.features.map(feature=><li>{feature}</li>)}</ul>
          <a class="button package-button" href={quote(pkg)}>Solicitar presupuesto ↗</a>
        </article>
      )}
    </div>
  </section>
  {(service.extras?.length>0 || service.extraSections?.length>0)&&
    <section class="container service-section extras-section">
      <div class="section-heading-new"><div><span class="eyebrow">02 / EXTRAS Y COMPLEMENTOS</span><h2>Personaliza el servicio.</h2></div><p>Podrás añadirlos a tu presupuesto según las necesidades del proyecto. Los complementos no incluidos se contratan por separado.</p></div>
      {service.extras?.length>0&&
        <div class="extra-grid">
          {service.extras.map(item=>
            <article class="extra-item">
              <div class="extra-title-row"><h3>{item.name}</h3><strong>{formatPrice(item)}</strong></div>
              <p>{item.detail}</p>
            </article>
          )}
        </div>
      }
      {service.extraSections?.map((section)=>
        <div class="extra-section-block">
          <h3>{section.title}</h3>
          {section.intro&&<p class="extra-section-intro">{section.intro}</p>}
          <div class="extra-grid">
            {section.items.map(item=>
              <article class="extra-item">
                <div class="extra-title-row"><h4>{item.name}</h4><strong>{formattedExtra(item,section)}</strong></div>
                <p>{item.detail}</p>
              </article>
            )}
          </div>
        </div>
      )}
    </section>
  }
  <section class="container service-section service-conditions">
    <div class="conditions-panel">
      <div><span class="eyebrow">03 / INFORMACIÓN ÚTIL</span><h2>Qué debes saber.</h2></div>
      <div>
        <ul class="conditions-list">{service.common.map(note=><li>{note}</li>)}</ul>
        <p class="conditions-exclusions"><strong>Otros servicios y exclusiones:</strong> {service.notIncluded}</p>
        <p class="conditions-exclusions">Los cambios adicionales requieren presupuesto previo. Las revisiones no incluyen nuevos diseños completos ni trabajos fuera del alcance contratado. Se respetan siempre los derechos legales del cliente.</p>
        <a class="button" href={base+'/presupuesto/?servicio='+encodeURIComponent(service.slug)}>Cuéntanos tu proyecto ↗</a>
      </div>
    </div>
  </section>
  </>)}
</Base>
<style>
  .service-head{padding-bottom:40px}
  .service-head h1{max-width:1000px}
  .tax-disclaimer{color:#567837;font-weight:800;font-size:.89rem}
  .service-section{padding-top:36px;padding-bottom:70px}
  .section-heading-new{display:flex;align-items:flex-end;justify-content:space-between;gap:25px;margin-bottom:32px}
  .section-heading-new h2,.conditions-panel h2{font-size:clamp(2rem,4vw,3.7rem);line-height:1.13;letter-spacing:-.06em;margin:14px 0 0}
  .section-heading-new>p{max-width:370px;color:#656c63;line-height:1.75;margin:0}
  .package-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
  .package-card{background:#fffcf5;border:1px solid #dcd8cd;border-radius:13px;padding:clamp(24px,3vw,38px);display:flex;flex-direction:column;gap:12px}
  .package-index{font-size:.74rem;letter-spacing:.13em;color:#7c9e4c;font-weight:800}
  .package-card h3{font-size:clamp(1.5rem,2.5vw,2.1rem);line-height:1.16;letter-spacing:-.055em;margin:8px 0 0}
  .package-price{font-size:clamp(1.7rem,3vw,2.5rem);font-weight:800;color:#50762e;letter-spacing:-.055em;margin:2px 0 8px}
  .package-features{list-style:none;margin:0 0 22px;padding:0;display:grid;gap:12px;flex:1}
  .package-features li{line-height:1.6;padding:0 0 0 24px;position:relative;color:#495347}
  .package-features li:before{content:'✓';position:absolute;left:0;top:0;color:#618e2e;font-weight:800}
  .package-button{align-self:stretch}
  .extras-section{padding-top:75px;border-top:1px solid #d6d2c4}
  .extra-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .extra-item{border:1px solid #d9d4c5;padding:20px 22px;border-radius:11px;background:#fffdf7}
  .extra-title-row{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}
  .extra-title-row h3,.extra-title-row h4{font-size:1.03rem;font-weight:800;line-height:1.4;letter-spacing:-.02em;margin:0}
  .extra-title-row strong{white-space:nowrap;color:#50762e;font-size:.94rem;text-align:right}
  .extra-item p{font-size:.87rem;color:#626c60;line-height:1.65;margin:12px 0 0}
  .extra-section-block{margin-top:38px}
  .extra-section-block>h3{font-size:1.6rem;letter-spacing:-.04em;margin:0 0 8px}
  .extra-section-intro{max-width:850px;color:#626c60;line-height:1.65;margin:0 0 18px}
  .service-conditions{padding-bottom:100px}
  .conditions-panel{display:grid;grid-template-columns:1fr 1.4fr;gap:55px;background:#19211b;border-radius:15px;color:#f5f7ed;padding:clamp(28px,5vw,62px)}
  .conditions-panel .eyebrow{color:#ddff9a}
  .conditions-list{list-style:none;padding:0;margin:0 0 26px;display:grid;gap:16px}
  .conditions-list li{color:#d1d9cf;line-height:1.65;padding-left:18px;position:relative}
  .conditions-list li:before{content:'•';color:#ddff9a;position:absolute;left:0}
  .conditions-exclusions{color:#bbc7ba;line-height:1.7;font-size:.91rem}
  .conditions-exclusions strong{color:#f7f7f0}
  .conditions-panel .button{background:var(--brand-gradient);color:#101411;border-color:#ddff9a;margin-top:20px}
  @media(max-width:800px){.section-heading-new{display:block}.section-heading-new>p{max-width:600px;margin-top:18px}.conditions-panel{grid-template-columns:1fr;gap:28px}}
  @media(max-width:650px){.package-grid,.extra-grid{grid-template-columns:1fr}.service-section{padding-top:25px;padding-bottom:55px}.extras-section{padding-top:55px}.extra-title-row{gap:14px}}

  .qr-custom{--qr-green:#DDFF9A;--qr-ink:#151b13;background:#fff;color:var(--qr-ink);overflow:hidden}
  .qr-custom h1,.qr-custom h2,.qr-product strong{font-family:'Space Grotesk Variable',Arial,sans-serif;letter-spacing:-.075em}
  .qr-intro{display:grid;grid-template-columns:1.07fr .93fr;align-items:center;gap:35px;min-height:92svh;padding:90px clamp(22px,6vw,105px)}
  .qr-intro__copy{position:relative;z-index:2}
  .qr-intro h1{font-size:clamp(62px,7.6vw,122px);line-height:.94;margin:0 0 36px}
  .qr-intro h1 span{color:#647955}
  .qr-intro__copy p{font-size:clamp(16px,1.4vw,20px);max-width:480px;line-height:1.65;color:#5b6855;margin:0 0 40px}
  .qr-intro__copy a,.qr-outro a{display:inline-flex;gap:28px;border-bottom:1px solid currentColor;padding-bottom:12px;font-weight:650}
  .qr-intro__stage{position:relative;min-height:560px;display:grid;place-items:center;isolation:isolate}
  .qr-intro__ring{position:absolute;z-index:3;pointer-events:none;width:min(40vw,560px);aspect-ratio:1;border:40px solid transparent;border-bottom-color:var(--qr-green);border-left-color:var(--qr-green);border-right-color:var(--qr-green);border-radius:50%;transform:translateY(48px);filter:drop-shadow(0 24px 40px #354c2819)}
  .qr-intro__ring::before{content:'';position:absolute;inset:-40px;border:40px solid var(--qr-green);border-radius:50%;clip-path:inset(0 0 54% 0);z-index:-1;opacity:.85}
  .qr-intro__chip{position:absolute;z-index:4;right:0;bottom:12%;padding:14px 24px;background:#ffffffa3;border:1px solid #fff;backdrop-filter:blur(18px);box-shadow:0 14px 50px #14240a1c;font-size:13px;font-weight:800;letter-spacing:.12em}
  .qr-media{position:relative;overflow:visible;margin:0;background:transparent;border:0;box-shadow:none;backdrop-filter:none;-webkit-backdrop-filter:none;border-radius:0;display:grid;place-items:center;isolation:isolate}
  .qr-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;z-index:2}
  .qr-media__placeholder{display:flex;flex-direction:column;gap:19px;align-items:center;justify-content:center;height:100%;width:100%;font-size:90px;color:#82977a}
  .qr-media__placeholder small{font-size:12px;letter-spacing:.06em;font-weight:700;color:#71806c}
  .qr-media--hero{width:min(47vw,690px);height:680px;transform:translateY(-55px);animation:none;z-index:2;isolation:auto}
  .qr-phone{width:66%;height:78%;border:9px solid #202820;border-radius:35px;background:#fff;box-shadow:10px 16px 35px #172d1522;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:35px}
  .qr-phone i{width:35%;height:8px;background:#202820;border-radius:15px;align-self:center;margin-top:-60px}
  .qr-phone b{font-size:22px;line-height:1.2;text-align:center;color:#7b9172}
  .qr-experience{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:55px;padding:120px clamp(22px,6vw,105px);background:#f7f9f5}
  .qr-experience h2,.qr-heading h2,.qr-outro h2{font-size:clamp(48px,7vw,105px);line-height:.98;margin:0;letter-spacing:-.085em}
  .qr-experience h2 span,.qr-heading h2 span{color:#88aa6f}
  .qr-experience p,.qr-heading p,.qr-showcase p{line-height:1.75;color:#606c5b;font-size:16px;max-width:390px}
  .qr-media--wide{aspect-ratio:1.14}
  .qr-products,.qr-extras{padding:110px clamp(22px,6vw,105px)}
  .qr-heading{display:flex;align-items:end;justify-content:space-between;gap:32px;margin-bottom:55px}
  .qr-products__grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:17px}
  .qr-product{grid-column:span 3;border:1px solid #ffffffeb;background:linear-gradient(145deg,#ffffffc9,#f0f8eb82);box-shadow:inset 1px 1px 0 #fff,0 10px 35px #23351a12,0 0 0 1px #cad7c552;backdrop-filter:blur(22px);border-radius:0}
  .qr-product--wide{grid-column:span 4}
  .qr-product summary{list-style:none;min-height:235px;display:flex;flex-direction:column;justify-content:space-between;padding:30px;cursor:pointer}
  .qr-product summary::-webkit-details-marker,.qr-extras__group summary::-webkit-details-marker{display:none}
  .qr-product__top{display:flex;justify-content:space-between;font-size:12px;color:#6c7768}
  .qr-product__top b{color:#181e16;font-size:24px;font-weight:300}
  .qr-product[open] .qr-product__top b{transform:rotate(45deg)}
  .qr-product strong{font-size:clamp(25px,3vw,42px);line-height:1.1}
  .qr-product__bottom{display:flex;justify-content:space-between;align-items:center;gap:12px;font-weight:650}
  .qr-product__bottom span{font-size:12px;color:#798575;font-weight:400}
  .qr-product__body{padding:0 30px 30px}
  .qr-product__body ul{border-top:1px solid #d4decf;padding:20px 0 0;margin:0 0 25px;list-style:none;display:grid;gap:13px}
  .qr-product__body li{font-size:13px;line-height:1.5}
  .qr-product__body li:before{content:'— ';color:#7f9972}
  .qr-product__body a{font-size:14px;font-weight:700;border-bottom:1px solid #151b13;padding-bottom:6px}
  .qr-showcase{padding:20px clamp(22px,6vw,105px) 100px;background:#f7f9f5}
  .qr-showcase__row{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:55px;padding:65px 0}
  .qr-showcase__row--reverse>div:first-child{order:2}
  .qr-showcase h2{font-size:clamp(35px,5vw,70px);line-height:1.05;margin:0}
  .qr-media--showcase{height:440px}
  .qr-extras__group{border-top:1px solid #d9e0d4}
  .qr-extras__group:last-child{border-bottom:1px solid #d9e0d4}
  .qr-extras__group summary{cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:29px 0;list-style:none;font:650 clamp(20px,2.8vw,35px)/1.2 'Space Grotesk Variable',Arial,sans-serif;letter-spacing:-.05em}
  .qr-extras__group summary span{font-size:30px;font-weight:300}
  .qr-extras__group[open] summary span{transform:rotate(45deg)}
  .qr-extras__content{padding:0 0 30px}
  .qr-extras__content>p{color:#657362;line-height:1.6}
  .qr-extras__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  .qr-extras__item{background:#f7f9f5;padding:19px;border:1px solid #e5eadf}
  .qr-extras__item>div{display:flex;justify-content:space-between;align-items:start;gap:15px}
  .qr-extras__item strong{font-size:14px}
  .qr-extras__item b{font-size:13px;white-space:nowrap}
  .qr-extras__item p{font-size:12px;line-height:1.6;color:#636e60}
  .qr-conditions{background:#19211b;color:#fff;padding:100px clamp(22px,6vw,105px);display:grid;grid-template-columns:1fr 1.2fr;gap:65px}
  .qr-conditions h2{font-size:clamp(45px,5vw,80px);margin:0}
  .qr-conditions p,.qr-conditions li{font-size:14px;color:#cbd7c8;line-height:1.7}
  .qr-conditions ul{padding-left:20px;display:grid;gap:13px}
  .qr-conditions strong{color:#fff}
  .qr-outro{position:relative;isolation:isolate;overflow:hidden;padding:135px clamp(22px,6vw,105px)}
  .qr-outro h2{position:relative;z-index:1;margin:0 0 50px}
  .qr-outro h2 span{color:#668158}
  .qr-outro a{position:relative;z-index:1}
  .qr-outro__ring{position:absolute;z-index:0;right:-120px;top:0;width:450px;aspect-ratio:1;border:50px solid var(--qr-green);border-radius:50%;opacity:.75}
  @keyframes qr-hover{50%{transform:rotate(4deg) translateY(-17px)}}
  @media(max-width:800px){.qr-intro,.qr-experience,.qr-showcase__row,.qr-conditions{grid-template-columns:1fr}.qr-intro{padding:80px 22px 65px;gap:50px}.qr-intro h1{font-size:clamp(55px,10vw,90px)}.qr-intro__stage{min-height:480px}.qr-intro__ring{width:330px;border-width:26px}.qr-intro__ring::before{inset:-26px;border-width:26px}.qr-media--hero{width:min(86vw,510px);height:520px;transform:translateY(-35px)}.qr-experience,.qr-products,.qr-extras{padding:75px 22px}.qr-heading{display:block}.qr-heading p{margin-top:25px}.qr-products__grid{grid-template-columns:1fr 1fr}.qr-product,.qr-product--wide{grid-column:span 1}.qr-showcase{padding:30px 22px}.qr-showcase__row--reverse>div:first-child{order:initial}.qr-conditions{padding:75px 22px;gap:15px}.qr-outro{padding:100px 22px}.qr-outro__ring{right:-270px}}
  @media(max-width:550px){.qr-products__grid,.qr-extras__grid{grid-template-columns:1fr}.qr-product summary{min-height:220px}.qr-media--showcase{height:325px}.qr-showcase__row{gap:28px}.qr-intro__stage{min-height:450px}.qr-intro h1{font-size:clamp(50px,11vw,70px)}}
  @media(prefers-reduced-motion:reduce){.qr-media--hero{animation:none}}
</style>
